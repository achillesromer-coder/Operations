<style>
:root{
  --w6-bg:#0a0e1a;
  --w6-panel:#11182a;
  --w6-line:#1f2940;
  --w6-pink:#ff6b9d;
  --w6-cyan:#00d4ff;
  --w6-blue:#00aaff;
  --w6-green:#00ff88;
  --w6-amber:#ffaa00;
  --w6-text:#d8deea;
  --w6-muted:#6f7890;
  --w6-dim:#414a63;
}
*{box-sizing:border-box}
#w6wrap{font-family:Inter,system-ui,Segoe UI,Arial,sans-serif;background:var(--w6-bg);color:var(--w6-text);border:1px solid color-mix(in srgb,var(--w6-pink) 55%, black);border-radius:12px;overflow:hidden;display:flex;flex-direction:column;height:100vh;min-height:760px;position:relative}
#w6hdr{background:linear-gradient(180deg,#0d1220 0%, #0b1020 100%);border-bottom:1px solid var(--w6-line);padding:10px 14px;display:flex;align-items:center;justify-content:space-between;gap:10px;flex-shrink:0}
.w6brand{display:flex;flex-direction:column;gap:2px}.w6logo{color:var(--w6-pink);font-size:15px;font-weight:800;letter-spacing:1.5px;text-transform:uppercase}.w6sub{color:var(--w6-muted);font-size:11px}.w6hdr-right{display:flex;align-items:center;gap:8px;flex-wrap:wrap;justify-content:flex-end}
.w6badge,.w6pill{background:#131a2a;border:1px solid var(--w6-line);color:var(--w6-text);padding:4px 9px;font-size:11px;border-radius:999px}
.w6pill.pink{border-color:color-mix(in srgb,var(--w6-pink) 55%, var(--w6-line));color:var(--w6-pink)}.w6pill.green{border-color:color-mix(in srgb,var(--w6-green) 55%, var(--w6-line));color:var(--w6-green)}.w6pill.blue{border-color:color-mix(in srgb,var(--w6-blue) 55%, var(--w6-line));color:var(--w6-blue)}
.w6btn,.w6linkbtn{background:#12192a;border:1px solid var(--w6-line);color:var(--w6-text);padding:7px 10px;font-size:11px;cursor:pointer;border-radius:8px;transition:.18s ease;text-decoration:none;display:inline-flex;align-items:center;gap:6px}.w6btn:hover,.w6linkbtn:hover{border-color:var(--w6-pink);color:var(--w6-pink);transform:translateY(-1px)}.w6btn.live.active{border-color:var(--w6-green);color:var(--w6-green);box-shadow:0 0 0 1px #003c22 inset}
#w6topbar{background:#0a0f1b;border-bottom:1px solid var(--w6-line);padding:8px 12px;display:flex;align-items:center;gap:8px;flex-wrap:wrap;flex-shrink:0}.w6group{display:flex;align-items:center;gap:6px;flex-wrap:wrap}.w6lbl{font-size:11px;color:var(--w6-muted);text-transform:uppercase;letter-spacing:1px}
.w6mbtn{background:#11182a;border:1px solid var(--w6-line);color:var(--w6-muted);padding:6px 12px;font-size:11px;cursor:pointer;border-radius:8px;text-transform:uppercase;letter-spacing:.8px;transition:.18s ease}.w6mbtn:hover{border-color:var(--w6-pink);color:var(--w6-pink)}.w6mbtn.active{background:var(--w6-pink);border-color:var(--w6-pink);color:#081019;font-weight:700}.w6mbtn.active-blue{background:var(--w6-blue);border-color:var(--w6-blue);color:#081019;font-weight:700}
.w6search,.w6sel{background:#101725;border:1px solid var(--w6-line);color:var(--w6-text);padding:7px 10px;font-size:12px;border-radius:8px}.w6search{min-width:180px}.w6search:focus,.w6sel:focus{outline:none;border-color:var(--w6-cyan);box-shadow:0 0 0 1px #00354a inset}.w6spacer{flex:1}
#w6body{display:flex;flex:1;overflow:hidden;min-height:0}
#w6sidebar{width:240px;min-width:220px;background:linear-gradient(180deg,#0b111d 0%, #0a0f1a 100%);border-right:1px solid var(--w6-line);display:flex;flex-direction:column;overflow-y:auto;flex-shrink:0;padding:12px 10px;gap:10px}
.w6panel{background:#0f1524;border:1px solid var(--w6-line);border-radius:12px;padding:10px}.w6sec-hdr{color:var(--w6-pink);font-size:11px;font-weight:700;letter-spacing:1.1px;text-transform:uppercase;margin-bottom:8px}.w6chk-row{display:flex;align-items:center;gap:8px;padding:4px 0;cursor:pointer}.w6chk-row input{accent-color:var(--w6-pink);cursor:pointer}.w6chk-row span{font-size:12px;color:var(--w6-text)}
.w6stat-row{display:flex;justify-content:space-between;align-items:center;padding:5px 0;border-bottom:1px solid #161f33}.w6stat-row:last-child{border-bottom:none}.w6stat-lbl{color:var(--w6-muted);font-size:11px}.w6stat-val{color:var(--w6-green);font-size:11px;font-weight:700}.w6stat-val.amber{color:var(--w6-amber)}.w6stat-val.blue{color:var(--w6-blue)}.w6stat-val.pink{color:var(--w6-pink)}
.w6small{font-size:11px;color:var(--w6-muted);line-height:1.4}.w6hint{font-size:11px;color:var(--w6-dim);line-height:1.45}.w6stack{display:flex;flex-direction:column;gap:8px}.w6mini-btn{width:100%;background:#12192a;border:1px solid var(--w6-line);color:var(--w6-text);padding:8px 10px;font-size:11px;border-radius:8px;cursor:pointer;text-align:left;transition:.18s ease}.w6mini-btn:hover{border-color:var(--w6-amber);color:var(--w6-amber)}.w6mini-btn.active{background:var(--w6-amber);border-color:var(--w6-amber);color:#081019;font-weight:700}
#w6main{flex:1;position:relative;overflow:hidden;min-width:0;background:radial-gradient(circle at 50% 45%, #111a2c 0%, #0a0e1a 48%, #070b14 100%)}#w6canvas{width:100%;height:100%;display:block;cursor:crosshair}
#w6overlayTop{position:absolute;top:12px;left:12px;display:flex;gap:8px;flex-wrap:wrap;z-index:10;pointer-events:none}.w6overlay-card{pointer-events:auto;background:rgba(10,14,26,.82);border:1px solid var(--w6-line);color:var(--w6-text);border-radius:12px;padding:9px 10px;backdrop-filter:blur(8px);min-width:140px}.w6overlay-title{font-size:10px;color:var(--w6-muted);text-transform:uppercase;letter-spacing:1px;margin-bottom:4px}.w6overlay-value{font-size:16px;font-weight:800;color:var(--w6-green)}.w6overlay-sub{font-size:11px;color:var(--w6-muted)}
#w6inspector{width:300px;min-width:280px;background:linear-gradient(180deg,#0b111d 0%, #0a0f1a 100%);border-left:1px solid var(--w6-line);display:flex;flex-direction:column;overflow-y:auto;flex-shrink:0;padding:12px 10px}.w6ins-card{background:#0f1524;border:1px solid var(--w6-line);border-radius:12px;padding:12px}.w6ins-hdr{display:flex;justify-content:space-between;align-items:flex-start;gap:8px;margin-bottom:10px}.w6ins-title{color:var(--w6-pink);font-size:12px;font-weight:800;letter-spacing:1px;text-transform:uppercase}.w6ins-sub{color:var(--w6-muted);font-size:11px}.w6ins-row{display:flex;justify-content:space-between;gap:10px;padding:6px 0;border-bottom:1px solid #161f33}.w6ins-row:last-child{border-bottom:none}.w6ins-k{color:var(--w6-muted);font-size:11px}.w6ins-v{color:var(--w6-text);font-size:11px;font-weight:700;text-align:right}.w6ins-v.green{color:var(--w6-green)}.w6ins-v.amber{color:var(--w6-amber)}.w6ins-v.blue{color:var(--w6-blue)}.w6ins-v.pink{color:var(--w6-pink)}.w6rbar-wrap{margin:10px 0}.w6rbar-lbl{font-size:11px;color:var(--w6-muted);margin-bottom:5px}.w6rbar-bg{background:#090d15;height:8px;border-radius:999px;overflow:hidden;border:1px solid #1a2133}.w6rbar-fg{height:100%;background:linear-gradient(90deg,var(--w6-pink),var(--w6-green));border-radius:999px;transition:width .35s}.w6actions{display:grid;grid-template-columns:repeat(2,1fr);gap:8px;margin-top:10px}
#w6bottombar{background:#0a0f1b;border-top:1px solid var(--w6-line);padding:8px 12px;display:flex;align-items:center;gap:8px;flex-wrap:wrap;flex-shrink:0}.w6range{accent-color:var(--w6-pink);width:180px}.w6kbd{background:#11182a;border:1px solid var(--w6-line);padding:3px 6px;border-radius:6px;font-size:10px;color:var(--w6-text)}
#w6toast{position:absolute;bottom:62px;left:50%;transform:translateX(-50%);background:rgba(17,24,42,.94);border:1px solid var(--w6-pink);color:var(--w6-pink);padding:8px 14px;font-size:12px;border-radius:10px;display:none;z-index:999;pointer-events:none}
@media (max-width:1200px){#w6sidebar{width:220px;min-width:200px}#w6inspector{width:260px;min-width:240px}}
@media (max-width:980px){#w6body{flex-direction:column}#w6sidebar,#w6inspector{width:auto;min-width:0;border-right:none;border-left:none}#w6sidebar{border-bottom:1px solid var(--w6-line)}#w6inspector{border-top:1px solid var(--w6-line)}}
</style>

<div id="w6wrap" data-workspace-route="/operations/w6" data-data-route="/w6/data" data-delivery="static_readonly">
  <div id="w6hdr">
    <div class="w6brand">
      <div class="w6logo">W6 — Asset Library Final</div>
      <div class="w6sub">Potential in-situ assets · front-facing orbital map · zone → cluster → target</div>
    </div>
    <div class="w6hdr-right">
      <span class="w6pill pink" id="w6ver">v2.0.2</span>
      <span class="w6pill blue">Google Drive source</span>
      <span class="w6badge" id="w6clock">--:-- UTC</span>
      <a class="w6linkbtn" href="https://drive.google.com/drive/folders/1ir0GqOYTDkpqLRLA23q0nNjl_Hh_YDlT?usp=drive_link" target="_blank">Open Drive</a>
      <button class="w6btn" onclick="w6ResetView()">Reset View</button>
      <button class="w6btn" onclick="w6Refresh()">Refresh</button>
      <button class="w6btn live active" id="w6livebtn" onclick="w6ToggleLive()">Live</button>
    </div>
  </div>

  <div id="w6topbar">
    <div class="w6group">
      <span class="w6lbl">Mode</span>
      <button class="w6mbtn active" id="mb-zones" onclick="w6SetMode('zones')">Zones</button>
      <button class="w6mbtn" id="mb-clusters" onclick="w6SetMode('clusters')">Clusters</button>
      <button class="w6mbtn" id="mb-targets" onclick="w6SetMode('targets')">Targets</button>
    </div>
    <div class="w6group">
      <span class="w6lbl">View</span>
      <button class="w6mbtn active-blue" id="mb-2d" onclick="w6SetView('2d')">2D</button>
      <button class="w6mbtn" id="mb-3d" onclick="w6SetView('3d')">3D</button>
      <button class="w6mbtn" id="mb-map" onclick="w6SetView('map')">Map</button>
    </div>
    <div class="w6group">
      <input class="w6search" id="flt-search" placeholder="Search target, designation, taxonomy" oninput="w6ApplyFilters()" />
      <select class="w6sel" id="flt-zone" onchange="w6ApplyFilters()"></select>
      <select class="w6sel" id="flt-cluster" onchange="w6ApplyFilters()"></select>
      <select class="w6sel" id="flt-tax" onchange="w6ApplyFilters()">
        <option value="">All taxonomy</option>
        <option value="M">M-type</option>
        <option value="S">S-type</option>
        <option value="C">C-type</option>
        <option value="X">X-type</option>
        <option value="B">B-type</option>
        <option value="D">D-type</option>
        <option value="V">V-type</option>
      </select>
      <select class="w6sel" id="flt-status" onchange="w6ApplyFilters()">
        <option value="">All status</option>
        <option value="PRIORITY">Priority</option>
        <option value="ACTIVE">Active</option>
        <option value="MAPPED">Mapped</option>
        <option value="CANDIDATE">Candidate</option>
      </select>
    </div>
    <div class="w6spacer"></div>
    <div class="w6group">
      <span class="w6pill green" id="w6epoch">Epoch T+000</span>
      <span class="w6pill" id="w6selectionPill">No selection</span>
    </div>
  </div>

  <div id="w6body">
    <aside id="w6sidebar">
      <div class="w6panel">
        <div class="w6sec-hdr">View Controls</div>
        <label class="w6chk-row"><input type="checkbox" id="chk-orbits" checked onchange="w6Draw()"><span>Orbit paths</span></label>
        <label class="w6chk-row"><input type="checkbox" id="chk-heat" checked onchange="w6Draw()"><span>Zone heat overlay</span></label>
        <label class="w6chk-row"><input type="checkbox" id="chk-labels" onchange="w6Draw()"><span>Labels</span></label>
        <label class="w6chk-row"><input type="checkbox" id="chk-earth" checked onchange="w6Draw()"><span>Earth marker</span></label>
        <label class="w6chk-row"><input type="checkbox" id="chk-planets" onchange="w6Draw()"><span>Planet references</span></label>
        <label class="w6chk-row"><input type="checkbox" id="chk-track" checked onchange="w6Draw()"><span>Future track</span></label>
      </div>
      <div class="w6panel">
        <div class="w6sec-hdr">Selection Summary</div>
        <div class="w6stat-row"><span class="w6stat-lbl">Visible objects</span><span class="w6stat-val" id="st-vis">0</span></div>
        <div class="w6stat-row"><span class="w6stat-lbl">Priority</span><span class="w6stat-val pink" id="st-pri">0</span></div>
        <div class="w6stat-row"><span class="w6stat-lbl">Clusters visible</span><span class="w6stat-val blue" id="st-clusters">0</span></div>
        <div class="w6stat-row"><span class="w6stat-lbl">Mean Δv</span><span class="w6stat-val amber" id="st-dv">0.0</span></div>
      </div>
      <div class="w6panel">
        <div class="w6sec-hdr">Quick Analysis</div>
        <div class="w6stack">
          <button class="w6mini-btn" id="sw-metal" onclick="w6Sweep('metal')">Metal sweep</button>
          <button class="w6mini-btn" id="sw-access" onclick="w6Sweep('access')">Low-Δv access sweep</button>
          <button class="w6mini-btn" id="sw-compound" onclick="w6Sweep('compound')">Compound shortlist</button>
          <button class="w6mini-btn" onclick="w6Sweep(null)">Clear sweep</button>
        </div>
      </div>
      <div class="w6panel">
        <div class="w6sec-hdr">Interaction</div>
        <div class="w6hint">
          <div><span class="w6kbd">Click</span> select zone, cluster, or target</div>
          <div><span class="w6kbd">Double-click</span> enter target focus</div>
          <div><span class="w6kbd">Mouse wheel</span> zoom</div>
          <div><span class="w6kbd">Shift + drag</span> rotate</div>
          <div><span class="w6kbd">W A S D</span> pan</div>
          <div><span class="w6kbd">Space</span> play / pause</div>
          <div><span class="w6kbd">Esc</span> back out of focus</div>
        </div>
      </div>
    </aside>

    <main id="w6main">
      <div id="w6overlayTop">
        <div class="w6overlay-card">
          <div class="w6overlay-title">Layer</div>
          <div class="w6overlay-value" id="ov-layer">Zones</div>
          <div class="w6overlay-sub" id="ov-layer-sub">Default macro map state</div>
        </div>
        <div class="w6overlay-card">
          <div class="w6overlay-title">Focus</div>
          <div class="w6overlay-value" id="ov-focus">System</div>
          <div class="w6overlay-sub" id="ov-focus-sub">Solar overview</div>
        </div>
      </div>
      <canvas id="w6canvas"></canvas>
      <div id="w6toast"></div>
    </main>

    <aside id="w6inspector">
      <div class="w6ins-card">
        <div class="w6ins-hdr">
          <div>
            <div class="w6ins-title">Inspector</div>
            <div class="w6ins-sub" id="w6ins-sel">No selection</div>
          </div>
          <span class="w6pill" id="w6ins-kind">Idle</span>
        </div>
        <div id="w6ins-body">
          <div class="w6small">Select a zone, cluster, or target to inspect its summary, readiness, and actions.</div>
        </div>
      </div>
    </aside>
  </div>

  <div id="w6bottombar">
    <span class="w6lbl">Time</span>
    <button class="w6btn" id="playbtn" onclick="w6TogglePlayback()">Pause</button>
    <input class="w6range" type="range" min="0" max="365" step="1" value="0" id="timeSlider" oninput="w6SetTime(this.value)">
    <span class="w6pill" id="timeReadout">T+000 d</span>
    <select class="w6sel" id="timeHorizon" onchange="w6Draw()">
      <option value="30">30d horizon</option>
      <option value="90" selected>90d horizon</option>
      <option value="180">180d horizon</option>
      <option value="365">1y horizon</option>
    </select>
    <div class="w6spacer"></div>
    <button class="w6btn" onclick="w6BackOneLevel()">Back</button>
    <button class="w6btn" onclick="w6ResetView()">Solar Overview</button>
  </div>
</div>

