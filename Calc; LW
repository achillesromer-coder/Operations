// ── Dataspace Routing ─────────────────────────────
function lwRouteInternal() {
  if (!LW_STATE) return;
  const payload = {
    calculator: 'launch_windows', version: '2.0.0',
    timestamp: LW_STATE.timestamp,
    site: LW_STATE.siteName, lat: LW_STATE.lat, lon: LW_STATE.lon,
    incl: LW_STATE.incl, targetAlt: LW_STATE.targetAlt,
    score: LW_STATE.score, goNogo: LW_STATE.score >= 60 ? 'GO' : 'NO-GO',
    azRange: LW_STATE.azRange, bonus: LW_STATE.bonus,
    vc: LW_STATE.vc, maxQ: LW_STATE.maxQ,
    windows: LW_STATE.windows,
  };
  // Route to relevant workspace keys (existing Achilles keys, no new layers)
  // Launch windows primarily relevant to W1 (operations) and W5 (mission planning)
  try { localStorage.setItem('achilles_calc_launch_w1', JSON.stringify(payload)); } catch(e){}
  try { localStorage.setItem('achilles_calc_launch_w5', JSON.stringify(payload)); } catch(e){}
}

function lwRoute(ws) {
  if (!LW_STATE) { alert('Run calculation first.'); return; }
  const payload = {
    calculator: 'launch_windows', version: '2.0.0',
    timestamp: LW_STATE.timestamp,
    site: LW_STATE.siteName, score: LW_STATE.score,
    goNogo: LW_STATE.score >= 60 ? 'GO' : 'NO-GO',
    incl: LW_STATE.incl, targetAlt: LW_STATE.targetAlt,
    windows: LW_STATE.windows,
  };
  try {
    localStorage.setItem(`achilles_calc_launch_${ws}`, JSON.stringify(payload));
    const el = document.getElementById('lw-route-status');
    if (el) {
      el.className = 'info-box'; el.style.display = '';
      el.textContent = `✓ Routed to ${ws.toUpperCase()} dataspace — ${new Date().toISOString()}`;
    }
  } catch(e) { alert('Route failed: ' + e.message); }
}

function lwRouteAll() {
  if (!LW_STATE) { alert('Run calculation first.'); return; }
  ['w1','w2','w3','w4','w5','w6'].forEach(ws => lwRoute(ws));
  const el = document.getElementById('lw-route-status');
  if (el) { el.className = 'info-box'; el.style.display = '';
