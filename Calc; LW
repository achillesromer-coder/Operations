<script>
// ── Render World Map with launch site ──────────────
function renderMap(lat, lon, siteName, azRange, incl) {
  // Ground track line from launch site
  const track = [];
  const az = azRange ? azRange[0] * LW_CONST.DEG : 90 * LW_CONST.DEG;
  for (let d = 0; d <= 10000; d += 100) {
    const dRad = d / 6371;
    const latR = lat * LW_CONST.DEG;
    const newLat = Math.asin(Math.sin(latR)*Math.cos(dRad) + Math.cos(latR)*Math.sin(dRad)*Math.cos(az));
    const newLon = (lon*LW_CONST.DEG) + Math.atan2(Math.sin(az)*Math.sin(dRad)*Math.cos(latR), Math.cos(dRad)-Math.sin(latR)*Math.sin(newLat));
    track.push({ lat: newLat/LW_CONST.DEG, lon: newLon/LW_CONST.DEG });
  }

  // Restricted azimuths arc
  const arcLats = [], arcLons = [];
  for (let a = 0; a <= 360; a += 2) {
    const aR = a * LW_CONST.DEG;
    const d = 500/6371;
    const latR = lat * LW_CONST.DEG;
    const newLat = Math.asin(Math.sin(latR)*Math.cos(d) + Math.cos(latR)*Math.sin(d)*Math.cos(aR));
    const newLon = (lon*LW_CONST.DEG) + Math.atan2(Math.sin(aR)*Math.sin(d)*Math.cos(latR), Math.cos(d)-Math.sin(latR)*Math.sin(newLat));
    arcLats.push(newLat/LW_CONST.DEG);
    arcLons.push(newLon/LW_CONST.DEG);
  }

  const data = [
    // World coastlines (simplified via geo)
    {
      type: 'scattergeo', mode: 'lines',
      lat: track.map(p=>p.lat), lon: track.map(p=>p.lon),
      line: { color:'#B87333', width:2 },
      name: 'Ground Track',
    },
    {
      type: 'scattergeo', mode: 'markers',
      lat: [lat], lon: [lon],
      marker: { size:14, color:'#C9A24A', symbol:'star', line:{color:'#F2F1EC',width:1.5} },
      name: siteName,
      text: [siteName],
      hovertemplate: '<b>%{text}</b><br>Lat: ' + lat.toFixed(3) + '°<br>Lon: ' + lon.toFixed(3) + '°<extra></extra>',
    },
    {
      type: 'scattergeo', mode: 'lines',
      lat: arcLats, lon: arcLons,
      line: { color:'rgba(78,197,193,0.3)', width:1, dash:'dot' },
      name: 'Range Circle (500 km)',
    },
  ];

  const layout = {
    ...LW_PLOTLY.layout,
    geo: {
      projection: { type:'natural earth' },
      showland: true, landcolor:'#161B22',
      showocean: true, oceancolor:'#0B0D10',
      showcoastlines: true, coastlinecolor:'#1E2530',
      showframe: false,
      bgcolor:'#0B0D10',
      lataxis: { range:[-90,90] },
      lonaxis: { range:[-180,180] },
    },
    margin: { t:10, r:10, b:10, l:10 },
    height: 480,
    title: { text:'Launch Site: ' + siteName + ' · Target Incl: ' + incl.toFixed(1) + '°', font:{size:11,color:'#8A9BB0'}, x:0.01 },
  };
  Plotly.react('lw-map', data, layout, LW_PLOTLY.config);
}

