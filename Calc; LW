<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Launch Windows Calculator | Romer Industries</title>
<script src="https://cdn.plot.ly/plotly-2.27.0.min.js"></script>
<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap');
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#0B0D10;--surface:#12151A;--panel:#161B22;--border:#1E2530;
  --copper:#B87333;--gold:#C9A24A;--teal:#4EC5C1;--cyan:#00E5FF;
  --ivory:#F2F1EC;--muted:#8A9BB0;--dim:#4A5568;
  --w1:#E53E3E;--w2:#DD6B20;--w3:#D69E2E;--w4:#38A169;--w5:#3182CE;--w6:#805AD5;
  --font-ui:'Inter',sans-serif;--font-mono:'JetBrains Mono',monospace;
}
html,body{width:100%;min-height:100vh;background:var(--bg);color:var(--ivory);font-family:var(--font-ui);font-size:14px;overflow-x:hidden}

/* ── OPS TRACKER ── */
.ops-tracker{display:flex;align-items:center;justify-content:space-between;background:var(--surface);border-bottom:1px solid var(--border);padding:0 16px;height:40px;flex-shrink:0}
.ops-id{display:flex;align-items:center;gap:10px}
.ops-beacon{width:8px;height:8px;border-radius:50%;background:var(--copper);box-shadow:0 0 6px var(--copper);animation:pulse 2s infinite}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.4}}
.ops-title{font-family:var(--font-mono);font-size:11px;color:var(--teal);font-weight:600;letter-spacing:.05em}
.ops-sub{font-size:10px;color:var(--muted);font-family:var(--font-mono)}
.ops-nav{display:flex;gap:4px;align-items:center}
.ops-pill{font-family:var(--font-mono);font-size:9px;font-weight:700;padding:2px 7px;border-radius:3px;cursor:pointer;letter-spacing:.06em;text-decoration:none;border:1px solid transparent;transition:all .15s}
.ops-pill.calc{color:var(--gold);border-color:var(--gold);background:rgba(201,162,74,.08)}
.ops-pill.calc:hover{background:rgba(201,162,74,.18)}
.ops-pill.calc.active{background:rgba(201,162,74,.22);box-shadow:0 0 8px rgba(201,162,74,.3)}
.ops-pill.w1{color:var(--w1);border-color:var(--w1);background:rgba(229,62,62,.06)}
.ops-pill.w1:hover{background:rgba(229,62,62,.14)}
.ops-pill.w2{color:var(--w2);border-color:var(--w2);background:rgba(221,107,32,.06)}
.ops-pill.w2:hover{background:rgba(221,107,32,.14)}
.ops-pill.w3{color:var(--w3);border-color:var(--w3);background:rgba(214,158,46,.06)}
.ops-pill.w3:hover{background:rgba(214,158,46,.14)}
.ops-pill.w4{color:var(--w4);border-color:var(--w4);background:rgba(56,161,105,.06)}
.ops-pill.w4:hover{background:rgba(56,161,105,.14)}
.ops-pill.w5{color:var(--w5);border-color:var(--w5);background:rgba(49,130,206,.06)}
.ops-pill.w5:hover{background:rgba(49,130,206,.14)}
.ops-pill.w6{color:var(--w6);border-color:var(--w6);background:rgba(128,90,213,.06)}
.ops-pill.w6:hover{background:rgba(128,90,213,.14)}
.ops-pill.util{color:var(--muted);border-color:var(--dim);background:transparent}
.ops-pill.util:hover{color:var(--ivory);border-color:var(--muted)}

/* ── BEACON BAR ── */
.beacon-bar{background:var(--panel);border-bottom:1px solid var(--border);padding:5px 16px;display:flex;align-items:center;gap:10px}
.beacon-dot{width:6px;height:6px;border-radius:50%;background:#22c55e;box-shadow:0 0 5px #22c55e;flex-shrink:0}
.beacon-text{font-family:var(--font-mono);font-size:9px;color:var(--muted)}
.beacon-text span{color:var(--teal)}

/* ── HEADER ── */
.calc-header{padding:20px 24px 16px;border-bottom:1px solid var(--border)}
.calc-title{font-size:22px;font-weight:700;color:var(--copper);letter-spacing:-.01em;margin-bottom:4px}
.calc-desc{font-size:11px;color:var(--muted);line-height:1.5}
.calc-badges{display:flex;flex-wrap:wrap;gap:6px;margin-top:10px}
.badge{font-family:var(--font-mono);font-size:9px;font-weight:600;padding:3px 8px;border-radius:3px;letter-spacing:.04em}
.badge-ver{background:rgba(78,197,193,.1);color:var(--teal);border:1px solid rgba(78,197,193,.25)}
.badge-tag{background:rgba(184,115,51,.1);color:var(--copper);border:1px solid rgba(184,115,51,.25)}
.badge-util{background:rgba(138,155,176,.08);color:var(--muted);border:1px solid var(--dim)}

/* ── LAYOUT ── */
.calc-body{display:grid;grid-template-columns:280px 1fr;gap:0;min-height:calc(100vh - 120px)}
.config-panel{background:var(--surface);border-right:1px solid var(--border);padding:0;overflow-y:auto}
.results-panel{background:var(--bg);overflow:hidden;display:flex;flex-direction:column}

/* ── CONFIG SECTIONS ── */
.cfg-section{border-bottom:1px solid var(--border);padding:14px 16px}
.cfg-label{font-family:var(--font-mono);font-size:9px;font-weight:700;letter-spacing:.1em;color:var(--copper);text-transform:uppercase;margin-bottom:10px}
.cfg-field{margin-bottom:10px}
.cfg-field label{display:block;font-size:10px;color:var(--muted);margin-bottom:4px;font-family:var(--font-mono)}
.cfg-field input,.cfg-field select,.cfg-field textarea{width:100%;background:var(--panel);border:1px solid var(--border);color:var(--ivory);font-family:var(--font-mono);font-size:11px;padding:6px 8px;border-radius:4px;outline:none;transition:border-color .2s}
.cfg-field input:focus,.cfg-field select:focus{border-color:var(--copper)}
.cfg-field input[type=range]{padding:0;cursor:pointer;accent-color:var(--copper)}
.cfg-field select option{background:var(--panel)}
.cfg-row{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.cfg-checkbox{display:flex;align-items:center;gap:8px;cursor:pointer;font-size:10px;color:var(--muted);font-family:var(--font-mono)}
.cfg-checkbox input{accent-color:var(--copper);width:13px;height:13px}

/* ── ACTION BUTTONS ── */
.btn{font-family:var(--font-mono);font-size:10px;font-weight:700;letter-spacing:.06em;padding:8px 14px;border-radius:4px;border:none;cursor:pointer;transition:all .15s;text-transform:uppercase}
.btn-primary{background:linear-gradient(135deg,var(--copper),var(--gold));color:#0B0D10}
.btn-primary:hover{opacity:.88;transform:translateY(-1px)}
.btn-secondary{background:transparent;color:var(--teal);border:1px solid var(--teal)}
.btn-secondary:hover{background:rgba(78,197,193,.08)}
.btn-danger{background:transparent;color:#e53e3e;border:1px solid #e53e3e}
.btn-danger:hover{background:rgba(229,62,62,.08)}
.btn-sm{padding:5px 10px;font-size:9px}
.btn-row{display:flex;flex-wrap:wrap;gap:8px;padding:14px 16px}
.btn-full{width:100%}
.btn-group{display:flex;gap:6px;width:100%}
.btn-group .btn{flex:1}

/* ── TABS ── */
.tab-bar{display:flex;background:var(--surface);border-bottom:1px solid var(--border);overflow-x:auto;flex-shrink:0}
.tab{font-family:var(--font-mono);font-size:10px;font-weight:600;letter-spacing:.06em;padding:10px 16px;cursor:pointer;border-bottom:2px solid transparent;color:var(--muted);white-space:nowrap;transition:all .15s;text-transform:uppercase}
.tab.active{color:var(--copper);border-bottom-color:var(--copper)}
.tab:hover:not(.active){color:var(--ivory)}
.tab-content{flex:1;overflow:hidden;display:none;padding:16px;flex-direction:column;gap:12px}
.tab-content.active{display:flex}

/* ── MAP DISPLAY ── */
.map-container{position:relative;width:100%;flex:1;min-height:500px;background:var(--panel);border-radius:6px;border:1px solid var(--border);overflow:hidden}
#lw-map{width:100%;height:100%;min-height:500px}

/* ── TIMELINE ── */
.timeline-container{background:var(--panel);border:1px solid var(--border);border-radius:6px;padding:12px;flex-shrink:0}
.timeline-label{font-family:var(--font-mono);font-size:9px;color:var(--muted);margin-bottom:6px;text-transform:uppercase;letter-spacing:.08em}
#lw-timeline{width:100%;height:180px}

/* ── LAUNCH LIST ── */
.launch-list{display:flex;flex-direction:column;gap:8px;max-height:400px;overflow-y:auto}
.launch-card{background:var(--panel);border:1px solid var(--border);border-radius:6px;padding:12px;cursor:pointer;transition:border-color .15s}
.launch-card:hover{border-color:var(--copper)}
.launch-card.selected{border-color:var(--copper);box-shadow:0 0 10px rgba(184,115,51,.15)}
.lc-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:6px}
.lc-name{font-family:var(--font-mono);font-size:11px;font-weight:700;color:var(--ivory)}
.lc-score{font-family:var(--font-mono);font-size:10px;font-weight:700;padding:2px 7px;border-radius:3px}
.lc-score.high{color:#22c55e;background:rgba(34,197,94,.12);border:1px solid rgba(34,197,94,.3)}
.lc-score.med{color:var(--gold);background:rgba(201,162,74,.12);border:1px solid rgba(201,162,74,.3)}
.lc-score.low{color:#e53e3e;background:rgba(229,62,62,.12);border:1px solid rgba(229,62,62,.3)}
.lc-meta{font-size:10px;color:var(--muted);font-family:var(--font-mono);line-height:1.6}
.lc-meta span{color:var(--ivory)}
.lc-bar{height:3px;background:var(--border);border-radius:2px;margin-top:8px;overflow:hidden}
.lc-bar-fill{height:100%;border-radius:2px;background:linear-gradient(90deg,var(--copper),var(--gold));transition:width .4s ease}

/* ── WIND CHART ── */
.wind-container{background:var(--panel);border:1px solid var(--border);border-radius:6px;padding:12px}
#lw-wind{width:100%;height:280px}

/* ── SWEEP TABLE ── */
.sweep-table-wrap{overflow-x:auto;max-height:360px;overflow-y:auto}
.sweep-table{width:100%;border-collapse:collapse;font-family:var(--font-mono);font-size:10px}
.sweep-table th{background:var(--surface);color:var(--muted);padding:6px 10px;text-align:left;border-bottom:1px solid var(--border);font-weight:700;letter-spacing:.06em;text-transform:uppercase;position:sticky;top:0}
.sweep-table td{padding:6px 10px;border-bottom:1px solid rgba(30,37,48,.6);color:var(--ivory)}
.sweep-table tr:hover td{background:rgba(184,115,51,.04)}
.sweep-table .val-good{color:#22c55e}
.sweep-table .val-warn{color:var(--gold)}
.sweep-table .val-bad{color:#e53e3e}

/* ── EXPORT PANEL ── */
.export-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
.export-card{background:var(--panel);border:1px solid var(--border);border-radius:6px;padding:14px;text-align:center;cursor:pointer;transition:all .15s}
.export-card:hover{border-color:var(--copper);background:rgba(184,115,51,.04)}
.export-card .ec-icon{font-size:22px;margin-bottom:6px}
.export-card .ec-label{font-family:var(--font-mono);font-size:10px;font-weight:700;color:var(--ivory);margin-bottom:3px}
.export-card .ec-desc{font-size:9px;color:var(--muted)}

/* ── STATUS / INFO ── */
.info-box{background:var(--panel);border:1px solid var(--border);border-left:3px solid var(--teal);border-radius:4px;padding:10px 14px;font-family:var(--font-mono);font-size:10px;color:var(--teal);line-height:1.6}
.info-box.warn{border-left-color:var(--gold);color:var(--gold)}
.info-box.err{border-left-color:#e53e3e;color:#e53e3e}
.stat-row{display:flex;justify-content:space-between;align-items:center;padding:6px 0;border-bottom:1px solid rgba(30,37,48,.5)}
.stat-row:last-child{border-bottom:none}
.stat-label{font-size:10px;color:var(--muted);font-family:var(--font-mono)}
.stat-val{font-family:var(--font-mono);font-size:11px;font-weight:700;color:var(--ivory)}
.stat-val.good{color:#22c55e}
.stat-val.warn{color:var(--gold)}
.stat-val.bad{color:#e53e3e}
.section-title{font-family:var(--font-mono);font-size:10px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);margin-bottom:8px}

/* ── RANGE SLIDER ── */
.range-wrap{display:flex;align-items:center;gap:8px}
.range-wrap input[type=range]{flex:1}
.range-val{font-family:var(--font-mono);font-size:10px;color:var(--teal);min-width:42px;text-align:right}

/* ── SCROLLBAR ── */
::-webkit-scrollbar{width:5px;height:5px}
::-webkit-scrollbar-track{background:var(--surface)}
::-webkit-scrollbar-thumb{background:var(--dim);border-radius:3px}
::-webkit-scrollbar-thumb:hover{background:var(--copper)}

/* ── RESPONSIVE ── */
@media(max-width:900px){
  .calc-body{grid-template-columns:1fr}
  .config-panel{border-right:none;border-bottom:1px solid var(--border)}
  .export-grid{grid-template-columns:repeat(2,1fr)}
}
</style>
</head>
<body>

<!-- OPS TRACKER -->
<div class="ops-tracker">
  <div class="ops-id">
    <div class="ops-beacon"></div>
    <div>
      <div class="ops-title">LAUNCH WINDOWS CALCULATOR</div>
      <div class="ops-sub">
      <a href="/calc/orbital" class="ops-pill calc">ORB</a>
      <a href="/calc/launch" class="ops-pill calc active">LW</a>
      <a href="/calc/magnetostatics" class="ops-pill calc">MAG</a>
      <a href="/calc/energy" class="ops-pill calc">PWR</a>
      <a href="/calc/fluids" class="ops-pill calc">FLD</a>
      <a href="/sims/rfs-extraction" class="ops-pill sim">RFS</a>
      <a href="/sim/node" class="ops-pill sim">EMFF</a>
      <a href="/sim/fields" class="ops-pill sim">EMF</a>
      <a href="/sim/re-entry" class="ops-pill sim">ENTRY</a>
      <a href="/w1/data" class="ops-pill w1">W1</a>
      <a href="/w2/data" class="ops-pill w2">W2</a>
      <a href="/w3/data" class="ops-pill w3">W3</a>
      <a href="/w4/data" class="ops-pill w4">W4</a>
      <a href="/w5/data" class="ops-pill w5">W5</a>
      <a href="/w6/data" class="ops-pill w6">W6</a>
      <a href="/data/achilles" class="ops-pill util">ACH</a>
      <a href="/library" class="ops-pill util">LIB</a>
      <a href="/gmat" class="ops-pill util">GMAT</a>
      <a href="/dash" class="ops-pill util">DASH</a>
    </div>

<!-- BEACON BAR -->
<div class="beacon-bar">
  <div class="beacon-dot"></div>
  <span class="beacon-text">
    <span>LIVE</span> &nbsp;/calc/launch &nbsp;·&nbsp; Universal – callable by all workspaces &amp; dataspaces &nbsp;·&nbsp; Römer Industries / EMASSC
  </span>
</div>

<!-- HEADER -->
<div class="calc-header">
  <div class="calc-title">Launch Windows Calculator</div>
  <div class="calc-desc">Launch site scoring · Seasonal atmosphere · Wind profile analysis · Trajectory azimuth constraints · Plotly visualisation · GMAT export</div>
  <div class="calc-badges">
    <span class="badge badge-ver"></span>
    <span class="badge badge-tag">SI Units</span>
    <span class="badge badge-tag">Universal Tool – W1-W6 callable</span>
    <span class="badge badge-tag">Plotly Visualisation</span>
    <span class="badge badge-util">JetBrains Mono · Inter</span>
  </div>
</div>

<!-- MAIN BODY -->
<div class="calc-body">

  <!-- LEFT: CONFIGURATION -->
  <div class="config-panel">

    <div class="cfg-section">
      <div class="cfg-label">Launch Site</div>
      <div class="cfg-field">
        <label>Site Preset</label>
        <select id="lw-site-preset">
          <option value="kennedy">Kennedy Space Center (KSC) — 28.6°N</option>
          <option value="vandenberg">Vandenberg SFB — 34.7°N</option>
          <option value="baikonur">Baikonur Cosmodrome — 45.9°N</option>
          <option value="kourou">Kourou (CSG) — 5.2°N</option>
          <option value="tanegashima">Tanegashima — 30.4°N</option>
          <option value="sriharikota">Sriharikota (SHAR) — 13.7°N</option>
          <option value="wenchang">Wenchang — 19.6°N</option>
          <option value="plesetsk">Plesetsk — 62.9°N</option>
          <option value="custom">Custom Site</option>
        </select>
      </div>
      <div class="cfg-row">
        <div class="cfg-field">
          <label>Latitude (°)</label>
          <input type="number" id="lw-lat" value="28.573" step="0.001" min="-90" max="90">
        </div>
        <div class="cfg-field">
          <label>Longitude (°)</label>
          <input type="number" id="lw-lon" value="-80.649" step="0.001" min="-180" max="180">
        </div>
      </div>
      <div class="cfg-field">
        <label>Site Altitude (m ASL)</label>
        <input type="number" id="lw-alt-site" value="5" step="1" min="0">
      </div>
    </div>

    <div class="cfg-section">
      <div class="cfg-label">Mission Parameters</div>
      <div class="cfg-field">
        <label>Target Orbit Type</label>
        <select id="lw-orbit-type">
          <option value="leo">LEO (Low Earth Orbit)</option>
          <option value="sso">SSO (Sun-Synchronous)</option>
          <option value="geo">GTO / GEO Transfer</option>
          <option value="meo">MEO</option>
          <option value="iss">ISS Rendezvous (51.6°)</option>
          <option value="polar">Polar</option>
          <option value="custom">Custom Inclination</option>
        </select>
      </div>
      <div class="cfg-field">
        <label>Target Inclination (°)</label>
        <input type="number" id="lw-incl" value="28.6" step="0.1" min="0" max="180">
      </div>
      <div class="cfg-field">
        <label>Target Altitude (km)</label>
        <input type="number" id="lw-target-alt" value="400" step="10" min="200" max="36000">
      </div>
      <div class="cfg-field">
        <label>Launch Azimuth Range (°)</label>
        <div class="cfg-row">
          <input type="number" id="lw-az-min" value="35" step="1" min="0" max="360" placeholder="Min Az">
          <input type="number" id="lw-az-max" value="120" step="1" min="0" max="360" placeholder="Max Az">
        </div>
      </div>
    </div>

    <div class="cfg-section">
      <div class="cfg-label">Atmospheric / Season</div>
      <div class="cfg-field">
        <label>Season</label>
        <select id="lw-season">
          <option value="spring">Spring (Mar–May)</option>
          <option value="summer" selected>Summer (Jun–Aug)</option>
          <option value="autumn">Autumn (Sep–Nov)</option>
          <option value="winter">Winter (Dec–Feb)</option>
        </select>
      </div>
      <div class="cfg-field">
        <label>Surface Wind (m/s)</label>
        <div class="range-wrap">
          <input type="range" id="lw-wind-surf" min="0" max="30" value="8" step="0.5" oninput="document.getElementById('lw-wind-surf-val').textContent=this.value">
          <span class="range-val" id="lw-wind-surf-val">8</span>
        </div>
      </div>
      <div class="cfg-field">
        <label>Upper-Level Wind @ 10 km (m/s)</label>
        <div class="range-wrap">
          <input type="range" id="lw-wind-upper" min="0" max="80" value="25" step="1" oninput="document.getElementById('lw-wind-upper-val').textContent=this.value">
          <span class="range-val" id="lw-wind-upper-val">25</span>
        </div>
      </div>
      <div class="cfg-field">
        <label>Wind Direction @ Surface (°)</label>
        <input type="number" id="lw-wind-dir" value="270" step="5" min="0" max="360">
      </div>
      <label class="cfg-checkbox">
        <input type="checkbox" id="lw-jetstream" checked>
        Enable Jet Stream Model
      </label>
    </div>

    <div class="cfg-section">
      <div class="cfg-label">Constraints</div>
      <div class="cfg-field">
        <label>Max Surface Wind (m/s) — GO/NO-GO</label>
        <input type="number" id="lw-wind-limit" value="12" step="0.5">
      </div>
      <div class="cfg-field">
        <label>Max Upper Wind (m/s)</label>
        <input type="number" id="lw-upper-limit" value="50" step="1">
      </div>
      <div class="cfg-field">
        <label>Min Visibility (km)</label>
        <input type="number" id="lw-vis-min" value="5" step="0.5">
      </div>
      <label class="cfg-checkbox">
        <input type="checkbox" id="lw-range-safety" checked>
        Range Safety Exclusion Zones
      </label>
      <label class="cfg-checkbox" style="margin-top:6px">
        <input type="checkbox" id="lw-debris-avoidance" checked>
        Orbital Debris Avoidance
      </label>
    </div>

    <div class="cfg-section">
      <div class="cfg-label">Launch Sweep</div>
      <div class="cfg-field">
        <label>Sweep Variable</label>
        <select id="lw-sweep-var">
          <option value="latitude">Launch Latitude (°)</option>
          <option value="azimuth">Launch Azimuth (°)</option>
          <option value="altitude">Target Altitude (km)</option>
          <option value="inclination">Inclination (°)</option>
          <option value="wind">Surface Wind (m/s)</option>
          <option value="season">Seasonal Comparison</option>
        </select>
      </div>
      <div class="cfg-row">
        <div class="cfg-field">
          <label>Sweep Min</label>
          <input type="number" id="lw-sweep-min" value="10" step="1">
        </div>
        <div class="cfg-field">
          <label>Sweep Max</label>
          <input type="number" id="lw-sweep-max" value="90" step="1">
        </div>
      </div>
      <div class="cfg-field">
