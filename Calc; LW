<script>
// ═══════════════════════════════════════════════════
// LAUNCH WINDOWS CALCULATOR 
// Physics & Math Core
// Römer Industries / EMASSC
// ═══════════════════════════════════════════════════

const LW_CONST = {
  RE: 6371000,       // Earth radius m
  GM: 3.986004418e14,
  OMEGA: 7.2921150e-5, // Earth rotation rad/s
  G0: 9.80665,
  DEG: Math.PI/180,
};

// Launch site presets
const LW_SITES = {
  kennedy:     { name:'Kennedy Space Center',   lat:28.5729,  lon:-80.6490, alt:5,   az_min:35, az_max:120 },
  vandenberg:  { name:'Vandenberg SFB',         lat:34.7420,  lon:-120.5724,alt:100, az_min:158,az_max:268 },
  baikonur:    { name:'Baikonur Cosmodrome',    lat:45.9200,  lon:63.3420,  alt:90,  az_min:60, az_max:100 },
  kourou:      { name:'Kourou (CSG)',            lat:5.2360,   lon:-52.7686, alt:15,  az_min:3,  az_max:93  },
  tanegashima: { name:'Tanegashima',            lat:30.3782,  lon:130.9690, alt:10,  az_min:100,az_max:135 },
  sriharikota: { name:'Sriharikota (SHAR)',     lat:13.7199,  lon:80.2300,  alt:5,   az_min:100,az_max:140 },
  wenchang:    { name:'Wenchang',               lat:19.6145,  lon:110.9506, alt:5,   az_min:90, az_max:180 },
  plesetsk:    { name:'Plesetsk',               lat:62.9271,  lon:40.5770,  alt:120, az_min:0,  az_max:360 },
};

// ── Azimuth → Inclination ──────────────────────────
function azToIncl(az_deg, lat_deg) {
  const az = az_deg * LW_CONST.DEG;
  const lat = lat_deg * LW_CONST.DEG;
  return Math.acos(Math.cos(az) * Math.cos(lat)) / LW_CONST.DEG;
}

// ── Inclination → Azimuth range ───────────────────
function inclToAzRange(incl_deg, lat_deg) {
  // Returns [az1, az2] in degrees (ascending and descending node azimuths)
  if (Math.abs(lat_deg) > incl_deg) return null; // unreachable
  const incl = incl_deg * LW_CONST.DEG;
  const lat  = lat_deg  * LW_CONST.DEG;
  const cosAz = Math.cos(incl) / Math.cos(lat);
  if (Math.abs(cosAz) > 1) return null;
  const az = Math.acos(cosAz) / LW_CONST.DEG;
  return [az, 360 - az]; // prograde and retrograde
}

// ── Circular orbital velocity ──────────────────────
function circVel(alt_m) {
  const r = LW_CONST.RE + alt_m;
  return Math.sqrt(LW_CONST.GM / r);
}

// ── Surface rotation velocity ──────────────────────
function surfVel(lat_deg) {
  return LW_CONST.OMEGA * LW_CONST.RE * Math.cos(lat_deg * LW_CONST.DEG);
}

// ── ΔV launch bonus (eastward component) ──────────
function launchBonus(az_deg, lat_deg, alt_m) {
  const sv = surfVel(lat_deg);
  const az = az_deg * LW_CONST.DEG;
  return sv * Math.cos(az);
}

// ── Wind load estimate (simplified) ───────────────
function maxQ_estimate(v_mps, rho0 = 1.225) {
  // Max dynamic pressure (simplified linear density falloff)
  // Returns kPa
  const rho_at_maxQ = rho0 * 0.35; // ~11-13 km
  return 0.5 * rho_at_maxQ * v_mps * v_mps / 1000;
}

// ── Seasonal wind profile (parametric) ────────────
function windProfile(alt_km, season, lat_deg, addJetStream) {
  // Returns {speed_ms, dir_deg} at given altitude
  const alts = [0,1,2,3,5,7,10,12,15,20,25,30,40,50,60,70,80];
  const profiles = {
    summer:  [8, 9,10,12,14,16,22,30,20,14,10, 8, 6, 5, 5, 4, 3],
    winter:  [6, 8,10,14,18,24,35,45,30,18,12, 9, 7, 5, 5, 4, 3],
    spring:  [7, 8, 9,11,13,15,25,35,22,15,10, 8, 6, 5, 5, 4, 3],
    autumn:  [7, 9,10,12,14,17,28,32,21,14,10, 8, 6, 5, 5, 4, 3],
  };
  const dirs = {
    summer:  [270,265,260,255,250,245,240,235,240,250,260,265,270,275,275,280,280],
    winter:  [250,248,245,242,240,238,235,232,240,250,260,265,268,272,275,278,280],
    spring:  [260,258,255,252,248,245,242,238,242,252,262,266,270,274,276,279,280],
    autumn:  [265,262,258,254,249,245,240,235,241,251,261,265,269,273,275,279,280],
  };
  const sp = profiles[season] || profiles.summer;
  const dp = dirs[season] || dirs.summer;
  
  // Interpolate
  let i = alts.findIndex(a => a >= alt_km);
  if (i <= 0) i = 1;
  if (i >= alts.length) i = alts.length - 1;
  const t = (alt_km - alts[i-1]) / (alts[i] - alts[i-1]);
  let speed = sp[i-1] + t*(sp[i]-sp[i-1]);
  let dir   = dp[i-1] + t*(dp[i]-dp[i-1]);
  
  // Jet stream enhancement
  if (addJetStream && alt_km > 8 && alt_km < 14) {
    const jsBoost = 25 * Math.exp(-Math.pow((alt_km - 11), 2) / 2);
    speed += jsBoost;
  }
  
  // Latitude scaling (polar vortex enhancement at high latitudes)
  if (Math.abs(lat_deg) > 50) speed *= (1 + (Math.abs(lat_deg)-50)*0.015);
  
  return { speed, dir };
}

// ── Window score (0–100) ──────────────────────────
function scoreWindow(site, windSurf, windUpper, windLimit, upperLimit, vis, inclReachable) {
  let score = 100;
  // Wind penalties
  if (windSurf > windLimit) score -= 40;
  else score -= (windSurf / windLimit) * 15;
  if (windUpper > upperLimit) score -= 30;
  else score -= (windUpper / upperLimit) * 10;
  // Visibility
  if (vis < 5) score -= 20;
  // Inclination reachability
  if (!inclReachable) score -= 50;
  return Math.max(0, Math.round(score));
}

// ── Generate 24h window timeline ─────────────────
function genWindowTimeline(score, windSurf, windLimit) {
  const windows = [];
  const baseGo = score >= 60;
  for (let h = 0; h < 24; h++) {
    // Diurnal wind variation (lower in morning)
    const diurnalFactor = 0.7 + 0.3 * Math.sin((h - 6) * Math.PI / 12);
    const ws = windSurf * diurnalFactor;
    const go = baseGo && ws <= windLimit;
    const wScore = go ? Math.round(score * (1 - Math.abs(h-12)/30)) : 0;
    windows.push({ hour: h, go, score: wScore, wind: ws.toFixed(1) });
  }
  return windows;
}

// ── Sweep calculations ────────────────────────────
function sweepWindows(varName, min, max, steps, params) {
  const results = [];
  for (let i = 0; i < steps; i++) {
    const val = min + (max - min) * i / (steps - 1);
    let p = { ...params };
    
    if (varName === 'latitude') p.lat = val;
    else if (varName === 'azimuth') p.azimuth = val;
    else if (varName === 'altitude') p.targetAlt = val * 1000;
    else if (varName === 'inclination') p.incl = val;
    else if (varName === 'wind') p.windSurf = val;
    
    const azRange = inclToAzRange(p.incl, p.lat);
    const reachable = azRange !== null;
    const bonus = launchBonus(azRange ? azRange[0] : 90, p.lat, p.targetAlt);
    const vc = circVel(p.targetAlt);
    const ws = p.windSurf;
    const score = scoreWindow(null, ws, p.windUpper, p.windLimit, p.upperLimit, p.vis, reachable);
    
    results.push({
      var: val,
      score,
      reachable,
      launchBonus: bonus.toFixed(1),
      circVel: (vc/1000).toFixed(3),
      azMin: azRange ? azRange[0].toFixed(1) : 'N/A',
      azMax: azRange ? azRange[1].toFixed(1) : 'N/A',
      maxQ: maxQ_estimate(vc).toFixed(2),
    });
  }
  return results;
}
