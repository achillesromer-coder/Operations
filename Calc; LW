}

// ── Render Wind Profile ────────────────────────────
function renderWindProfile(season, lat, addJS) {
  const altitudes = [0,1,2,3,5,7,10,12,15,20,25,30,40,50,60,70,80];
  const speeds = altitudes.map(a => windProfile(a, season, lat, addJS).speed);
  const speedNoJS = altitudes.map(a => windProfile(a, season, lat, false).speed);

  const traces = [
    { type:'scatter', mode:'lines+markers', x:speeds, y:altitudes,
      line:{color:'#B87333',width:2}, marker:{size:4,color:'#C9A24A'},
      name:'Wind Speed', hovertemplate:'%{x:.1f} m/s @ %{y} km<extra></extra>' },
  ];
  if (addJS) traces.push(
    { type:'scatter', mode:'lines', x:speedNoJS, y:altitudes,
      line:{color:'#4A5568',width:1,dash:'dash'}, name:'Without Jet Stream' }
  );

  const layout = {
    ...LW_PLOTLY.layout, height:260,
    xaxis: { ...LW_PLOTLY.layout.xaxis, title:{text:'Wind Speed (m/s)',font:{size:9}} },
    yaxis: { ...LW_PLOTLY.layout.yaxis, title:{text:'Altitude (km)',font:{size:9}} },
    shapes: [
      { type:'rect', x0:0, x1:200, y0:8, y1:14, fillcolor:'rgba(0,229,255,0.04)', line:{width:0} },
    ],
    annotations: [{ x:5, y:11, text:'Jet Stream', showarrow:false, font:{size:8,color:'#00E5FF'} }],
  };
  Plotly.react('lw-wind', traces, layout, LW_PLOTLY.config);
}

// ── Render Wind Hodograph ──────────────────────────
function renderHodograph(season, lat, addJS) {
  const altitudes = [0,1,2,3,5,7,10,12,15,20,25,30];
  const u = [], v = [];
  altitudes.forEach(a => {
    const wp = windProfile(a, season, lat, addJS);
    const rad = wp.dir * LW_CONST.DEG;
    u.push(wp.speed * Math.sin(rad));
    v.push(wp.speed * Math.cos(rad));
  });
  const traces = [{
    type:'scatter', mode:'lines+markers',
    x: u, y: v,
    line:{color:'#4EC5C1',width:2},
    marker:{size:5,color:altitudes.map((_,i)=>i),colorscale:[[0,'#B87333'],[0.5,'#C9A24A'],[1,'#4EC5C1']],showscale:true,colorbar:{title:{text:'Alt km',font:{size:8}},tickfont:{size:8}}},
    hovertemplate:'U: %{x:.1f} m/s<br>V: %{y:.1f} m/s<extra></extra>',
    name:'Hodograph',
  }];
  const layout = {
    ...LW_PLOTLY.layout, height:260,
    xaxis: { ...LW_PLOTLY.layout.xaxis, title:{text:'U (m/s)',font:{size:9}}, zeroline:true, zerolinecolor:'#4A5568' },
    yaxis: { ...LW_PLOTLY.layout.yaxis, title:{text:'V (m/s)',font:{size:9}}, zeroline:true, zerolinecolor:'#4A5568', scaleanchor:'x' },
  };
  Plotly.react('lw-hodograph', traces, layout, LW_PLOTLY.config);
}

// ── Render Azimuth Chart ───────────────────────────
function renderAzimuthChart(lat, azMin, azMax) {
  const azimuths = Array.from({length:181}, (_, i) => i);
  const incls = azimuths.map(az => {
    try { return azToIncl(az, lat); } catch(e) { return null; }
  }).filter(v => v !== null);

  const traces = [
    { type:'scatter', mode:'lines', x:azimuths, y:incls,
      line:{color:'#B87333',width:2}, name:'Achievable Incl',
      hovertemplate:'Az: %{x}°<br>Incl: %{y:.2f}°<extra></extra>' },
  ];
  const layout = {
    ...LW_PLOTLY.layout, height:260,
    xaxis: { ...LW_PLOTLY.layout.xaxis, title:{text:'Launch Azimuth (°)',font:{size:9}}, range:[0,180] },
    yaxis: { ...LW_PLOTLY.layout.yaxis, title:{text:'Inclination (°)',font:{size:9}} },
    shapes: [
      { type:'rect', x0:azMin, x1:azMax, y0:0, y1:180, fillcolor:'rgba(78,197,193,0.06)', line:{color:'#4EC5C1',width:1,dash:'dash'} },
    ],
    annotations: [{ x:(azMin+azMax)/2, y:10, text:'Allowed range', showarrow:false, font:{size:8,color:'#4EC5C1'} }],
  };
  Plotly.react('lw-azimuth-plot', traces, layout, LW_PLOTLY.config);
}

// ── Render Polar Azimuth ───────────────────────────
function renderPolarAzimuth(lat, azMin, azMax, azRange) {
  const theta = Array.from({length:361}, (_,i) => i);
  const rAll = theta.map(() => 1);
  const allowed = theta.map(a => (a >= azMin && a <= azMax) ? 1 : null);
  const traces = [
    { type:'scatterpolar', mode:'lines', theta:theta, r:rAll, fill:'toself',
      fillcolor:'rgba(30,37,48,0.4)', line:{color:'#1E2530'}, name:'All Azimuths', showlegend:false },
    { type:'scatterpolar', mode:'lines', theta:theta.filter((_,i)=>allowed[i]!==null), r:allowed.filter(v=>v!==null), fill:'toself',
      fillcolor:'rgba(78,197,193,0.15)', line:{color:'#4EC5C1',width:2}, name:'Allowed Window' },
  ];
  if (azRange) {
    traces.push({ type:'scatterpolar', mode:'markers',
      theta:[azRange[0],azRange[1]], r:[1,1],
      marker:{size:10,color:'#C9A24A',symbol:'star'}, name:'Optimal Azimuths' });
  }
  const layout = {
    ...LW_PLOTLY.layout, height:260,
    polar: { radialaxis:{visible:false}, angularaxis:{direction:'clockwise',rotation:90,tickfont:{size:8}}, bgcolor:'#0B0D10' },
  };
  Plotly.react('lw-polar-plot', traces, layout, LW_PLOTLY.config);
}
</script>
<script>
// ── State ─────────────────────────────────────────
let LW_STATE = null;

// ── Main Calculate ────────────────────────────────
function lwCalculate() {
  // Read inputs
  const lat    = parseFloat(document.getElementById('lw-lat').value);
  const lon    = parseFloat(document.getElementById('lw-lon').value);
  const altSite = parseFloat(document.getElementById('lw-alt-site').value);
  const incl   = parseFloat(document.getElementById('lw-incl').value);
  const tgtAlt = parseFloat(document.getElementById('lw-target-alt').value) * 1000; // m
  const azMin  = parseFloat(document.getElementById('lw-az-min').value);
  const azMax  = parseFloat(document.getElementById('lw-az-max').value);
  const season = document.getElementById('lw-season').value;
  const windSurf = parseFloat(document.getElementById('lw-wind-surf').value);
  const windUpper = parseFloat(document.getElementById('lw-wind-upper').value);
  const windLimit = parseFloat(document.getElementById('lw-wind-limit').value);
  const upperLimit = parseFloat(document.getElementById('lw-upper-limit').value);
  const vis    = parseFloat(document.getElementById('lw-vis-min').value);
  const useJS  = document.getElementById('lw-jetstream').checked;
  const siteKey = document.getElementById('lw-site-preset').value;
  const siteData = LW_SITES[siteKey] || { name: 'Custom Site' };

  // Compute
  const azRange = inclToAzRange(incl, lat);
  const vc = circVel(tgtAlt);
  const bonus = launchBonus(azRange ? azRange[0] : azMin, lat, tgtAlt);
  const score = scoreWindow(null, windSurf, windUpper, windLimit, upperLimit, vis, azRange !== null);
  const maxQ  = maxQ_estimate(vc);
  const windows = genWindowTimeline(score, windSurf, windLimit);

  LW_STATE = {
    siteName: siteData.name, lat, lon, altSite, incl, targetAlt: tgtAlt,
    azMin, azMax, azRange, season, windSurf, windUpper, windLimit, upperLimit,
    vis, useJS, vc, bonus, score, maxQ, windows,
    timestamp: new Date().toISOString(),
  };

  // Render all tabs
  renderMap(lat, lon, siteData.name, azRange, incl);
  renderTimeline(windows);
  renderWindProfile(season, lat, useJS);
  renderHodograph(season, lat, useJS);
  renderAzimuthChart(lat, azMin, azMax);
  renderPolarAzimuth(lat, azMin, azMax, azRange);
  renderStats(LW_STATE);
  renderLaunchCards(windows);

  // Status
  const goCount = windows.filter(w => w.go).length;
  lwStatus('lw-status-map',
    `Site: ${siteData.name} · Incl ${incl}° · Score: ${score}/100 · ${goCount} GO windows in 24h · ${azRange ? 'AZIMUTH OK' : 'AZIMUTH CONSTRAINT'}`,
    score >= 60 ? '' : 'warn'
  );

  // Auto-route to localStorage (no new keys, just update existing achilles keys)
  lwRouteInternal();
}

// ── Seed Demo ─────────────────────────────────────
function lwSeedDemo() {
  // Set ISS rendezvous from KSC demo
  document.getElementById('lw-site-preset').value = 'kennedy';
  lwSitePreset();
  document.getElementById('lw-incl').value = 51.6;
  document.getElementById('lw-target-alt').value = 420;
  document.getElementById('lw-orbit-type').value = 'iss';
  document.getElementById('lw-season').value = 'summer';
  document.getElementById('lw-wind-surf').value = 6;
  document.getElementById('lw-wind-surf-val').textContent = '6';
  document.getElementById('lw-wind-upper').value = 22;
  document.getElementById('lw-wind-upper-val').textContent = '22';
  lwCalculate();
}

// ── Site Preset handler ───────────────────────────
function lwSitePreset() {
  const key = document.getElementById('lw-site-preset').value;
  const site = LW_SITES[key];
  if (!site) return;
  document.getElementById('lw-lat').value = site.lat;
  document.getElementById('lw-lon').value = site.lon;
  document.getElementById('lw-alt-site').value = site.alt;
  document.getElementById('lw-az-min').value = site.az_min;
  document.getElementById('lw-az-max').value = site.az_max;
}

// ── Orbit type handler ────────────────────────────
function lwOrbitType() {
  const map = { leo:28.6, sso:97.8, geo:27.0, meo:45.0, iss:51.6, polar:90.0 };
  const altMap = { leo:400, sso:550, geo:35786, meo:20200, iss:420, polar:500 };
  const type = document.getElementById('lw-orbit-type').value;
  if (type !== 'custom') {
    document.getElementById('lw-incl').value = map[type] || 28.6;
    document.getElementById('lw-target-alt').value = altMap[type] || 400;
  }
}

// ── Add Custom Site ───────────────────────────────
function lwAddSite() {
  const lat = parseFloat(prompt('Latitude (°):', '0'));
  const lon = parseFloat(prompt('Longitude (°):', '0'));
  const name = prompt('Site Name:', 'Custom Launch Site') || 'Custom';
  if (!isNaN(lat) && !isNaN(lon)) {
    LW_SITES.custom = { name, lat, lon, alt:0, az_min:0, az_max:360 };
    document.getElementById('lw-lat').value = lat;
    document.getElementById('lw-lon').value = lon;
    document.getElementById('lw-site-preset').value = 'custom';
    alert(`Site "${name}" added at ${lat}°, ${lon}°`);
  }
}

// ── Sweep ─────────────────────────────────────────
function lwSweep() {
  const varName = document.getElementById('lw-sweep-var').value;
  const min = parseFloat(document.getElementById('lw-sweep-min').value);
  const max = parseFloat(document.getElementById('lw-sweep-max').value);
  const steps = parseInt(document.getElementById('lw-sweep-steps').value);

  const params = {
    lat: parseFloat(document.getElementById('lw-lat').value),
    lon: parseFloat(document.getElementById('lw-lon').value),
    incl: parseFloat(document.getElementById('lw-incl').value),
    targetAlt: parseFloat(document.getElementById('lw-target-alt').value) * 1000,
    windSurf: parseFloat(document.getElementById('lw-wind-surf').value),
    windUpper: parseFloat(document.getElementById('lw-wind-upper').value),
    windLimit: parseFloat(document.getElementById('lw-wind-limit').value),
    upperLimit: parseFloat(document.getElementById('lw-upper-limit').value),
    vis: parseFloat(document.getElementById('lw-vis-min').value),
    azimuth: parseFloat(document.getElementById('lw-az-min').value),
  };

  const results = varName === 'season'
    ? ['spring','summer','autumn','winter'].map(s => ({ var:s, score: scoreWindow(null, params.windSurf * (s==='winter'?1.3:s==='summer'?0.9:1.1), params.windUpper, params.windLimit, params.upperLimit, params.vis, inclToAzRange(params.incl, params.lat) !== null), reachable: inclToAzRange(params.incl, params.lat) !== null, launchBonus: launchBonus(90, params.lat, params.targetAlt).toFixed(1), circVel: (circVel(params.targetAlt)/1000).toFixed(3), azMin:'N/A', azMax:'N/A', maxQ: maxQ_estimate(circVel(params.targetAlt)).toFixed(2) }))
    : sweepWindows(varName, min, max, steps, params);

  renderSweepPlot(results, varName);
  renderSweepTable(results, varName);
  lwStatus('lw-sweep-status', `Sweep complete: ${results.length} points · Variable: ${varName}`);

  // Switch to sweep tab
  document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
  document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
  document.querySelector('.tab:nth-child(5)').classList.add('active');
  document.getElementById('tab-sweep').classList.add('active');
}

// ── Render Sweep Plot ─────────────────────────────
function renderSweepPlot(results, varName) {
  const isSeasonSweep = varName === 'season';
  const x = results.map(r => r.var);
  const scores = results.map(r => r.score);
  const bonus  = results.map(r => parseFloat(r.launchBonus));

  const traces = [
    { type: isSeasonSweep ? 'bar' : 'scatter', mode: isSeasonSweep ? undefined : 'lines+markers',
      x, y: scores,
      ...(isSeasonSweep ? { marker:{color:scores.map(s => s>=70?'#B87333':s>=40?'#C9A24A':'#4A5568')} } : { line:{color:'#B87333',width:2}, marker:{size:4,color:'#C9A24A'} }),
      name:'Window Score', yaxis:'y', hovertemplate:'%{x}<br>Score: %{y}<extra></extra>' },
    { type:'scatter', mode:'lines', x, y: bonus,
      line:{color:'#4EC5C1',width:1.5,dash:'dot'}, name:'Launch Bonus (m/s)', yaxis:'y2' },
  ];
  const xLabel = {latitude:'Latitude (°)',azimuth:'Azimuth (°)',altitude:'Target Alt (km)',inclination:'Inclination (°)',wind:'Surface Wind (m/s)',season:'Season'}[varName] || varName;
  const layout = {
    ...LW_PLOTLY.layout, height:260,
    xaxis: { ...LW_PLOTLY.layout.xaxis, title:{text:xLabel,font:{size:9}} },
    yaxis: { ...LW_PLOTLY.layout.yaxis, title:{text:'Window Score',font:{size:9}}, range:[0,105] },
    yaxis2: { title:{text:'Launch Bonus (m/s)',font:{size:9},color:'#4EC5C1'}, overlaying:'y', side:'right', gridcolor:'transparent', tickfont:{size:9,color:'#4EC5C1'} },
    shapes: [{ type:'line', x0:isSeasonSweep?-0.5:results[0].var, x1:isSeasonSweep?3.5:results[results.length-1].var, y0:60, y1:60, line:{color:'#22c55e',width:1,dash:'dash'} }],
  };
  Plotly.react('lw-sweep-plot', traces, layout, LW_PLOTLY.config);
}

// ── Render Sweep Table ────────────────────────────
function renderSweepTable(results, varName) {
  const varLabel = {latitude:'Lat (°)',azimuth:'Az (°)',altitude:'Alt (km)',inclination:'Incl (°)',wind:'Wind (m/s)',season:'Season'}[varName] || varName;
  const head = document.getElementById('lw-sweep-thead');
  const body = document.getElementById('lw-sweep-tbody');
  if (!head || !body) return;
  head.innerHTML = `<tr>${['#',varLabel,'Score','GO?','Az Min','Az Max','Bonus (m/s)','Vc (km/s)','MaxQ (kPa)'].map(h=>`<th>${h}</th>`).join('')}</tr>`;
  body.innerHTML = results.map((r,i) => {
    const cls = r.score >= 70 ? 'val-good' : r.score >= 40 ? 'val-warn' : 'val-bad';
    return `<tr>
      <td>${i+1}</td>
      <td>${typeof r.var === 'number' ? r.var.toFixed(1) : r.var}</td>
      <td class="${cls}">${r.score}</td>
      <td class="${r.reachable ? 'val-good' : 'val-bad'}">${r.reachable ? 'YES' : 'NO'}</td>
      <td>${r.azMin}</td><td>${r.azMax}</td>
      <td>${r.launchBonus}</td><td>${r.circVel}</td><td>${r.maxQ}</td>
    </tr>`;
  }).join('');
}
</script>
<script>
// ── Export ────────────────────────────────────────
function lwExport(type) {
  if (!LW_STATE) { alert('Run calculation first.'); return; }
  const s = LW_STATE;
  let content = '', filename = '', mime = '';

  if (type === 'json') {
    content = JSON.stringify(s, null, 2);
    filename = 'romer-launch-windows.json'; mime = 'application/json';
  } else if (type === 'csv') {
    const hdr = 'hour_utc,go,score,wind_ms\n';
    const rows = s.windows.map(w => `${w.hour},${w.go},${w.score},${w.wind}`).join('\n');
    content = hdr + rows; filename = 'romer-launch-windows.csv'; mime = 'text/csv';
  } else if (type === 'txt') {
    content = [
      '═══════════════════════════════════════════',
      '  RÖMER INDUSTRIES / EMASSC',
      '  LAUNCH WINDOWS MANIFEST ',
      '═══════════════════════════════════════════',
      `  Site        : ${s.siteName}`,
      `  Lat/Lon     : ${s.lat.toFixed(3)}° / ${s.lon.toFixed(3)}°`,
      `  Target Incl : ${s.incl.toFixed(1)}°`,
      `  Target Alt  : ${(s.targetAlt/1000).toFixed(0)} km`,
      `  Season      : ${s.season}`,
      `  Window Score: ${s.score}/100 (GO threshold: 60)`,
      `  Az Range    : ${s.azRange ? s.azRange[0].toFixed(1)+'° / '+s.azRange[1].toFixed(1)+'°' : 'UNREACHABLE'}`,
      `  Launch Bonus: ${s.bonus.toFixed(1)} m/s`,
      `  Circ Vel    : ${(s.vc/1000).toFixed(3)} km/s`,
      `  Max Q (est) : ${s.maxQ.toFixed(2)} kPa`,
      '───────────────────────────────────────────',
      '  24H WINDOW SCHEDULE (UTC)',
      '───────────────────────────────────────────',
      ...s.windows.map(w => `  T+${String(w.hour).padStart(2,'0')}:00  ${w.go ? '[GO]   ' : '[NO-GO]'} Score:${String(w.score).padStart(3)} Wind:${w.wind} m/s`),
      '═══════════════════════════════════════════',
      `  Generated: ${s.timestamp}`,
      '═══════════════════════════════════════════',
    ].join('\n');
    filename = 'romer-launch-manifest.txt'; mime = 'text/plain';
  } else if (type === 'yaml') {
    content = [
      'romer_launch_windows:',
      `  version: 2.0.0`,
      `  site: "${s.siteName}"`,
      `  latitude: ${s.lat}`,
      `  longitude: ${s.lon}`,
      `  target_inclination_deg: ${s.incl}`,
      `  target_altitude_km: ${(s.targetAlt/1000).toFixed(0)}`,
      `  season: ${s.season}`,
      `  score: ${s.score}`,
      `  go_nogo: ${s.score >= 60 ? 'GO' : 'NO-GO'}`,
      `  azimuth_prograde: ${s.azRange ? s.azRange[0].toFixed(1) : 'null'}`,
      `  azimuth_retrograde: ${s.azRange ? s.azRange[1].toFixed(1) : 'null'}`,
      `  circular_velocity_kms: ${(s.vc/1000).toFixed(3)}`,
      `  launch_bonus_ms: ${s.bonus.toFixed(1)}`,
      `  max_q_kpa: ${s.maxQ.toFixed(2)}`,
      '  windows:',
      ...s.windows.map(w => `    - hour: ${w.hour}\n      go: ${w.go}\n      score: ${w.score}\n      wind_ms: ${w.wind}`),
    ].join('\n');
    filename = 'romer-launch-windows.yaml'; mime = 'text/yaml';
  } else if (type === 'gmat') {
    content = [
      '% ─────────────────────────────────────────',
      '% GMAT Script — Launch Windows',
      '% Römer Industries / EMASSC  ',
      `% Site: ${s.siteName}`,
      `% Generated: ${s.timestamp}`,
      '% ─────────────────────────────────────────',
      '',
      'Create Spacecraft SC;',
      `GMAT SC.SMA = ${((LW_CONST.RE + s.targetAlt)/1000).toFixed(3)};`,
      `GMAT SC.ECC = 0.001;`,
      `GMAT SC.INC = ${s.incl.toFixed(3)};`,
      `GMAT SC.RAAN = 0;`,
      `GMAT SC.AOP = 0;`,
      `GMAT SC.TA = 0;`,
      '',
      'Create ForceModel FM;',
      'GMAT FM.GravityField.Earth.Degree = 4;',
      'GMAT FM.GravityField.Earth.Order = 4;',
      '',
      'Create Propagator Prop;',
      'GMAT Prop.FM = FM;',
      '',
      '% Launch Site',
      `% Latitude: ${s.lat.toFixed(3)}°`,
      `% Longitude: ${s.lon.toFixed(3)}°`,
      `% Azimuth (prograde): ${s.azRange ? s.azRange[0].toFixed(1)+'°' : 'N/A'}`,
