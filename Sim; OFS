<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0"><title>OFS — Orbital Flight Simulator | Römer Industries</title>
<script src="https://cdn.plot.ly/plotly-2.27.0.min.js"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#0B0D10;--surface:#12151A;--surface2:#1A1E25;--surface3:#222831;
  --copper:#B87333;--gold:#C9A24A;--teal:#4EC5C1;--cyan:#00E5FF;
  --ivory:#F2F1EC;--muted:#8A8F9A;--border:#2A2F3A;
  --font-ui:'Inter',system-ui,sans-serif;--font-data:'JetBrains Mono',monospace;
}
html,body{background:var(--bg);color:var(--ivory);font-family:var(--font-ui);font-size:13px;height:100%;overflow-x:hidden}

/* OPS TRACKER */
.ops-tracker{display:flex;align-items:center;justify-content:space-between;padding:7px 14px;background:#0A0C0F;border-bottom:1px solid var(--border);flex-wrap:wrap;gap:6px;position:sticky;top:0;z-index:100}
.ops-beacon{display:flex;align-items:center;gap:8px}
.beacon-dot{width:8px;height:8px;border-radius:50%;background:var(--teal);box-shadow:0 0 6px var(--teal);animation:pulse 2s infinite}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:0.4}}
.ops-title{font-family:var(--font-data);font-size:11px;font-weight:700;color:var(--copper);letter-spacing:1.5px;text-transform:uppercase}
.ops-desc{font-family:var(--font-data);font-size:9px;color:var(--muted);letter-spacing:0.5px}
.ops-nav{display:flex;gap:4px;flex-wrap:wrap;align-items:center}
.nav-pill{font-family:var(--font-data);font-size:9px;font-weight:700;padding:3px 7px;border-radius:3px;border:1px solid var(--border);color:var(--muted);cursor:pointer;text-decoration:none;letter-spacing:0.8px;transition:all 0.2s;background:transparent}
.nav-pill:hover{border-color:var(--copper);color:var(--copper)}
.nav-pill.active{background:var(--copper);color:#0B0D10;border-color:var(--copper);font-weight:700}
.nav-pill.w-pill{border-color:#2A3040;color:#4A5060}
.nav-pill.w-pill:hover{border-color:var(--teal);color:var(--teal)}

/* BEACON BAR */
.beacon-bar{background:#090B0E;border-bottom:1px solid var(--border);padding:4px 14px;display:flex;align-items:center;gap:10px}
.beacon-live{font-family:var(--font-data);font-size:9px;color:var(--teal);font-weight:700;letter-spacing:1px}
.beacon-path{font-family:var(--font-data);font-size:9px;color:var(--muted)}
.beacon-sep{color:var(--border)}
.beacon-brand{font-family:var(--font-data);font-size:9px;color:var(--copper)}

/* HEADER */
.sim-header{padding:14px 18px 10px;border-bottom:1px solid var(--border);background:var(--surface)}
.sim-title{font-family:var(--font-ui);font-size:20px;font-weight:700;color:var(--copper);letter-spacing:0.5px;margin-bottom:3px}
.sim-desc{font-size:11px;color:var(--muted);margin-bottom:8px}
.sim-badges{display:flex;gap:6px;flex-wrap:wrap}
.badge{font-family:var(--font-data);font-size:9px;padding:2px 8px;border-radius:2px;border:1px solid var(--border);color:var(--muted)}
.badge.teal{border-color:var(--teal);color:var(--teal)}
.badge.copper{border-color:var(--copper);color:var(--copper)}
.badge.gold{border-color:var(--gold);color:var(--gold)}

/* MAIN LAYOUT */
.sim-body{display:grid;grid-template-columns:260px 1fr;height:calc(100vh - 120px);min-height:600px}
.sim-controls{background:var(--surface);border-right:1px solid var(--border);overflow-y:auto;padding:0}
.sim-main{display:flex;flex-direction:column;overflow:hidden;background:var(--bg)}

/* CONTROL PANEL */
.ctrl-section{border-bottom:1px solid var(--border);padding:12px 14px}
.ctrl-label{font-family:var(--font-data);font-size:9px;font-weight:700;color:var(--copper);letter-spacing:1.2px;text-transform:uppercase;margin-bottom:8px;display:flex;align-items:center;gap:6px}
.ctrl-row{margin-bottom:8px}
.ctrl-row label{display:block;font-size:10px;color:var(--muted);margin-bottom:3px;font-family:var(--font-data)}
.ctrl-row input[type=number],.ctrl-row select{width:100%;background:var(--surface2);border:1px solid var(--border);color:var(--ivory);padding:5px 8px;border-radius:3px;font-family:var(--font-data);font-size:11px}
.ctrl-row input[type=number]:focus,.ctrl-row select:focus{outline:none;border-color:var(--copper)}
.ctrl-row select option{background:var(--surface2)}
.range-wrap{display:flex;align-items:center;gap:8px}
.ctrl-row input[type=range]{flex:1;accent-color:var(--copper);height:3px}
.range-val{font-family:var(--font-data);font-size:10px;color:var(--gold);min-width:40px;text-align:right}
.ctrl-2col{display:grid;grid-template-columns:1fr 1fr;gap:6px}

/* TELEMETRY READOUTS */
.telem-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--border);border-bottom:1px solid var(--border)}
.telem-cell{background:var(--surface2);padding:8px 10px}
.telem-label{font-family:var(--font-data);font-size:8px;color:var(--muted);letter-spacing:0.8px;text-transform:uppercase;margin-bottom:2px}
.telem-val{font-family:var(--font-data);font-size:18px;font-weight:700;color:var(--teal);line-height:1}
.telem-unit{font-family:var(--font-data);font-size:9px;color:var(--muted)}
.telem-cell.warning .telem-val{color:var(--gold)}
.telem-cell.critical .telem-val{color:#FF4444}

/* TABS */
.tab-bar{display:flex;background:var(--surface);border-bottom:1px solid var(--border);padding:0 14px}
.tab-btn{font-family:var(--font-data);font-size:10px;font-weight:600;padding:9px 14px;cursor:pointer;border:none;background:transparent;color:var(--muted);letter-spacing:0.8px;border-bottom:2px solid transparent;transition:all 0.2s}
.tab-btn:hover{color:var(--ivory)}
.tab-btn.active{color:var(--copper);border-bottom-color:var(--copper)}
.tab-content{flex:1;overflow:hidden;position:relative}
.tab-pane{display:none;height:100%;overflow:auto}
.tab-pane.active{display:flex;flex-direction:column}

/* PLOT AREA */
.plot-container{flex:1;min-height:400px;position:relative}
.plot-controls{display:flex;align-items:center;gap:8px;padding:8px 12px;background:var(--surface);border-bottom:1px solid var(--border);flex-wrap:wrap}
.plot-controls span{font-family:var(--font-data);font-size:9px;color:var(--muted);letter-spacing:0.8px}
.plot-controls select{background:var(--surface2);border:1px solid var(--border);color:var(--ivory);padding:3px 8px;border-radius:3px;font-family:var(--font-data);font-size:10px}

/* BUTTONS */
.btn{font-family:var(--font-data);font-size:10px;font-weight:700;padding:6px 14px;border-radius:3px;border:none;cursor:pointer;letter-spacing:0.8px;transition:all 0.2s}
.btn-primary{background:var(--copper);color:#0B0D10}
.btn-primary:hover{background:var(--gold)}
.btn-secondary{background:transparent;border:1px solid var(--border);color:var(--muted)}
.btn-secondary:hover{border-color:var(--teal);color:var(--teal)}
.btn-teal{background:var(--teal);color:#0B0D10}
.btn-teal:hover{background:#3DB5B1}
.btn-danger{background:transparent;border:1px solid #FF4444;color:#FF4444}
.btn-danger:hover{background:#FF4444;color:#fff}
.btn-sm{padding:4px 10px;font-size:9px}
.btn-row{display:flex;gap:6px;flex-wrap:wrap;padding:8px 14px}

/* PLAYBACK BAR */
.playback-bar{display:flex;align-items:center;gap:10px;padding:8px 12px;background:var(--surface2);border-bottom:1px solid var(--border)}
.playback-bar .btn{min-width:36px}
.time-display{font-family:var(--font-data);font-size:12px;color:var(--teal);min-width:80px}
.speed-label{font-family:var(--font-data);font-size:9px;color:var(--muted)}
.progress-track{flex:1;height:4px;background:var(--border);border-radius:2px;cursor:pointer;position:relative}
.progress-fill{height:100%;background:var(--copper);border-radius:2px;transition:width 0.1s}

/* SWEEP & EXPORT */
.sweep-grid{display:grid;grid-template-columns:280px 1fr;gap:0;height:100%}
.sweep-config{padding:14px;border-right:1px solid var(--border);overflow-y:auto}
.sweep-results{display:flex;flex-direction:column;overflow:hidden}
.export-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;padding:14px}
.export-card{background:var(--surface2);border:1px solid var(--border);border-radius:4px;padding:12px}
.export-card h4{font-family:var(--font-data);font-size:10px;color:var(--copper);letter-spacing:1px;margin-bottom:6px}
.export-card p{font-size:10px;color:var(--muted);margin-bottom:10px;line-height:1.5}

/* DATASPACE */
.ds-panel{padding:12px 14px;border-top:1px solid var(--border);background:var(--surface)}
.ds-title{font-family:var(--font-data);font-size:9px;color:var(--teal);letter-spacing:1px;margin-bottom:8px;font-weight:700}
.ds-btns{display:flex;gap:4px;flex-wrap:wrap}
.ds-btn{font-family:var(--font-data);font-size:9px;font-weight:700;padding:4px 10px;border-radius:3px;background:var(--surface3);border:1px solid var(--border);color:var(--muted);cursor:pointer;transition:all 0.2s}
.ds-btn:hover{border-color:var(--teal);color:var(--teal)}
.ds-btn.all{border-color:var(--copper);color:var(--copper)}
.ds-btn.all:hover{background:var(--copper);color:#0B0D10}
.ds-status{font-family:var(--font-data);font-size:9px;color:var(--gold);margin-top:6px;min-height:14px}

/* RV TABLE */
.data-table{width:100%;border-collapse:collapse;font-family:var(--font-data);font-size:10px}
.data-table th{background:var(--surface3);color:var(--copper);padding:6px 10px;text-align:left;font-size:9px;letter-spacing:0.8px;border-bottom:1px solid var(--border)}
.data-table td{padding:5px 10px;border-bottom:1px solid var(--border);color:var(--ivory)}
.data-table tr:hover td{background:var(--surface2)}
.table-wrap{overflow-x:auto;flex:1}
.results-summary{padding:10px 14px;background:var(--surface2);border-bottom:1px solid var(--border);display:flex;gap:16px;flex-wrap:wrap}
.rs-item{display:flex;flex-direction:column;gap:2px}
.rs-label{font-family:var(--font-data);font-size:8px;color:var(--muted);letter-spacing:0.8px}
.rs-val{font-family:var(--font-data);font-size:13px;color:var(--teal);font-weight:700}

/* MESSAGES */
.msg-box{margin:10px 14px;padding:8px 12px;border-radius:3px;font-family:var(--font-data);font-size:10px;border-left:3px solid var(--teal);background:rgba(78,197,193,0.07);color:var(--teal)}
.msg-box.warn{border-color:var(--gold);background:rgba(201,162,74,0.07);color:var(--gold)}
.msg-box.err{border-color:#FF4444;background:rgba(255,68,68,0.07);color:#FF4444}

/* SECTION LABELS */
.section-hdr{font-family:var(--font-data);font-size:9px;font-weight:700;color:var(--copper);letter-spacing:1.2px;text-transform:uppercase;padding:10px 14px 4px;border-top:1px solid var(--border);margin-top:4px}
</style></head><body>
<!-- OPS TRACKER -->
<div class="ops-tracker">
  <div class="ops-beacon">
    <div class="beacon-dot"></div>
    <div>
      <div class="ops-title">RFS EXTRACTION — RENDEZVOUS &amp; FLIGHT SIMULATOR</div>
      <div class="ops-desc">3D orbital rendezvous · CW proximity ops · Hohmann transfer · Plotly 3D · /sims/rfs-extraction</div>
    </div>
  </div>
  <div class="ops-nav">
    <a class="nav-pill calc" href="/calc/orbital">ORB</a>
    <a class="nav-pill calc" href="/calc/launch">LW</a>
    <a class="nav-pill calc" href="/calc/magnetostatics">MAG</a>
    <a class="nav-pill calc" href="/calc/energy">PWR</a>
    <a class="nav-pill calc" href="/calc/fluids">FLD</a>
    <a class="nav-pill sim active" href="/sims/rfs-extraction">RFS</a>
    <a class="nav-pill sim" href="/sim/node">EMFF</a>
    <a class="nav-pill sim" href="/sim/fields">EMF</a>
    <a class="nav-pill sim" href="/sim/re-entry">ENTRY</a>
    <a class="nav-pill w1" href="/w1/data">W1</a>
    <a class="nav-pill w2" href="/w2/data">W2</a>
    <a class="nav-pill w3" href="/w3/data">W3</a>
    <a class="nav-pill w4" href="/w4/data">W4</a>
    <a class="nav-pill w5" href="/w5/data">W5</a>
    <a class="nav-pill w6" href="/w6/data">W6</a>
    <a class="nav-pill util" href="/data/achilles">ACH</a>
    <a class="nav-pill util" href="/library">LIB</a>
    <a class="nav-pill util" href="/gmat">GMAT</a>
    <a class="nav-pill util" href="/dash">DASH</a>
  </div>
</div>

<!-- BEACON BAR -->
<div class="beacon-bar">
  <span class="beacon-live">● LIVE</span>
  <span class="beacon-path">/sims/rfs-extraction</span>
  <span class="beacon-sep">·</span>
  <span class="beacon-path">Universal — callable by all workspaces &amp; dataspaces</span>
  <span class="beacon-sep">·</span>
  <span class="beacon-brand">Römer Industries / EMASSC</span>
  <span class="beacon-sep">·</span>
  <span class="beacon-path" id="rfs-beacon-ts" style="font-size:9px;color:var(--muted)"></span>
</div>

<!-- HEADER -->
<div class="sim-header">
  <div class="sim-title">RFS Extraction — Rendezvous &amp; Flight Simulator</div>
  <div class="sim-desc">3D orbital rendezvous simulation · Hill-Clohessy-Wiltshire proximity ops · Hohmann/bi-elliptic transfer · Keplerian propagation with J2 perturbation</div>
  <div class="sim-badges">
    <span class="badge teal"></span>
    <span class="badge">SI Units</span>
    <span class="badge copper">Universal Tool — W1–W6 Callable</span>
    <span class="badge teal">Plotly 3D Visualisation</span>
    <span class="badge gold">Animated Playback</span>
    <span class="badge">JetBrains Mono · Inter</span>
  </div>
</div>

<!-- TELEMETRY BAR -->
<div class="telem-grid">
  <div class="telem-cell" id="telem-alt">
    <div class="telem-label">ALTITUDE</div>
    <div class="telem-val" id="tv-alt">400</div>
    <div class="telem-unit">km</div>
  </div>
  <div class="telem-cell" id="telem-vel">
    <div class="telem-label">ORBITAL VELOCITY</div>
    <div class="telem-val" id="tv-vel">7.67</div>
    <div class="telem-unit">km/s</div>
  </div>
  <div class="telem-cell warning" id="telem-dv">
    <div class="telem-label">ΔV BUDGET</div>
    <div class="telem-val" id="tv-dv">0.00</div>
    <div class="telem-unit">km/s</div>
  </div>
  <div class="telem-cell" id="telem-range">
    <div class="telem-label">RANGE TO TARGET</div>
    <div class="telem-val" id="tv-range">—</div>
    <div class="telem-unit">km</div>
  </div>
  <div class="telem-cell" id="telem-inc">
    <div class="telem-label">INCLINATION</div>
    <div class="telem-val" id="tv-inc">28.5</div>
    <div class="telem-unit">deg</div>
  </div>
  <div class="telem-cell" id="telem-period">
    <div class="telem-label">ORBITAL PERIOD</div>
    <div class="telem-val" id="tv-period">92.1</div>
    <div class="telem-unit">min</div>
  </div>
  <div class="telem-cell" id="telem-phase">
    <div class="telem-label">PHASE ANGLE</div>
    <div class="telem-val" id="tv-phase">0.0</div>
    <div class="telem-unit">deg</div>
  </div>
  <div class="telem-cell" id="telem-time">
    <div class="telem-label">SIM TIME</div>
    <div class="telem-val" id="tv-time">T+00:00</div>
    <div class="telem-unit">hh:mm</div>
  </div>
</div>

<!-- MAIN BODY -->
<div class="sim-body">
  <!-- CONTROL PANEL -->
  <div class="sim-controls">
    <div class="ctrl-section">
      <div class="ctrl-label">⚙ ORBIT PARAMETERS</div>
      <div class="ctrl-row">
        <label>Target Altitude (km)</label>
        <input type="number" id="p-alt" value="400" min="200" max="2000" step="10">
      </div>
      <div class="ctrl-row">
        <label>Inclination (°)</label>
        <input type="number" id="p-inc" value="28.5" min="0" max="98" step="0.1">
      </div>
      <div class="ctrl-row">
        <label>RAAN (°)</label>
        <input type="number" id="p-raan" value="0" min="0" max="360" step="1">
      </div>
      <div class="ctrl-row">
        <label>Eccentricity</label>
        <input type="number" id="p-ecc" value="0" min="0" max="0.9" step="0.001">
      </div>
    </div>
    <div class="ctrl-section">
      <div class="ctrl-label">🚀 CHASER VEHICLE</div>
      <div class="ctrl-row">
        <label>Chaser Mass (kg)</label>
        <input type="number" id="p-mass" value="1000" min="50" max="50000" step="50">
      </div>
      <div class="ctrl-row">
        <label>Thrust (N)</label>
        <input type="number" id="p-thrust" value="0.5" min="0.001" max="500" step="0.1">
      </div>
      <div class="ctrl-row">
        <label>Isp (s)</label>
        <input type="number" id="p-isp" value="450" min="100" max="5000" step="10">
      </div>
      <div class="ctrl-row">
        <label>Propellant Mass (kg)</label>
        <input type="number" id="p-prop" value="100" min="1" max="10000" step="1">
      </div>
    </div>
    <div class="ctrl-section">
      <div class="ctrl-label">🎯 RENDEZVOUS CONFIG</div>
      <div class="ctrl-row">
        <label>Initial Range to Target (km)</label>
        <input type="number" id="p-range0" value="50" min="1" max="1000" step="1">
      </div>
      <div class="ctrl-row">
        <label>Maneuver Type</label>
        <select id="p-maneuver">
          <option value="hohmann">Hohmann Transfer</option>
          <option value="bielliptic">Bi-Elliptic Transfer</option>
          <option value="cw">CW Proximity Ops</option>
          <option value="direct">Direct Intercept</option>
        </select>
      </div>
      <div class="ctrl-row">
        <label>Phase Drift Mode</label>
        <select id="p-phase">
          <option value="passive">Passive Drift</option>
          <option value="active">Active Phasing</option>
          <option value="hold">Station Keep</option>
        </select>
      </div>
    </div>
    <div class="ctrl-section">
      <div class="ctrl-label">▶ PLAYBACK</div>
      <div class="ctrl-row">
        <label>Time Step (s)</label>
        <div class="range-wrap">
          <input type="range" id="p-dt" min="1" max="300" value="10" step="1" oninput="document.getElementById('v-dt').textContent=this.value+'s'">
          <span class="range-val" id="v-dt">10s</span>
        </div>
      </div>
      <div class="ctrl-row">
        <label>Sim Speed</label>
        <select id="p-speed">
          <option value="1">1× Real Time</option>
          <option value="10">10× Speed</option>
          <option value="100" selected>100× Speed</option>
          <option value="500">500× Speed</option>
          <option value="1000">1000× Speed</option>
        </select>
      </div>
      <div class="ctrl-row">
        <label>Duration (orbits)</label>
        <input type="number" id="p-orbits" value="3" min="0.5" max="20" step="0.5">
      </div>
    </div>
    <div class="ctrl-section">
      <div class="ctrl-label">⚡ J2 PERTURBATIONS</div>
      <div class="ctrl-row" style="display:flex;align-items:center;justify-content:space-between">
        <label style="margin:0">Enable J2</label>
        <input type="checkbox" id="p-j2" checked style="accent-color:var(--copper);width:16px;height:16px">
      </div>
      <div class="ctrl-row" style="display:flex;align-items:center;justify-content:space-between;margin-top:6px">
        <label style="margin:0">Show Field Lines</label>
        <input type="checkbox" id="p-fieldlines" checked style="accent-color:var(--copper);width:16px;height:16px">
      </div>
    </div>
    <div class="btn-row">
      <button class="btn btn-primary" onclick="window.rfs.compute()">COMPUTE</button>
      <button class="btn btn-teal" onclick="window.rfs.run()" id="btn-run">▶ RUN SIM</button>
      <button class="btn btn-secondary btn-sm" onclick="window.rfs.reset()">RESET</button>
    </div>
    <!-- DATASPACE -->
    <div class="ds-panel">
      <div class="ds-title">⬡ ROUTE TO DATASPACE</div>
      <div class="ds-btns">
        <button class="ds-btn" onclick="window.rfs.sendDS('w1')">W1</button>
        <button class="ds-btn" onclick="window.rfs.sendDS('w2')">W2</button>
        <button class="ds-btn" onclick="window.rfs.sendDS('w3')">W3</button>
        <button class="ds-btn" onclick="window.rfs.sendDS('w4')">W4</button>
        <button class="ds-btn" onclick="window.rfs.sendDS('w5')">W5</button>
        <button class="ds-btn" onclick="window.rfs.sendDS('w6')">W6</button>
        <button class="ds-btn all" onclick="window.rfs.sendDS('all')">ALL</button>
      </div>
      <div class="ds-status" id="ds-status"></div>
    </div>
  </div>

  <!-- MAIN PANEL -->
  <div class="sim-main">
    <!-- TAB BAR -->
    <div class="tab-bar">
      <button class="tab-btn active" onclick="window.rfs.tab('3d')">3D ORBIT</button>
