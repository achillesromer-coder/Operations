  <script>
    const surfaces = [
      { id:'LS-OPS-HOME', kind:'control', title:'Operations Home', route:'/operations/home', state:'review', label:'Review', boundary:'Public operations index only', accent:'#c07a3d' },
      { id:'LS-W1-MAGLEV', kind:'workspace', title:'Incoming Deposit Analysis', route:'/operations/w1', state:'review', label:'Review', boundary:'Candidate screening only', accent:'#36bfd2' },
      { id:'LS-W2-LUKE2', kind:'workspace', title:'Geostationary Luke II', route:'/operations/w2', state:'review', label:'Review', boundary:'Engineering prototype only', accent:'#38c98b' },
      { id:'LS-W3-RFS-EMFF', kind:'workspace', title:'RFS and EMFF Field Projections', route:'/operations/w3', state:'review', label:'Review', boundary:'Hypothesis and test design only', accent:'#d9657d' },
      { id:'LS-W4-SUPPLY', kind:'workspace', title:'Inter-planetary Supply Chain Network', route:'/operations/w4', state:'review', label:'Review', boundary:'Planning prototype only', accent:'#e1a23b' },
      { id:'LS-W5-MISSION', kind:'workspace', title:'Mission Planning', route:'/operations/w5', state:'review', label:'Review', boundary:'Planning prototype only', accent:'#38c98b' },
      { id:'LS-W6-ASSETS', kind:'workspace', title:'Asset Library', route:'/operations/w6', state:'review', label:'Review', boundary:'Source-candidate inventory only', accent:'#d9657d' },
      { id:'LS-W7-DECENTRALIZED', kind:'workspace', title:'Decentralized', route:'/operations/w7', state:'gated', label:'Gated', boundary:'Coming soon', accent:'#d9657d' },
      { id:'LS-CALC-ENERGY', kind:'calculator', title:'Energy and Power Calculator', route:'/calc/energy', state:'review', label:'Review', boundary:'Engineering analysis prototype', accent:'#e1a23b' },
      { id:'LS-CALC-FLUIDS', kind:'calculator', title:'Fluid Dynamics Calculator', route:'/calc/fluids', state:'review', label:'Review', boundary:'Engineering analysis prototype', accent:'#36bfd2' },
      { id:'LS-CALC-LAUNCH', kind:'calculator', title:'Launch Windows Calculator', route:'/calc/launch', state:'review', label:'Review', boundary:'Engineering analysis prototype', accent:'#c07a3d' },
      { id:'LS-CALC-MAGNETOSTATICS', kind:'calculator', title:'Magnetostatics Calculator', route:'/calc/magnetostatics', state:'review', label:'Review', boundary:'Engineering analysis prototype', accent:'#d9657d' },
      { id:'LS-CALC-ORBITAL', kind:'calculator', title:'Orbital Mechanics Calculator', route:'/calc/orbital', state:'review', label:'Review', boundary:'Engineering analysis prototype', accent:'#38c98b' },
      { id:'LS-SIM-REENTRY', kind:'simulator', title:'Re-entry Atmospheric Entry Simulator', route:'/sim/re-entry', state:'review', label:'Review', boundary:'Engineering analysis prototype', accent:'#e1a23b' },
      { id:'LS-SIM-FIELDS', kind:'simulator', title:'Electromagnetic Field Simulator', route:'/sim/fields', state:'review', label:'Review', boundary:'Hypothesis and test design only', accent:'#d9657d' },
      { id:'LS-SIM-NODE', kind:'simulator', title:'Electromagnetic Formation Flight', route:'/sim/node', state:'review', label:'Review', boundary:'Hypothesis and test design only', accent:'#36bfd2' },
      { id:'LS-SIM-RFS-EXTRACTION', kind:'simulator', title:'RFS Extraction Rendezvous and Flight', route:'/sims/rfs-extraction', state:'review', label:'Review', boundary:'Hypothesis and test design only', accent:'#c07a3d' },
      { id:'LS-ACHILLES', kind:'reference', title:'Achilles Status', route:'/data/achilles', state:'protected', label:'Protected', boundary:'Authenticated operator only', accent:'#36bfd2' },
      { id:'LS-LIBRARY', kind:'reference', title:'Source Library', route:'/library', state:'reference', label:'Reference', boundary:'Reference only', accent:'#38c98b' },
      { id:'LS-OPS-GMAT', kind:'reference', title:'GMAT', route:'/gmat', state:'reference', label:'Reference', boundary:'Separate license and release surface', accent:'#c07a3d' },
      { id:'LS-OPS-CONTACT', kind:'reference', title:'Contact and Support Intake', route:'/contact-us', state:'reference', label:'Reference', boundary:'Separate form surface', accent:'#38c98b' }
    ];

    const grid = document.getElementById('surfaceGrid');
    const count = document.getElementById('surfaceCount');
    const search = document.getElementById('surfaceSearch');
    const sidebar = document.getElementById('sidebar');
    const menuButton = document.getElementById('menuButton');
    let activeFilter = 'all';

    function kindLabel(kind) {
      return ({ control:'Control', workspace:'Workspace', calculator:'Calculator', simulator:'Simulator', reference:'Reference' })[kind] || kind;
    }

    function renderSurfaces() {
      const query = search.value.trim().toLowerCase();
      const filtered = surfaces.filter(surface => {
        const categoryMatch = activeFilter === 'all' || surface.kind === activeFilter || (activeFilter === 'workspace' && surface.kind === 'control');
        const queryMatch = !query || `${surface.id} ${surface.title} ${surface.route} ${surface.boundary}`.toLowerCase().includes(query);
        return categoryMatch && queryMatch;
      });

      count.textContent = `${filtered.length} of ${surfaces.length} registry surfaces`;
      if (!filtered.length) {
        grid.innerHTML = '<div class="empty-state">No matching surface</div>';
        return;
      }

      grid.innerHTML = filtered.map(surface => `
        <article class="surface-card" style="--card-accent:${surface.accent}" data-surface="${surface.id}">
          <div class="card-accent"></div>
          <div class="card-body">
            <div class="card-meta">
              <span class="card-kind">${kindLabel(surface.kind)}</span>
              <span class="state-badge ${surface.state}">${surface.label}</span>
            </div>
            <h3>${surface.title}</h3>
            <div class="card-boundary">${surface.boundary}</div>
          </div>
          <div class="card-footer">
            <span class="card-route">${surface.route}</span>
            <a class="open-link" href="${surface.route}">Open <i data-lucide="arrow-up-right"></i></a>
          </div>
        </article>
      `).join('');
      if (window.lucide) window.lucide.createIcons();
    }

    function setFilter(filter) {
      activeFilter = filter;
      document.querySelectorAll('[data-filter]').forEach(button => {
        button.classList.toggle('active', button.dataset.filter === filter);
      });
      renderSurfaces();
      document.getElementById('surfaces').scrollIntoView({ block: 'start' });
      sidebar.classList.remove('open');
    }

    document.querySelectorAll('[data-filter]').forEach(button => {
      button.addEventListener('click', () => setFilter(button.dataset.filter));
    });
    search.addEventListener('input', renderSurfaces);
    menuButton.addEventListener('click', () => sidebar.classList.toggle('open'));
    document.addEventListener('keydown', event => {
      if (event.key === 'Escape') sidebar.classList.remove('open');
    });

    const clock = document.getElementById('utcClock');
    function updateClock() {
      const value = new Date().toISOString().slice(11, 19);
      clock.textContent = `UTC ${value}`;
    }
    updateClock();
    setInterval(updateClock, 1000);

    const canvas = document.getElementById('topologyCanvas');
    const ctx = canvas.getContext('2d');
    let nodes = [];
    let motionFrame = 0;

    const topology = [
      { id:'LS-OPS-HOME', label:'OPS', x:0.50, y:0.50, color:'#c07a3d', r:22 },
      { id:'LS-W1-MAGLEV', label:'W1', x:0.17, y:0.28, color:'#36bfd2', r:16 },
      { id:'LS-W2-LUKE2', label:'W2', x:0.34, y:0.18, color:'#38c98b', r:16 },
      { id:'LS-W3-RFS-EMFF', label:'W3', x:0.66, y:0.18, color:'#d9657d', r:16 },
      { id:'LS-W4-SUPPLY', label:'W4', x:0.83, y:0.31, color:'#e1a23b', r:16 },
      { id:'LS-W5-MISSION', label:'W5', x:0.76, y:0.72, color:'#38c98b', r:16 },
      { id:'LS-W6-ASSETS', label:'W6', x:0.24, y:0.74, color:'#d9657d', r:16 },
      { id:'LS-W7-DECENTRALIZED', label:'W7', x:0.50, y:0.84, color:'#6f7a84', r:13 },
      { id:'TOOLS', label:'TOOLS', x:0.89, y:0.62, color:'#36bfd2', r:12 },
      { id:'DATA', label:'DATA', x:0.10, y:0.56, color:'#46515d', r:12 }
    ];

    const links = [
      ['LS-OPS-HOME','LS-W1-MAGLEV'], ['LS-OPS-HOME','LS-W2-LUKE2'], ['LS-OPS-HOME','LS-W3-RFS-EMFF'],
      ['LS-OPS-HOME','LS-W4-SUPPLY'], ['LS-OPS-HOME','LS-W5-MISSION'], ['LS-OPS-HOME','LS-W6-ASSETS'],
      ['LS-OPS-HOME','LS-W7-DECENTRALIZED'], ['LS-OPS-HOME','TOOLS'], ['LS-OPS-HOME','DATA'],
      ['LS-W1-MAGLEV','LS-W2-LUKE2'], ['LS-W2-LUKE2','LS-W3-RFS-EMFF'], ['LS-W3-RFS-EMFF','LS-W4-SUPPLY'],
      ['LS-W4-SUPPLY','LS-W5-MISSION'], ['LS-W5-MISSION','LS-W6-ASSETS'], ['LS-W6-ASSETS','LS-W1-MAGLEV']
    ];

    function resizeCanvas() {
      const ratio = Math.min(window.devicePixelRatio || 1, 2);
      const rect = canvas.getBoundingClientRect();
      canvas.width = Math.max(1, Math.floor(rect.width * ratio));
      canvas.height = Math.max(1, Math.floor(rect.height * ratio));
      ctx.setTransform(ratio, 0, 0, ratio, 0, 0);
      nodes = topology.map(node => ({ ...node, px: node.x * rect.width, py: node.y * rect.height }));
      drawTopology();
    }

    function drawTopology() {
      const rect = canvas.getBoundingClientRect();
      ctx.clearRect(0, 0, rect.width, rect.height);
      ctx.fillStyle = '#0a0d10';
      ctx.fillRect(0, 0, rect.width, rect.height);

      ctx.strokeStyle = '#182028';
      ctx.lineWidth = 1;
      for (let x = 0; x < rect.width; x += 40) {
        ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, rect.height); ctx.stroke();
      }
      for (let y = 0; y < rect.height; y += 40) {
        ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(rect.width, y); ctx.stroke();
      }

      links.forEach(([fromId, toId]) => {
        const from = nodes.find(node => node.id === fromId);
        const to = nodes.find(node => node.id === toId);
        if (!from || !to) return;
        ctx.beginPath();
        ctx.moveTo(from.px, from.py);
        ctx.lineTo(to.px, to.py);
        ctx.strokeStyle = fromId === 'LS-OPS-HOME' ? 'rgba(192,122,61,0.34)' : 'rgba(70,81,93,0.38)';
        ctx.lineWidth = fromId === 'LS-OPS-HOME' ? 1.4 : 1;
        ctx.stroke();
      });

      nodes.forEach((node, index) => {
        const pulse = node.id === 'LS-OPS-HOME' ? 3 + Math.sin((motionFrame + index * 8) / 28) * 2 : 0;
        if (pulse) {
          ctx.beginPath();
          ctx.arc(node.px, node.py, node.r + pulse + 5, 0, Math.PI * 2);
          ctx.strokeStyle = 'rgba(192,122,61,0.22)';
          ctx.lineWidth = 1;
          ctx.stroke();
        }
        ctx.beginPath();
        ctx.arc(node.px, node.py, node.r, 0, Math.PI * 2);
        ctx.fillStyle = '#11161b';
        ctx.fill();
        ctx.strokeStyle = node.color;
        ctx.lineWidth = 1.5;
        ctx.stroke();
        ctx.fillStyle = node.color;
        ctx.font = '700 10px Inter, Segoe UI, sans-serif';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText(node.label, node.px, node.py);
      });
    }

    function animateTopology() {
      motionFrame += 1;
      drawTopology();
      requestAnimationFrame(animateTopology);
    }

    canvas.addEventListener('click', event => {
      const rect = canvas.getBoundingClientRect();
      const x = event.clientX - rect.left;
      const y = event.clientY - rect.top;
      const hit = nodes.find(node => Math.hypot(node.px - x, node.py - y) <= node.r + 8);
      if (!hit || hit.id === 'TOOLS' || hit.id === 'DATA') return;
      const surface = surfaces.find(item => item.id === hit.id);
      if (surface) window.location.href = surface.route;
    });

    window.addEventListener('resize', resizeCanvas);
    window.addEventListener('load', () => {
      if (window.lucide) window.lucide.createIcons();
      renderSurfaces();
      resizeCanvas();
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) drawTopology();
      else animateTopology();
    });
  </script>
