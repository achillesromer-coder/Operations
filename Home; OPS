<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="color-scheme" content="dark">
  <title>Operations Control Plane | Romer Industries</title>
  <script src="https://unpkg.com/lucide@0.468.0/dist/umd/lucide.min.js" defer></script>
  <style>
    :root {
      --bg: #080a0d;
      --surface: #101419;
      --surface-raised: #171c22;
      --surface-soft: #1c2229;
      --line: #2d353e;
      --line-strong: #46515d;
      --text: #edf1f4;
      --muted: #9aa5af;
      --quiet: #6f7a84;
      --copper: #c07a3d;
      --cyan: #36bfd2;
      --green: #38c98b;
      --amber: #e1a23b;
      --rose: #d9657d;
      --danger: #df6962;
      --focus: #f1bd70;
      --sidebar: 248px;
      --topbar: 58px;
    }

    * {
      box-sizing: border-box;
      letter-spacing: 0;
    }

    html {
      background: var(--bg);
      color: var(--text);
      font-family: Inter, "Segoe UI", Arial, sans-serif;
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      min-width: 320px;
      min-height: 100vh;
      background: var(--bg);
    }

    button,
    input,
    a {
      font: inherit;
    }

    button,
    a {
      -webkit-tap-highlight-color: transparent;
    }

    button:focus-visible,
    input:focus-visible,
    a:focus-visible {
      outline: 2px solid var(--focus);
      outline-offset: 2px;
    }

    a {
      color: inherit;
    }

    .app-shell {
      display: grid;
      grid-template-columns: var(--sidebar) minmax(0, 1fr);
      min-height: 100vh;
    }

    .sidebar {
      position: sticky;
      top: 0;
      height: 100vh;
      display: flex;
      flex-direction: column;
      background: #0c0f13;
      border-right: 1px solid var(--line);
      overflow: hidden;
      z-index: 20;
    }

    .brand {
      min-height: 78px;
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 14px 18px;
      border-bottom: 1px solid var(--line);
      text-decoration: none;
    }

    .brand-mark {
      width: 34px;
      height: 34px;
      display: grid;
      place-items: center;
      border: 1px solid var(--copper);
      color: var(--copper);
      font-weight: 800;
      font-size: 14px;
      flex: 0 0 auto;
    }

    .brand-name {
      min-width: 0;
    }

    .brand-name strong {
      display: block;
      font-size: 13px;
      line-height: 1.2;
    }

    .brand-name span {
      display: block;
      color: var(--muted);
      font-size: 11px;
      margin-top: 3px;
    }

    .side-state {
      padding: 14px 18px;
      border-bottom: 1px solid var(--line);
    }

    .state-line {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 8px;
      font-size: 11px;
    }

    .state-line:last-child {
      margin-bottom: 0;
    }

    .state-line span:first-child {
      color: var(--muted);
    }

    .state-value {
      color: var(--text);
      font-weight: 700;
      text-align: right;
    }

    .state-value.review {
      color: var(--amber);
    }

    .side-nav {
      flex: 1;
      overflow-y: auto;
      padding: 12px 10px;
    }

    .nav-label {
      color: var(--quiet);
      font-size: 10px;
      font-weight: 700;
      padding: 10px 10px 7px;
      text-transform: uppercase;
    }

    .nav-button,
    .nav-link {
      width: 100%;
      height: 40px;
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 0 10px;
      border: 1px solid transparent;
      border-radius: 5px;
      background: transparent;
      color: var(--muted);
      text-decoration: none;
      cursor: pointer;
      font-size: 12px;
      text-align: left;
    }

    .nav-button:hover,
    .nav-link:hover {
      color: var(--text);
      background: var(--surface);
    }

    .nav-button.active {
      color: var(--text);
      border-color: var(--line-strong);
      background: var(--surface-raised);
    }

    .nav-button svg,
    .nav-link svg {
      width: 16px;
      height: 16px;
      flex: 0 0 auto;
    }

    .side-footer {
      padding: 14px 18px;
      border-top: 1px solid var(--line);
      color: var(--quiet);
      font-size: 10px;
      line-height: 1.5;
    }

    .main {
      min-width: 0;
    }

    .topbar {
      position: sticky;
      top: 0;
      height: var(--topbar);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      padding: 0 24px;
      background: rgba(8, 10, 13, 0.96);
      border-bottom: 1px solid var(--line);
      z-index: 15;
      backdrop-filter: blur(10px);
    }

    .topbar-title {
      min-width: 0;
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 12px;
      font-weight: 700;
    }

    .topbar-title span {
      color: var(--quiet);
      font-weight: 500;
    }

    .topbar-actions {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .utc {
      color: var(--muted);
      font-variant-numeric: tabular-nums;
      font-size: 11px;
      white-space: nowrap;
    }

    .icon-button {
      width: 34px;
      height: 34px;
      display: grid;
      place-items: center;
      border: 1px solid var(--line);
      border-radius: 5px;
      background: var(--surface);
      color: var(--muted);
      cursor: pointer;
    }

    .icon-button:hover {
      color: var(--text);
      border-color: var(--line-strong);
    }

    .icon-button svg {
      width: 16px;
      height: 16px;
    }

    .content-header {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 24px;
      align-items: end;
      padding: 30px 32px 24px;
      border-bottom: 1px solid var(--line);
    }

    .eyebrow {
      color: var(--copper);
      font-size: 11px;
      font-weight: 800;
      margin-bottom: 8px;
      text-transform: uppercase;
    }

    h1 {
      margin: 0;
      font-size: 32px;
      line-height: 1.12;
      font-weight: 760;
    }

    .header-subtitle {
      max-width: 720px;
      margin: 10px 0 0;
      color: var(--muted);
      font-size: 13px;
      line-height: 1.55;
    }

    .review-badge {
      min-width: 176px;
      padding: 11px 13px;
      border: 1px solid rgba(225, 162, 59, 0.6);
      border-radius: 5px;
      background: rgba(225, 162, 59, 0.08);
    }

    .review-badge span {
      display: block;
      color: var(--muted);
      font-size: 10px;
      margin-bottom: 4px;
    }

    .review-badge strong {
      color: var(--amber);
      font-size: 12px;
    }

    .metric-band {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      border-bottom: 1px solid var(--line);
    }

    .metric {
      min-height: 104px;
      padding: 18px 22px;
      border-right: 1px solid var(--line);
      background: var(--surface);
    }

    .metric:last-child {
      border-right: 0;
    }

    .metric-label {
      color: var(--muted);
      font-size: 10px;
      margin-bottom: 9px;
      text-transform: uppercase;
    }

    .metric-value {
      font-size: 22px;
      line-height: 1;
      font-weight: 760;
      font-variant-numeric: tabular-nums;
    }

    .metric-value.green { color: var(--green); }
    .metric-value.cyan { color: var(--cyan); }
    .metric-value.amber { color: var(--amber); }
    .metric-value.copper { color: var(--copper); }

    .metric-note {
      color: var(--quiet);
      font-size: 10px;
      margin-top: 8px;
    }

    .topology-band {
      display: grid;
      grid-template-columns: minmax(0, 1.65fr) minmax(300px, 0.75fr);
      min-height: 350px;
      border-bottom: 1px solid var(--line);
      background: #0a0d10;
    }

    .topology-visual {
      position: relative;
      min-width: 0;
      min-height: 350px;
      border-right: 1px solid var(--line);
      overflow: hidden;
    }

    .band-heading {
      position: absolute;
      top: 18px;
      left: 22px;
      z-index: 2;
    }

    .band-heading strong {
      display: block;
      font-size: 13px;
    }

    .band-heading span {
      display: block;
      color: var(--muted);
      font-size: 10px;
      margin-top: 4px;
    }

    #topologyCanvas {
      width: 100%;
      height: 350px;
      display: block;
      cursor: pointer;
    }

    .workstream-panel {
      padding: 22px;
      background: var(--surface);
    }

    .panel-title {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 18px;
    }

    .panel-title h2,
    .section-heading h2 {
      margin: 0;
      font-size: 15px;
      line-height: 1.25;
    }

    .status-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--amber);
      box-shadow: 0 0 0 4px rgba(225, 162, 59, 0.12);
      flex: 0 0 auto;
    }

    .lane-row {
      display: grid;
      grid-template-columns: 76px minmax(0, 1fr) auto;
      gap: 10px;
      align-items: center;
      min-height: 42px;
      border-bottom: 1px solid var(--line);
      font-size: 11px;
    }

    .lane-code {
      color: var(--cyan);
      font-weight: 800;
    }

    .lane-name {
      min-width: 0;
      color: var(--text);
    }

    .lane-state {
      color: var(--muted);
      font-size: 10px;
      text-align: right;
    }

    .lane-state.ready { color: var(--green); }
    .lane-state.active { color: var(--amber); }
    .lane-state.closed { color: var(--rose); }

    .packet-stats {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1px;
      margin-top: 18px;
      background: var(--line);
      border: 1px solid var(--line);
    }

    .packet-stat {
      min-height: 62px;
      padding: 11px;
      background: var(--surface-raised);
    }

    .packet-stat strong {
      display: block;
      color: var(--text);
      font-size: 17px;
      font-variant-numeric: tabular-nums;
    }

    .packet-stat span {
      display: block;
      color: var(--muted);
      font-size: 9px;
      margin-top: 5px;
      text-transform: uppercase;
    }

    .section-band {
      padding: 26px 32px 32px;
      border-bottom: 1px solid var(--line);
    }

    .section-heading {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      gap: 20px;
      margin-bottom: 18px;
    }

    .section-heading p {
      margin: 5px 0 0;
      color: var(--muted);
      font-size: 11px;
    }

    .surface-controls {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }

    .search-wrap {
      position: relative;
      width: 230px;
    }

    .search-wrap svg {
      position: absolute;
      left: 10px;
      top: 50%;
      width: 15px;
      height: 15px;
      color: var(--quiet);
      transform: translateY(-50%);
      pointer-events: none;
    }

    .search-input {
      width: 100%;
      height: 36px;
      padding: 0 10px 0 34px;
      border: 1px solid var(--line);
      border-radius: 5px;
      background: var(--surface);
      color: var(--text);
      font-size: 11px;
    }

    .search-input::placeholder {
      color: var(--quiet);
    }

    .segments {
      display: flex;
      min-height: 36px;
      border: 1px solid var(--line);
      border-radius: 5px;
      overflow: hidden;
    }

    .segment {
      min-width: 62px;
      padding: 0 12px;
      border: 0;
      border-right: 1px solid var(--line);
      background: var(--surface);
      color: var(--muted);
      cursor: pointer;
      font-size: 10px;
    }

    .segment:last-child {
      border-right: 0;
    }

    .segment:hover {
      color: var(--text);
    }

    .segment.active {
      background: var(--surface-soft);
      color: var(--text);
      box-shadow: inset 0 -2px 0 var(--copper);
    }

    .surface-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 12px;
    }

    .surface-card {
      min-width: 0;
      min-height: 152px;
      display: flex;
      flex-direction: column;
      border: 1px solid var(--line);
      border-radius: 6px;
      background: var(--surface);
      overflow: hidden;
      transition: border-color 150ms ease, transform 150ms ease;
    }

    .surface-card:hover {
      border-color: var(--line-strong);
      transform: translateY(-1px);
    }

    .card-accent {
      height: 3px;
      background: var(--card-accent, var(--copper));
    }

    .card-body {
      flex: 1;
      padding: 14px 15px 12px;
    }

    .card-meta {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      margin-bottom: 12px;
    }

    .card-kind {
      color: var(--quiet);
      font-size: 9px;
      font-weight: 700;
      text-transform: uppercase;
    }

    .state-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      min-height: 22px;
      padding: 0 7px;
      border: 1px solid var(--line);
      border-radius: 4px;
      color: var(--muted);
      background: var(--surface-raised);
      font-size: 9px;
      font-weight: 700;
      white-space: nowrap;
    }

    .state-badge::before {
      content: "";
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: currentColor;
    }

    .state-badge.review { color: var(--amber); }
    .state-badge.protected { color: var(--cyan); }
    .state-badge.gated { color: var(--rose); }
    .state-badge.reference { color: var(--green); }

    .surface-card h3 {
      margin: 0;
      min-height: 38px;
      font-size: 13px;
      line-height: 1.45;
    }

    .card-boundary {
      margin-top: 8px;
      color: var(--muted);
      font-size: 10px;
      line-height: 1.4;
      overflow-wrap: anywhere;
    }

    .card-footer {
      min-height: 42px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 8px 10px 8px 15px;
      border-top: 1px solid var(--line);
    }

    .card-route {
      min-width: 0;
      overflow: hidden;
      color: var(--quiet);
      font-family: Consolas, "SFMono-Regular", monospace;
      font-size: 9px;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .open-link {
      height: 28px;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 0 9px;
      border: 1px solid var(--line-strong);
      border-radius: 4px;
      color: var(--text);
      text-decoration: none;
      font-size: 9px;
      font-weight: 700;
      white-space: nowrap;
    }

    .open-link:hover {
      border-color: var(--copper);
      color: var(--copper);
    }

    .open-link svg {
      width: 12px;
      height: 12px;
    }

    .empty-state {
      grid-column: 1 / -1;
      min-height: 150px;
      display: grid;
      place-items: center;
      border: 1px dashed var(--line);
      color: var(--muted);
      font-size: 12px;
    }

    .boundary-band {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      background: var(--surface);
      border-bottom: 1px solid var(--line);
    }

    .boundary-item {
      min-height: 112px;
      padding: 20px 22px;
      border-right: 1px solid var(--line);
    }

    .boundary-item:last-child {
      border-right: 0;
    }

    .boundary-icon {
      width: 28px;
      height: 28px;
      display: grid;
      place-items: center;
      margin-bottom: 11px;
      color: var(--boundary-color, var(--cyan));
    }

    .boundary-icon svg {
      width: 22px;
      height: 22px;
    }

    .boundary-item strong {
      display: block;
      font-size: 12px;
      margin-bottom: 5px;
    }

    .boundary-item span {
      color: var(--muted);
      font-size: 10px;
      line-height: 1.5;
    }

    .page-footer {
      min-height: 72px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      padding: 18px 32px;
      color: var(--quiet);
      font-size: 10px;
    }

    .footer-links {
      display: flex;
      align-items: center;
      gap: 14px;
      flex-wrap: wrap;
    }

    .footer-links a {
      color: var(--muted);
      text-decoration: none;
    }

    .footer-links a:hover {
      color: var(--text);
    }

    .mobile-menu {
      display: none;
    }

    @media (max-width: 1120px) {
      .surface-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .topology-band {
        grid-template-columns: minmax(0, 1.35fr) minmax(290px, 0.8fr);
      }
    }

    @media (max-width: 860px) {
      .app-shell {
        display: block;
      }

      .sidebar {
        position: fixed;
        left: 0;
        width: min(286px, 86vw);
        transform: translateX(-100%);
        transition: transform 180ms ease;
        box-shadow: 12px 0 32px rgba(0, 0, 0, 0.4);
      }

      .sidebar.open {
        transform: translateX(0);
      }

      .mobile-menu {
        display: grid;
      }

      .content-header {
        padding: 25px 22px 20px;
      }

      .metric-band {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .metric:nth-child(2) {
        border-right: 0;
      }

      .metric:nth-child(-n+2) {
        border-bottom: 1px solid var(--line);
      }

      .topology-band {
        grid-template-columns: 1fr;
      }

      .topology-visual {
        border-right: 0;
        border-bottom: 1px solid var(--line);
      }

      .section-band {
        padding: 24px 22px 28px;
      }

      .section-heading {
        align-items: flex-start;
        flex-direction: column;
      }

      .surface-controls {
        width: 100%;
      }

      .search-wrap {
        flex: 1;
        min-width: 180px;
      }
    }

    @media (max-width: 600px) {
      .topbar {
        padding: 0 14px;
      }

      .topbar-title span,
      .utc {
        display: none;
      }

      .content-header {
        grid-template-columns: 1fr;
        gap: 18px;
      }

      h1 {
        font-size: 27px;
      }

      .review-badge {
        min-width: 0;
        width: 100%;
      }

      .metric {
        min-height: 96px;
        padding: 16px;
      }

      .metric-value {
        font-size: 19px;
      }

      .surface-grid {
        grid-template-columns: 1fr;
      }

      .segments {
        width: 100%;
        overflow-x: auto;
      }

      .segment {
        flex: 1 0 auto;
      }

      .search-wrap {
        flex-basis: 100%;
        width: 100%;
      }

      .boundary-band {
        grid-template-columns: 1fr;
      }

      .boundary-item {
        border-right: 0;
        border-bottom: 1px solid var(--line);
      }

      .boundary-item:last-child {
        border-bottom: 0;
      }

      .page-footer {
        align-items: flex-start;
        flex-direction: column;
        padding: 18px 22px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      *,
      *::before,
      *::after {
        scroll-behavior: auto !important;
        transition: none !important;
      }
    }
  </style>
</head>
<body data-surface-id="LS-OPS-HOME" data-workspace-route="/operations/home" data-delivery="static_readonly">
  <div class="app-shell">
    <aside class="sidebar" id="sidebar" aria-label="Operations navigation">
      <a class="brand" href="https://romer.industries" aria-label="Romer Industries home">
        <span class="brand-mark">RI</span>
        <span class="brand-name">
          <strong>Romer Industries</strong>
          <span>Operations Control Plane</span>
        </span>
      </a>

      <div class="side-state">
        <div class="state-line"><span>Control plane</span><span class="state-value review">Review gated</span></div>
        <div class="state-line"><span>Delivery</span><span class="state-value">Static read-only</span></div>
        <div class="state-line"><span>Selection</span><span class="state-value">None</span></div>
      </div>

      <nav class="side-nav">
        <div class="nav-label">Operations</div>
        <button class="nav-button active" data-filter="all" type="button">
          <i data-lucide="layout-dashboard"></i><span>Control overview</span>
        </button>
        <button class="nav-button" data-filter="workspace" type="button">
          <i data-lucide="blocks"></i><span>Workspaces</span>
        </button>
        <button class="nav-button" data-filter="calculator" type="button">
          <i data-lucide="calculator"></i><span>Calculators</span>
        </button>
        <button class="nav-button" data-filter="simulator" type="button">
          <i data-lucide="orbit"></i><span>Simulators</span>
        </button>
        <button class="nav-button" data-filter="reference" type="button">
          <i data-lucide="library"></i><span>References</span>
        </button>

        <div class="nav-label">Protected</div>
        <a class="nav-link" href="/data/achilles">
          <i data-lucide="shield-check"></i><span>Achilles status</span>
        </a>
        <a class="nav-link" href="/library">
          <i data-lucide="book-open"></i><span>Source library</span>
        </a>
      </nav>

      <div class="side-footer">
        Registry: ROMER-OPERATIONS-WEB-REVIEW<br>
        Direct desktop mutation: disabled
      </div>
