<script>
// ── MAIN CALCULATOR ──
function runCalculator(){
  setStatus('Calculating...', true);
  setTimeout(()=>{
    try{
      const body=getBody();
      const mu=body.mu, R=body.radius, J2=body.J2;
      const useJ2=document.getElementById('useJ2').checked;
      const dur=parseFloat(document.getElementById('duration').value);
      const stp=parseFloat(document.getElementById('step').value);
      const txType=document.getElementById('transferType').value;
      const a2_tx=parseFloat(document.getElementById('a2').value);
      const a_int=parseFloat(document.getElementById('a_int').value);
      let kep;
      if(document.getElementById('stateMode').value==='keplerian'){
        const a=parseFloat(document.getElementById('a').value);
        const e=parseFloat(document.getElementById('e').value);
        const i_v=parseFloat(document.getElementById('i').value);
        const raan_v=parseFloat(document.getElementById('raan').value);
        const argp_v=parseFloat(document.getElementById('argp').value);
        const ta_v=parseFloat(document.getElementById('ta').value);
        kep={a,e,i:i_v,raan:raan_v,argp:argp_v,ta:ta_v};
      } else {
        const rx=parseFloat(document.getElementById('rx').value);
        const ry=parseFloat(document.getElementById('ry').value);
        const rz=parseFloat(document.getElementById('rz').value);
        const vx=parseFloat(document.getElementById('vx').value);
        const vy=parseFloat(document.getElementById('vy').value);
        const vz=parseFloat(document.getElementById('vz').value);
        kep=cartesian2keplerian(rx,ry,rz,vx,vy,vz,mu);
      }
      const {a,e,i,raan,argp,ta}=kep;
      const cart0=keplerian2cartesian(a,e,i,raan,argp,ta,mu);
      // Derived orbital parameters
      const T=2*Math.PI*Math.sqrt(a*a*a/mu);
      const rp=a*(1-e), ra=a*(1+e);
      const hp=rp-R, ha=ra-R;
      const vp=Math.sqrt(mu*(2/rp-1/a));
      const va=Math.sqrt(mu*(2/ra-1/a));
      const eps=-mu/(2*a);
      const h_ang=Math.sqrt(mu*a*(1-e*e));
      // J2 nodal precession
      const n=Math.sqrt(mu/(a*a*a));
      const raan_dot=useJ2&&J2>0 ? -1.5*n*J2*(R/a)*(R/a)*Math.cos(i*D2R)/(1-e*e)/(1-e*e) * R2D * 86400 : 0;
      // Propagate
      const nSteps=Math.min(Math.ceil(dur/stp), 2000);
      const dtS=dur/nSteps;
      const tArr=[],xArr=[],yArr=[],zArr=[],vArr=[],rArr=[];
      let {rx,ry,rz,vx,vy,vz}=cart0;
      for(let k=0;k<=nSteps;k++){
        tArr.push(k*dtS);
        xArr.push(rx/1000); yArr.push(ry/1000); zArr.push(rz/1000);
        vArr.push(Math.sqrt(vx*vx+vy*vy+vz*vz));
        rArr.push(Math.sqrt(rx*rx+ry*ry+rz*rz)/1000);
        if(k<nSteps){
          const nxt=propagateKepler(rx,ry,rz,vx,vy,vz,dtS,mu,J2,R,useJ2);
          rx=nxt.rx;ry=nxt.ry;rz=nxt.rz;vx=nxt.vx;vy=nxt.vy;vz=nxt.vz;
        }
      }
      // Transfer
      let txData;
      if(txType==='hohmann') txData=hohmannDeltaV(a,a2_tx,mu);
      else txData=biellipticDeltaV(a,a2_tx,a_int,mu);
      // Store
      lastResult={kep,cart0,body:body.name,T,rp,ra,hp,ha,vp,va,eps,h_ang,
        raan_dot,tArr,xArr,yArr,zArr,vArr,rArr,txData,txType,a2_tx,
        useJ2,J2,timestamp:new Date().toISOString()};
      // Render
      renderOrbitTab(lastResult);
      renderTrajTab(lastResult);
      renderTransferTab(lastResult);
      setStatus('Complete — '+nSteps+' steps propagated | Body: '+body.name, false);
      setLastTime();
