<script>
// ============================================================
// ORBITAL MECHANICS CALCULATOR 
// Romer Industries / EMASSC
// Carbon Black theme | Römer Scientific Palette
// Universal: callable by all workspaces W1-W6
// ============================================================

const BODIES = {
  Earth:{ mu:3.986004418e14, radius:6378137, J2:0.00108263, name:"Earth", sidereal:86164.0905 },
  Mars:{ mu:4.282837e13, radius:3389500, J2:0.001964, name:"Mars", sidereal:88642.6848 },
  Moon:{ mu:4.9048695e12, radius:1737400, J2:0.0002027, name:"Moon", sidereal:2360591.6 },
  Sun:{ mu:1.32712440018e20, radius:695700000, J2:0.0, name:"Sun", sidereal:2164320000 },
  Custom:{ mu:3.986004418e14, radius:6378137, J2:0.00108263, name:"Custom", sidereal:86164.0905 }
};

const PRESETS = {
  LEO:{ a:6778137, e:0.0, i:51.6, raan:0, argp:0, ta:0, dur:5400, step:30 },
  MEO:{ a:26560000, e:0.01, i:55.0, raan:0, argp:0, ta:0, dur:43200, step:120 },
  GEO:{ a:42164000, e:0.0, i:0.0, raan:0, argp:0, ta:0, dur:86400, step:300 },
  HEO:{ a:21578500, e:0.74, i:63.4, raan:0, argp:270, ta:0, dur:43200, step:120 },
  SSO:{ a:6971000, e:0.001, i:97.8, raan:0, argp:0, ta:0, dur:5676, step:30 },
  Molniya:{ a:26560000, e:0.74, i:63.4, raan:0, argp:270, ta:0, dur:43200, step:120 },
  Mars_LLO:{ a:3589500, e:0.005, i:45.0, raan:0, argp:0, ta:0, dur:21600, step:60 },
  Asteroid:{ a:414000000000, e:0.07, i:5.0, raan:80, argp:73, ta:0, dur:315360000, step:86400 }
};

const D2R = Math.PI/180, R2D = 180/Math.PI;
let lastResult = null, compList = [], sweepResult = null;

// ── MATH HELPERS ──
function keplerian2cartesian(a,e,i_deg,raan_deg,argp_deg,ta_deg,mu){
  const i=i_deg*D2R, raan=raan_deg*D2R, argp=argp_deg*D2R, ta=ta_deg*D2R;
  const p = a*(1-e*e);
  const r_s = p/(1+e*Math.cos(ta));
  const x_s = r_s*Math.cos(ta), y_s = r_s*Math.sin(ta);
  const vx_s = -Math.sqrt(mu/p)*Math.sin(ta);
  const vy_s = Math.sqrt(mu/p)*(e+Math.cos(ta));
  const cos_r=Math.cos(raan),sin_r=Math.sin(raan);
  const cos_a=Math.cos(argp),sin_a=Math.sin(argp);
  const cos_i=Math.cos(i),sin_i=Math.sin(i);
  const Qxx=cos_r*cos_a-sin_r*sin_a*cos_i, Qxy=-cos_r*sin_a-sin_r*cos_a*cos_i;
  const Qyx=sin_r*cos_a+cos_r*sin_a*cos_i, Qyy=-sin_r*sin_a+cos_r*cos_a*cos_i;
  const Qzx=sin_a*sin_i, Qzy=cos_a*sin_i;
  return {
    rx:Qxx*x_s+Qxy*y_s, ry:Qyx*x_s+Qyy*y_s, rz:Qzx*x_s+Qzy*y_s,
    vx:Qxx*vx_s+Qxy*vy_s, vy:Qyx*vx_s+Qyy*vy_s, vz:Qzx*vx_s+Qzy*vy_s
  };
}

function cartesian2keplerian(rx,ry,rz,vx,vy,vz,mu){
  const r=Math.sqrt(rx*rx+ry*ry+rz*rz);
  const v=Math.sqrt(vx*vx+vy*vy+vz*vz);
  const eps=0.5*v*v - mu/r;
  const a_k=-mu/(2*eps);
  const hx=ry*vz-rz*vy, hy=rz*vx-rx*vz, hz=rx*vy-ry*vx;
  const h=Math.sqrt(hx*hx+hy*hy+hz*hz);
  const ex=(vy*hz-vz*hy)/mu - rx/r;
  const ey=(vz*hx-vx*hz)/mu - ry/r;
  const ez=(vx*hy-vy*hx)/mu - rz/r;
  const e_k=Math.sqrt(ex*ex+ey*ey+ez*ez);
  const i_k=Math.acos(Math.max(-1,Math.min(1,hz/h)))*R2D;
  const nx=-hy, ny=hx;
  const n=Math.sqrt(nx*nx+ny*ny);
  let raan_k=n>1e-10?Math.acos(Math.max(-1,Math.min(1,nx/n)))*R2D:0;
  if(ny<0) raan_k=360-raan_k;
  let argp_k=0;
  if(n>1e-10&&e_k>1e-10){
    argp_k=Math.acos(Math.max(-1,Math.min(1,(nx*ex+ny*ey)/(n*e_k))))*R2D;
    if(ez<0) argp_k=360-argp_k;
  }
  const rdotv=rx*vx+ry*vy+rz*vz;
  let ta_k=e_k>1e-10?Math.acos(Math.max(-1,Math.min(1,(ex*rx+ey*ry+ez*rz)/(e_k*r))))*R2D:0;
  if(rdotv<0) ta_k=360-ta_k;
  return {a:a_k, e:e_k, i:i_k, raan:raan_k, argp:argp_k, ta:ta_k};
}

function propagateKepler(rx0,ry0,rz0,vx0,vy0,vz0,dt,mu,J2,R,useJ2){
  let rx=rx0,ry=ry0,rz=rz0,vx=vx0,vy=vy0,vz=vz0;
  const substeps=10;
  const h=dt/substeps;
  for(let s=0;s<substeps;s++){
    const r=Math.sqrt(rx*rx+ry*ry+rz*rz);
    const r3=r*r*r;
    let ax=-mu*rx/r3, ay=-mu*ry/r3, az=-mu*rz/r3;
    if(useJ2&&J2>0){
      const r5=r3*r*r, R2=R*R;
      const f=1.5*J2*mu*R2/r5;
      const zr2=(rz/r)*(rz/r);
      ax+=f*rx*(5*zr2-1);
      ay+=f*ry*(5*zr2-1);
      az+=f*rz*(5*zr2-3);
    }
    rx+=vx*h+0.5*ax*h*h;
    ry+=vy*h+0.5*ay*h*h;
    rz+=vz*h+0.5*az*h*h;
    vx+=ax*h; vy+=ay*h; vz+=az*h;
  }
  return {rx,ry,rz,vx,vy,vz};
}

function hohmannDeltaV(a1,a2,mu){
  const at=(a1+a2)/2;
  const v1=Math.sqrt(mu/a1);
  const vt1=Math.sqrt(mu*(2/a1-1/at));
  const vt2=Math.sqrt(mu*(2/a2-1/at));
  const v2=Math.sqrt(mu/a2);
  const dv1=Math.abs(vt1-v1), dv2=Math.abs(v2-vt2);
  const tof=Math.PI*Math.sqrt(at*at*at/mu);
  return {dv1, dv2, dvTotal:dv1+dv2, tof, at};
}

function biellipticDeltaV(a1,a2,ai,mu){
  const at1=(a1+ai)/2, at2=(ai+a2)/2;
  const v1=Math.sqrt(mu/a1);
  const vt1a=Math.sqrt(mu*(2/a1-1/at1));
  const vt1b=Math.sqrt(mu*(2/ai-1/at1));
  const vt2a=Math.sqrt(mu*(2/ai-1/at2));
  const vt2b=Math.sqrt(mu*(2/a2-1/at2));
  const v2=Math.sqrt(mu/a2);
  const dv1=Math.abs(vt1a-v1);
  const dv2=Math.abs(vt2a-vt1b);
  const dv3=Math.abs(v2-vt2b);
  const tof=Math.PI*(Math.sqrt(at1*at1*at1/mu)+Math.sqrt(at2*at2*at2/mu));
  return {dv1, dv2, dv3, dvTotal:dv1+dv2+dv3, tof};
}
</script>
