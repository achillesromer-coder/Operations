// ── DATASPACE ROUTING (localStorage — Achilles-compatible, no duplicate layers) ──
function sendToDS(ws, data){
  const payload=data||(buildManifest());
  if(!payload){ alert('Run calculation first.'); return; }
  const key='achilles_calc_orbital_'+ws.toLowerCase();
  const record={ws, source:'calc/orbital', timestamp:new Date().toISOString(), data:payload};
  try{
    localStorage.setItem(key, JSON.stringify(record));
    // Also push to Achilles Linker bus if available
    if(window.Linker && window.Linker.bus){
      window.Linker.bus.send('calc_result',{workspace:ws, calc:'orbital', record});
    }
    const conf=document.getElementById('dsConf');
    if(conf) conf.textContent='&#10003; Sent to '+ws+' dataspace at '+new Date().toUTCString().replace('GMT','UTC');
    document.getElementById('dsConf').style.color='var(--te)';
  } catch(e){
    const conf=document.getElementById('dsConf');
    if(conf) conf.textContent='Storage error: '+e.message;
  }
}

function downloadFile(content,filename,type){
  const blob=new Blob([content],{type});
  const url=URL.createObjectURL(blob);
  const a=document.createElement('a');
  a.href=url; a.download=filename; a.click();
  setTimeout(()=>URL.revokeObjectURL(url),500);
}

