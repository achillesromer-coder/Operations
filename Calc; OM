// ── SWEEP ──
function updateSweepRange(){
  const v=document.getElementById('sweepVar').value;
  const ranges={
    altitude:{s:200,e:40000,st:50},
    eccentricity:{s:0,e:0.9,st:0.05},
    inclination:{s:0,e:180,st:5},
    sma:{s:6600,e:50000,st:500},
    dv_target:{s:400,e:40000,st:500},
    transfer_ratio:{s:1.1,e:10,st:0.3},
    j2_drift:{s:200,e:40000,st:500}
  };
  const rng=ranges[v]||{s:0,e:100,st:5};
  document.getElementById('swStart').value=rng.s;
  document.getElementById('swEnd').value=rng.e;
}

function runSweep(){
  setStatus('Running sweep...', true);
  setTimeout(()=>{
    const body=getBody();
    const mu=body.mu, R=body.radius, J2=body.J2;
    const useJ2=document.getElementById('useJ2').checked;
    const sVar=document.getElementById('sweepVar').value;
    const sStart=parseFloat(document.getElementById('swStart').value);
    const sEnd=parseFloat(document.getElementById('swEnd').value);
    const sN=parseInt(document.getElementById('swSteps').value);
    const baseKep={
      a:parseFloat(document.getElementById('a').value),
      e:parseFloat(document.getElementById('e').value),
      i:parseFloat(document.getElementById('i').value)
    };
    const a2_tx=parseFloat(document.getElementById('a2').value);
    const pts=[], metrics={period:[],vcirc:[],dvGEO:[],raanDot:[],energy:[],hill:[]};
    for(let k=0;k<=sN;k++){
      const frac=k/sN;
      const val=sStart+(sEnd-sStart)*frac;
      pts.push(val);
      let a_s=baseKep.a, e_s=baseKep.e, i_s=baseKep.i;
      let a2_s=a2_tx;
      switch(sVar){
        case 'altitude': a_s=(val*1000)+R; break;
        case 'sma': a_s=val*1000; break;
        case 'eccentricity': e_s=val; break;
        case 'inclination': i_s=val; break;
        case 'dv_target': a2_s=(val*1000)+R; break;
        case 'transfer_ratio': a2_s=a_s*val; break;
        case 'j2_drift': a_s=(val*1000)+R; break;
      }
      if(a_s<=R||e_s>=1||e_s<0) { metrics.period.push(null);metrics.vcirc.push(null);metrics.dvGEO.push(null);metrics.raanDot.push(null);metrics.energy.push(null);metrics.hill.push(null); continue; }
      const T=2*Math.PI*Math.sqrt(a_s*a_s*a_s/mu);
      const vcirc=Math.sqrt(mu/a_s);
      const tx=hohmannDeltaV(a_s,a2_s,mu);
      const n=Math.sqrt(mu/(a_s*a_s*a_s));
      const raan_d=useJ2&&J2>0 ? -1.5*n*J2*(R/a_s)*(R/a_s)*Math.cos(i_s*D2R)/(1-e_s*e_s)/(1-e_s*e_s)*R2D*86400 : 0;
      const eps=-mu/(2*a_s);
      const hill_r=a_s*Math.pow(mu/(3*body.mu),1/3);
      metrics.period.push(T/60);
      metrics.vcirc.push(vcirc);
      metrics.dvGEO.push(tx.dvTotal);
      metrics.raanDot.push(raan_d);
      metrics.energy.push(eps);
      metrics.hill.push(hill_r/1000);
    }
    sweepResult={sVar,pts,metrics,body:body.name,timestamp:new Date().toISOString()};
    renderSweepPlot(sweepResult);
    renderSweepStats(sweepResult);
    setStatus('Sweep complete — '+sN+' steps | Variable: '+sVar, false);
    setLastTime();
  },100);
}

function renderSweepPlot(r){
  const {sVar,pts,metrics}=r;
  const traces=[];
  const axisLabels={
    altitude:'Altitude (km)', eccentricity:'Eccentricity', inclination:'Inclination (deg)',
    sma:'Semi-major Axis (km)', dv_target:'Target Altitude (km)',
    transfer_ratio:'Transfer Ratio a2/a1', j2_drift:'Altitude (km)'
  };
  const xl=axisLabels[sVar]||sVar;
  const defs=[
    {key:'period', name:'Period (min)', col:PLY.te, ax:'y', chk:'sm_per'},
    {key:'vcirc', name:'Circular v (m/s)', col:PLY.go, ax:'y2', chk:'sm_vc'},
    {key:'dvGEO', name:'dV to GEO (m/s)', col:PLY.cu, ax:'y3', chk:'sm_dv'},
    {key:'raanDot', name:'RAAN Drift (deg/day)', col:PLY.w3, ax:'y4', chk:'sm_j2'},
    {key:'energy', name:'Spec. Energy (J/kg)', col:PLY.w4, ax:'y5', chk:'sm_en'},
    {key:'hill', name:'Hill Sphere (km)', col:PLY.w5, ax:'y6', chk:'sm_hi'},
  ];
  let visCount=0;
  defs.forEach(d=>{
    const chk=document.getElementById(d.chk);
    if(!chk||!chk.checked) return;
    traces.push({
      type:'scatter', mode:'lines+markers',
      x:pts, y:metrics[d.key],
      name:d.name,
      line:{color:d.col, width:2},
      marker:{size:3},
      connectgaps:false
    });
    visCount++;
  });
  if(!traces.length) return;
  const ly=plyLayout('Parameter Sweep: '+sVar,xl, traces[0]?traces[0].name:'');
  Plotly.react('pSweep',traces,ly,plyConfig());
}

function renderSweepStats(r){
  const {sVar,pts,metrics}=r;
  const validPer=metrics.period.filter(v=>v!==null);
  const validDv=metrics.dvGEO.filter(v=>v!==null);
  const minDv=validDv.length?Math.min(...validDv):NaN;
  const minDvIdx=validDv.indexOf(minDv);
  const minT=validPer.length?Math.min(...validPer):NaN;
  const maxT=validPer.length?Math.max(...validPer):NaN;
  document.getElementById('swStats').textContent=
    `SWEEP SUMMARY | Variable: ${sVar} | Steps: ${pts.length}
Range: ${pts[0]} to ${pts[pts.length-1]}
Period:        min=${minT.toFixed(2)} min | max=${maxT.toFixed(2)} min
Min dV to GEO: ${isNaN(minDv)?'N/A':minDv.toFixed(2)} m/s at ${sVar}=${validDv.length&&pts[minDvIdx]!==undefined?pts[minDvIdx].toFixed(2):'?'}
Generated: ${r.timestamp}`;
}

