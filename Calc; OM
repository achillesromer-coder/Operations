    {l:'dv1 (m/s)',v:fmtN(txData.dv1),u:'m/s',cls:'te'},
    {l:'dv2 (m/s)',v:fmtN(txData.dv2),u:'m/s',cls:'te'},
    isDv3?{l:'dv3 (m/s)',v:fmtN(txData.dv3),u:'m/s',cls:'te'}:null,
    {l:'Total dv',v:fmtN(dvT),u:'m/s',cls:'go'},
    {l:'TOF',v:fmtN(tofH,1),u:'hrs',cls:''},
    {l:'From a',v:fmtN(kep.a/1e3),u:'km',cls:''},
    {l:'To a',v:fmtN(a2_tx/1e3),u:'km',cls:''},
  ].filter(Boolean);
  document.getElementById('sgTx').innerHTML=stats.map(s=>
    `<div class="sc"><div class="sl">${s.l}</div><div class="sv ${s.cls}">${s.v}<span class="su"> ${s.u}</span></div></div>`
  ).join('');
  document.getElementById('sbTx').textContent=
    `${txType==='hohmann'?'Hohmann':'Bi-elliptic'} transfer | dv_total=${fmtN(dvT)} m/s | TOF=${fmtN(tofH,1)} hrs`;
  // Transfer plot
  const a1=kep.a, at=txType==='hohmann'?txData.at:null;
  const ang=Array.from({length:361},(_,i)=>i*D2R);
  function ellipseXY(a_el,e_el){
    const p=a_el*(1-e_el*e_el);
    return ang.map(th=>({x:p*Math.cos(th)/(1+e_el*Math.cos(th))/1e6,
                          y:p*Math.sin(th)/(1+e_el*Math.cos(th))/1e6}));
  }
  const e2=0, e_tx=txType==='hohmann'?Math.abs(a2_tx-a1)/(a2_tx+a1):0.0;
  const c1=ellipseXY(a1,kep.e);
  const c2=ellipseXY(a2_tx,0);
  const ct=txType==='hohmann'?ellipseXY((a1+a2_tx)/2,e_tx):[];
  const trList=[
    {type:'scatter',mode:'lines',x:c1.map(p=>p.x),y:c1.map(p=>p.y),name:'Initial orbit',line:{color:PLY.te,width:2}},
    {type:'scatter',mode:'lines',x:c2.map(p=>p.x),y:c2.map(p=>p.y),name:'Target orbit',line:{color:PLY.go,width:2,dash:'dash'}},
    txType==='hohmann'?{type:'scatter',mode:'lines',x:ct.map(p=>p.x),y:ct.map(p=>p.y),name:'Transfer arc',line:{color:PLY.cu,width:1.5,dash:'dot'}}:null,
    {type:'scatter',mode:'markers',x:[0],y:[0],name:body,marker:{size:10,color:PLY.cu}},
  ].filter(Boolean);
  const txLayout={
    ...plyLayout('Transfer Orbit — '+body,'X (Mm)','Y (Mm)'),
    yaxis:{...plyLayout('','','').yaxis, scaleanchor:'x'}
  };
  Plotly.react('pTx',trList,txLayout,plyConfig());
  document.getElementById('burnSeq').textContent=
    isDv3?
    `BURN SEQUENCE (Bi-elliptic)
Burn 1: dv1 = +${txData.dv1.toFixed(2)} m/s  at periapsis a1
Burn 2: dv2 = +${txData.dv2.toFixed(2)} m/s  at apoapsis of transfer 1
Burn 3: dv3 = +${txData.dv3.toFixed(2)} m/s  at periapsis of transfer 2
Total:  ${txData.dvTotal.toFixed(2)} m/s over ${(txData.tof/3600).toFixed(2)} hrs`:
    `BURN SEQUENCE (Hohmann)
Burn 1: dv1 = +${txData.dv1.toFixed(2)} m/s  at current periapsis
Burn 2: dv2 = +${txData.dv2.toFixed(2)} m/s  at target orbit altitude
Total:  ${txData.dvTotal.toFixed(2)} m/s over ${(txData.tof/3600).toFixed(2)} hrs`;
}
