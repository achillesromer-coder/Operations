  i_deg: ${m.keplerian.i_deg}
  raan_deg: ${m.keplerian.raan_deg}
  argp_deg: ${m.keplerian.argp_deg}
  ta_deg: ${m.keplerian.ta_deg}
derived:
  period_s: ${m.derived.period_s.toFixed(2)}
  hp_m: ${m.derived.periapsis_alt_m.toFixed(0)}
  ha_m: ${m.derived.apoapsis_alt_m.toFixed(0)}
  dv_total_ms: ${m.transfer.dv_total_ms.toFixed(2)}
  tof_s: ${m.transfer.tof_s.toFixed(0)}`;
  document.getElementById('expInfo').textContent=yaml;
  downloadFile(yaml,'orbital_manifest.yaml','text/plain');
}

