<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Orbital Mechanics Calculator | Romer Industries</title>
<script src="https://cdn.plot.ly/plotly-2.27.0.min.js"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{
  --bg0:#0B0D10;--bg1:#0F1215;--bg2:#141820;--bg3:#1A1F2A;
  --iv:#F2F1EC;--iv2:#A8A79E;--iv3:#5A5952;
  --cu:#B87333;--go:#C9A24A;--te:#4EC5C1;
  --te2:rgba(78,197,193,.15);--te3:rgba(78,197,193,.07);
  --cy:#00E5FF;--bd:#1E2530;--bh:#2A3545;
  --dn:#E8896A;--wn:#C9A24A;
  --fh:'Inter',system-ui,sans-serif;
  --fd:'JetBrains Mono',ui-monospace,monospace;
}
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:var(--fh);background:var(--bg0);color:var(--iv);min-height:100vh;font-size:14px;line-height:1.5}
/* OPS HEADER */
.oh{background:var(--bg0);border-bottom:2px solid var(--te);width:100%}
.oh-h{background:var(--bg1);padding:.5rem 1rem;display:flex;align-items:center;gap:.6rem;flex-wrap:wrap;border-bottom:1px solid var(--bd)}
.oh-ic{font-size:1rem;color:var(--te)}
.oh-t{flex:1;min-width:160px}
.oh-t h2{font-size:.78rem;font-weight:700;color:var(--te);letter-spacing:.08em;text-transform:uppercase;margin:0}
.oh-t p{font-size:.6rem;color:var(--iv3);margin:0;font-family:var(--fd)}
.oh-f{display:flex;gap:.22rem;flex-wrap:wrap}
.oh-f a{padding:.16rem .38rem;border-radius:3px;font-size:.6rem;font-weight:600;text-decoration:none;color:var(--iv3);background:var(--bg2);border:1px solid var(--bd);transition:all .15s}
.oh-f a:hover{color:var(--iv);border-color:var(--iv3)}
.oh-f a.a1{color:#00d4ff;border-color:rgba(0,212,255,.35)}
.oh-f a.a2{color:#7b2cbf;border-color:rgba(123,44,191,.35)}
.oh-f a.a3{color:#ff3366;border-color:rgba(255,51,102,.35)}
.oh-f a.a4{color:#ffaa00;border-color:rgba(255,170,0,.35)}
.oh-f a.a5{color:#00ff88;border-color:rgba(0,255,136,.35)}
.oh-f a.a6{color:#ff6b9d;border-color:rgba(255,107,157,.35)}
.oh-f a.al{color:var(--cu);border-color:rgba(184,115,51,.35)}
.oh-f a.ad{color:var(--go);border-color:rgba(201,162,74,.35)}
.oh-f a.on{color:var(--te);border-color:var(--te);background:var(--te2)}
.oh-m{background:var(--bg2);padding:.18rem 1rem;display:flex;align-items:center;gap:.7rem;font-size:.58rem;color:var(--iv3);flex-wrap:wrap;font-family:var(--fd)}
.oh-pl{padding:.04rem .26rem;border-radius:2px;font-size:.56rem;font-weight:700;background:var(--te2);color:var(--te)}
/* LAYOUT */
.cc{max-width:1460px;margin:0 auto;padding:.9rem}
.ch{padding:.65rem .9rem;margin-bottom:.9rem;border-bottom:1px solid var(--bd)}
.ch h1{font-size:1.3rem;font-weight:700;color:var(--iv);letter-spacing:.02em}
.ch .sub{font-size:.68rem;color:var(--iv3);font-family:var(--fd);margin-top:.18rem}
.br{display:flex;gap:.4rem;margin-top:.35rem;flex-wrap:wrap}
.bge{padding:.08rem .36rem;border-radius:3px;font-size:.58rem;font-weight:700;font-family:var(--fd);background:var(--bg2);border:1px solid var(--bd);color:var(--iv3)}
.bge.te{color:var(--te);border-color:rgba(78,197,193,.28);background:var(--te3)}
.bge.go{color:var(--go);border-color:rgba(201,162,74,.25)}
.bge.cu{color:var(--cu);border-color:rgba(184,115,51,.25)}
.mg{display:grid;grid-template-columns:300px 1fr;gap:.9rem}
@media(max-width:880px){.mg{grid-template-columns:1fr}}
.pn{background:var(--bg1);border:1px solid var(--bd);border-radius:5px;overflow:hidden}
.pt{font-size:.67rem;font-weight:700;color:var(--te);letter-spacing:.07em;text-transform:uppercase;padding:.52rem .85rem;background:var(--bg2);border-bottom:1px solid var(--bd);display:flex;align-items:center;gap:.4rem}
.pt::before{content:'';width:3px;height:11px;background:var(--te);border-radius:2px;flex-shrink:0}
.pb{padding:.65rem .85rem}
/* FORMS */
.fr{margin-bottom:.58rem}
.fr label{display:block;font-size:.62rem;font-weight:600;color:var(--iv2);text-transform:uppercase;letter-spacing:.05em;margin-bottom:.25rem}
.fr input,.fr select{width:100%;padding:.42rem .6rem;background:var(--bg0);border:1px solid var(--bh);border-radius:4px;color:var(--iv);font-family:var(--fd);font-size:.75rem;transition:border-color .2s}
.fr input:focus,.fr select:focus{outline:none;border-color:var(--te);box-shadow:0 0 0 2px rgba(78,197,193,.1)}
.fr select option{background:var(--bg1)}
.hi{font-size:.57rem;color:var(--iv3);margin-top:.18rem;font-family:var(--fd)}
.fs{margin-bottom:.8rem;padding-bottom:.8rem;border-bottom:1px solid var(--bd)}
.fs:last-child{border-bottom:none;margin-bottom:0;padding-bottom:0}
.fst{font-size:.6rem;font-weight:700;color:var(--cu);text-transform:uppercase;letter-spacing:.06em;margin-bottom:.42rem}
.f2{display:grid;grid-template-columns:1fr 1fr;gap:.4rem}
/* BUTTONS */
.btn{padding:.4rem .8rem;border:1px solid var(--bh);border-radius:4px;font-family:var(--fh);font-size:.7rem;font-weight:600;cursor:pointer;transition:all .2s;text-transform:uppercase;letter-spacing:.04em}
.bp{background:var(--te);color:var(--bg0);border-color:var(--te)}
.bp:hover{background:#5FD8D4;box-shadow:0 0 10px rgba(78,197,193,.3)}
.bs{background:var(--bg2);color:var(--iv2);border-color:var(--bh)}
.bs:hover{border-color:var(--te);color:var(--te)}
.bc{background:transparent;color:var(--cu);border-color:var(--cu)}
.bc:hover{background:rgba(184,115,51,.1)}
.bg{background:transparent;color:var(--go);border-color:var(--go)}
.bg:hover{background:rgba(201,162,74,.08)}
.bsm{padding:.25rem .55rem;font-size:.62rem}
.bgrp{display:flex;gap:.35rem;flex-wrap:wrap;margin-top:.55rem}
/* PRESETS */
.prg{display:grid;grid-template-columns:1fr 1fr;gap:.35rem;margin-top:.35rem}
.prb{padding:.32rem .45rem;background:var(--bg3);border:1px solid var(--bd);border-radius:3px;color:var(--iv3);font-size:.6rem;font-weight:600;cursor:pointer;text-align:center;transition:all .2s;font-family:var(--fh)}
.prb:hover{border-color:var(--go);color:var(--go)}
/* TABS */
.tb{display:flex;border-bottom:1px solid var(--bd);background:var(--bg2)}
.tbb{padding:.42rem .72rem;font-size:.65rem;font-weight:600;color:var(--iv3);background:transparent;border:none;border-bottom:2px solid transparent;cursor:pointer;transition:all .2s;text-transform:uppercase;letter-spacing:.04em;font-family:var(--fh)}
.tbb:hover{color:var(--iv)}
.tbb.ac{color:var(--te);border-bottom-color:var(--te)}
.tc{display:none;padding:.65rem}
.tc.ac{display:block}
/* STATS */
.sg{display:grid;grid-template-columns:repeat(auto-fit,minmax(110px,1fr));gap:.42rem;margin-bottom:.65rem}
.sc{background:var(--bg2);border:1px solid var(--bd);border-radius:4px;padding:.48rem .6rem;position:relative;overflow:hidden}
.sc::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:var(--te)}
.sc.w::before{background:var(--go)}
.sc.d::before{background:var(--dn)}
.sl{font-size:.56rem;color:var(--iv3);text-transform:uppercase;letter-spacing:.04em;font-family:var(--fd);margin-bottom:.2rem}
.sv{font-size:1rem;font-weight:700;color:var(--iv);font-family:var(--fd);line-height:1.1}
.su{font-size:.58rem;color:var(--iv3);font-weight:400}
.sv.te{color:var(--te)}.sv.go{color:var(--go)}.sv.cu{color:var(--cu)}.sv.ok{color:#4EC5C1}.sv.wn{color:var(--go)}.sv.dn{color:var(--dn)}
/* DATA */
.dp{background:var(--bg0);border:1px solid var(--bd);border-radius:4px;padding:.55rem;font-family:var(--fd);font-size:.67rem;color:var(--te);line-height:1.6;overflow-x:auto;white-space:pre-wrap;max-height:260px;overflow-y:auto}
.dp.iv{color:var(--iv2)}
.sb{background:var(--bg2);border:1px solid var(--bd);border-left:3px solid var(--te);padding:.45rem .7rem;font-family:var(--fd);font-size:.67rem;color:var(--te);border-radius:4px;margin-bottom:.58rem;line-height:1.5}
/* PLOTS */
.pw{background:var(--bg0);border:1px solid var(--bd);border-radius:4px;width:100%;min-height:360px}
.pws{background:var(--bg0);border:1px solid var(--bd);border-radius:4px;width:100%;min-height:280px}
/* TABLE */
.ct{width:100%;border-collapse:collapse;font-size:.65rem;font-family:var(--fd)}
.ct th{background:var(--bg2);color:var(--cu);text-transform:uppercase;letter-spacing:.04em;padding:.36rem .55rem;border:1px solid var(--bd);text-align:left;font-size:.58rem}
.ct td{padding:.3rem .55rem;border:1px solid var(--bd);color:var(--iv2)}
.ct tr:hover td{background:var(--bg3);color:var(--iv)}
.ct td.hi{color:var(--te)}.ct td.wi{color:var(--go)}
/* SWEEP */
.swg{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:.45rem;margin-bottom:.58rem}
/* DATASPACE SEND */
.dsp{background:var(--bg2);border:1px solid var(--bd);border-top:2px solid var(--go);border-radius:4px;padding:.58rem .72rem;margin-top:.65rem}
.dspt{font-size:.6rem;font-weight:700;color:var(--go);text-transform:uppercase;letter-spacing:.06em;margin-bottom:.42rem}
.dsg{display:grid;grid-template-columns:repeat(auto-fit,minmax(115px,1fr));gap:.3rem}
.dsb{padding:.28rem .45rem;border-radius:3px;font-size:.6rem;font-weight:700;cursor:pointer;border:1px solid;text-align:center;transition:all .2s;font-family:var(--fh);text-transform:uppercase;letter-spacing:.02em}
.dsb:hover{opacity:.8;transform:translateY(-1px)}
.dw1{color:#00d4ff;border-color:rgba(0,212,255,.35);background:rgba(0,212,255,.05)}
.dw2{color:#7b2cbf;border-color:rgba(123,44,191,.3);background:rgba(123,44,191,.05)}
.dw3{color:#ff3366;border-color:rgba(255,51,102,.3);background:rgba(255,51,102,.05)}
.dw4{color:#ffaa00;border-color:rgba(255,170,0,.3);background:rgba(255,170,0,.05)}
.dw5{color:#00ff88;border-color:rgba(0,255,136,.3);background:rgba(0,255,136,.05)}
.dw6{color:#ff6b9d;border-color:rgba(255,107,157,.3);background:rgba(255,107,157,.05)}
.dex{color:var(--te);border-color:rgba(78,197,193,.35);background:var(--te3)}
.dgm{color:var(--cu);border-color:rgba(184,115,51,.35);background:rgba(184,115,51,.05)}
.dsc{font-size:.58rem;color:var(--te);margin-top:.35rem;font-family:var(--fd);min-height:.8rem}
/* ALERTS */
.al{padding:.45rem .65rem;border-radius:4px;font-size:.68rem;margin-bottom:.58rem;border-left:3px solid}
.ali{background:var(--te3);border-color:var(--te);color:var(--te)}
.alw{background:rgba(201,162,74,.07);border-color:var(--go);color:var(--go)}
/* STATUS */
.stb{padding:.28rem .65rem;background:var(--bg2);border-top:1px solid var(--bd);display:flex;align-items:center;gap:.65rem;font-size:.58rem;color:var(--iv3);font-family:var(--fd);flex-wrap:wrap}
.std{width:7px;height:7px;border-radius:50%;background:var(--te);animation:pu 2s infinite;flex-shrink:0}
.std.id{background:var(--iv3);animation:none}
@keyframes pu{0%,100%{opacity:1}50%{opacity:.35}}
/* FOOTER */
.of{background:var(--bg1);padding:.28rem .9rem;display:flex;align-items:center;gap:.65rem;border-top:1px solid var(--bd);flex-wrap:wrap}
.ofl{font-size:.58rem;color:var(--iv3);font-family:var(--fd)}
.olb{padding:.18rem .5rem;border-radius:3px;font-size:.6rem;font-weight:700;text-decoration:none;cursor:pointer;border:1px solid;transition:all .2s;font-family:var(--fh)}
.olb.tl{border-color:var(--te);color:var(--te);background:var(--te3)}
.olb.tl:hover{background:var(--te2)}
.olb.gl{border-color:var(--go);color:var(--go);background:rgba(201,162,74,.05)}
.olb.cl{border-color:var(--cu);color:var(--cu);background:rgba(184,115,51,.04)}
::-webkit-scrollbar{width:4px;height:4px}
::-webkit-scrollbar-track{background:var(--bg0)}
::-webkit-scrollbar-thumb{background:var(--bh);border-radius:2px}
@media(max-width:680px){.f2{grid-template-columns:1fr}.sg{grid-template-columns:repeat(2,1fr)}.dsg{grid-template-columns:repeat(2,1fr)}.prg{grid-template-columns:1fr 1fr}}
</style></head><body>

<div class="oh">
<div class="oh-h">
  <div class="oh-ic">&#9881;</div>
  <div class="oh-t">
    <h2>ORBITAL MECHANICS CALCULATOR </h2>
    <p>Keplerian propagation &middot; J2 perturbations &middot; Transfer &Delta;V &middot; Sweep analysis &middot; Universal tool /calc/orbital</p>
  </div>
  <div class="oh-f">
      <a href="/calc/orbital" class="on">ORB</a>
      <a href="/calc/launch">LW</a>
      <a href="/calc/magnetostatics">MAG</a>
      <a href="/calc/energy">PWR</a>
      <a href="/calc/fluids">FLD</a>
      <a href="/sims/rfs-extraction">RFS</a>
      <a href="/sim/node">EMFF</a>
      <a href="/sim/fields">EMF</a>
      <a href="/sim/re-entry">ENTRY</a>
      <a href="/w1/data" class="a1">W1</a>
      <a href="/w2/data" class="a2">W2</a>
      <a href="/w3/data" class="a3">W3</a>
      <a href="/w4/data" class="a4">W4</a>
      <a href="/w5/data" class="a5">W5</a>
      <a href="/w6/data" class="a6">W6</a>
      <a href="/data/achilles">ACH</a>
      <a href="/library" class="al">LIB</a>
      <a href="/gmat">GMAT</a>
      <a href="/dash" class="ad">DASH</a>
    </div>
    <div class="br">
      <span class="bge te"></span>
      <span class="bge">SI Units</span>
      <span class="bge cu">Universal Tool &mdash; W1&ndash;W6 callable</span>
      <span class="bge go">Plotly Visualisation</span>
      <span class="bge">JetBrains Mono &middot; Inter</span>
    </div>
  </div>

  <div class="mg">
    <!-- LEFT CONFIG -->
    <div>
      <div class="pn">
        <div class="pt">Configuration</div>
        <div class="pb">

          <div class="fs">
            <div class="fst">Central Body</div>
            <div class="fr">
              <label>Body Preset</label>
              <select id="body" onchange="onBodyChange()">
                <option value="Earth">Earth (&#956; = 3.986&times;10&sup1;&sup4; m&sup3;/s&sup2;)</option>
                <option value="Mars">Mars (&#956; = 4.283&times;10&sup1;&sup3; m&sup3;/s&sup2;)</option>
                <option value="Moon">Moon (&#956; = 4.905&times;10&sup1;&sup2; m&sup3;/s&sup2;)</option>
                <option value="Sun">Sun (&#956; = 1.327&times;10&sup2;&sup0; m&sup3;/s&sup2;)</option>
                <option value="Custom">Custom</option>
              </select>
            </div>
            <div class="f2" id="cbf" style="display:none">
              <div class="fr"><label>&#956; (m&sup3;/s&sup2;)</label><input type="number" id="mu" value="3.986004418e14" step="any"></div>
              <div class="fr"><label>Radius (m)</label><input type="number" id="radius" value="6378137" step="any"></div>
            </div>
            <div class="fr">
              <label style="display:flex;align-items:center;gap:.35rem;font-size:.62rem;color:var(--iv2);text-transform:uppercase;letter-spacing:.05em;margin-bottom:0">
                <input type="checkbox" id="useJ2" checked style="width:auto;margin-right:.2rem"> Enable J2 Perturbation
              </label>
              <div class="hi">Nodal precession from equatorial oblateness (J2 = 0.001083 Earth default)</div>
            </div>
          </div>

          <div class="fs">
            <div class="fst">Orbital Presets</div>
            <div class="prg">
              <button class="prb" onclick="loadPreset('LEO')">LEO 400 km</button>
              <button class="prb" onclick="loadPreset('MEO')">MEO 20,200 km</button>
              <button class="prb" onclick="loadPreset('GEO')">GEO 35,786 km</button>
              <button class="prb" onclick="loadPreset('HEO')">HEO 400&times;36k</button>
              <button class="prb" onclick="loadPreset('SSO')">SSO Dawn</button>
              <button class="prb" onclick="loadPreset('Molniya')">Molniya</button>
              <button class="prb" onclick="loadPreset('Mars_LLO')">Mars LLO</button>
              <button class="prb" onclick="loadPreset('Asteroid')">Asteroid Belt</button>
            </div>
          </div>

          <div class="fs">
            <div class="fst">Initial State</div>
            <div class="fr">
              <label>State Representation</label>
              <select id="stateMode" onchange="toggleStateMode()">
                <option value="keplerian">Keplerian Elements</option>
                <option value="cartesian">Cartesian (r, v)</option>
              </select>
            </div>
            <div id="keplerianInputs">
              <div class="f2">
                <div class="fr"><label>a &mdash; Semi-major axis (m)</label><input type="number" id="a" value="6778137" step="1000"></div>
                <div class="fr"><label>e &mdash; Eccentricity</label><input type="number" id="e" value="0.0" step="0.001" min="0" max="0.999"></div>
                <div class="fr"><label>i &mdash; Inclination (&deg;)</label><input type="number" id="i" value="51.6" step="0.1"></div>
                <div class="fr"><label>&Omega; &mdash; RAAN (&deg;)</label><input type="number" id="raan" value="0" step="0.1"></div>
                <div class="fr"><label>&omega; &mdash; Arg. Perigee (&deg;)</label><input type="number" id="argp" value="0" step="0.1"></div>
                <div class="fr"><label>&nu; &mdash; True Anomaly (&deg;)</label><input type="number" id="ta" value="0" step="0.1"></div>
              </div>
            </div>
            <div id="cartesianInputs" style="display:none">
              <div class="f2">
                <div class="fr"><label>rx (m)</label><input type="number" id="rx" value="6778137" step="1000"></div>
                <div class="fr"><label>ry (m)</label><input type="number" id="ry" value="0" step="1000"></div>
                <div class="fr"><label>rz (m)</label><input type="number" id="rz" value="0" step="1000"></div>
                <div class="fr"><label>vx (m/s)</label><input type="number" id="vx" value="0" step="10"></div>
                <div class="fr"><label>vy (m/s)</label><input type="number" id="vy" value="7784" step="10"></div>
                <div class="fr"><label>vz (m/s)</label><input type="number" id="vz" value="0" step="10"></div>
              </div>
            </div>
          </div>

          <div class="fs">
            <div class="fst">Propagation</div>
            <div class="f2">
              <div class="fr"><label>Duration (s)</label><input type="number" id="duration" value="86400" step="3600"><div class="hi">86400 s = 1 day</div></div>
              <div class="fr"><label>Time step (s)</label><input type="number" id="step" value="60" step="10"></div>
            </div>
          </div>

          <div class="fs">
            <div class="fst">Transfer Analysis</div>
            <div class="fr">
              <label>Transfer Type</label>
              <select id="transferType" onchange="toggleTransfer()">
                <option value="hohmann">Hohmann (2-burn)</option>
                <option value="bielliptic">Bi-elliptic (3-burn)</option>
              </select>
            </div>
            <div class="f2">
              <div class="fr"><label>Target orbit a&#8322; (m)</label><input type="number" id="a2" value="42164000" step="10000"></div>
              <div class="fr" id="bieg" style="display:none"><label>Intermediate a&#7522; (m)</label><input type="number" id="a_int" value="100000000" step="1000000"></div>
            </div>
          </div>

          <div class="bgrp">
            <button class="btn bp" onclick="runCalculator()">&#9654; Propagate &amp; Analyse</button>
            <button class="btn bs" onclick="addToComparison()">+ Compare</button>
            <button class="btn bc bsm" onclick="clearAll()">Clear</button>
          </div>

        </div>
      </div>
    </div>

    <!-- RIGHT RESULTS -->
    <div>
      <div class="pn">
        <div class="tb">
          <button class="tbb ac" onclick="switchTab('orbit')">Orbit</button>
          <button class="tbb" onclick="switchTab('trajectory')">Trajectory</button>
          <button class="tbb" onclick="switchTab('transfer')">Transfer &Delta;V</button>
          <button class="tbb" onclick="switchTab('compare')">Compare</button>
          <button class="tbb" onclick="switchTab('sweep')">Sweep</button>
          <button class="tbb" onclick="switchTab('export')">Export</button>
        </div>

        <div id="tab-orbit" class="tc ac">
          <div class="sb" id="sbOrbit">Run calculation to see orbital summary.</div>
          <div class="sg" id="sgOrbit"></div>
          <div id="pOrbit" class="pw"></div>
        </div>

        <div id="tab-trajectory" class="tc">
          <div class="sb" id="sbTraj">Run calculation to see trajectory data.</div>
          <div class="sg" id="sgTraj"></div>
          <div id="pTraj" class="pw"></div>
          <div style="margin-top:.58rem">
            <div class="pt" style="border-radius:3px 3px 0 0;margin-bottom:0">State Vectors at Key Points</div>
            <div class="dp" id="stateVec">&#8212;</div>
          </div>
        </div>

        <div id="tab-transfer" class="tc">
          <div class="sb" id="sbTx">Run calculation to see transfer analysis.</div>
