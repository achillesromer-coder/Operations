<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>Fluid Dynamics Calculator | Romer Industries</title>
<script src="https://cdn.plot.ly/plotly-2.27.0.min.js"></script>
<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap');
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{--bg:#0B0D10;--surface:#12151A;--panel:#161B22;--border:#1E2530;--copper:#B87333;--gold:#C9A24A;--teal:#4EC5C1;--cyan:#00E5FF;--ivory:#F2F1EC;--muted:#8A9BB0;--dim:#4A5568;--w1:#E53E3E;--w2:#DD6B20;--w3:#D69E2E;--w4:#38A169;--w5:#3182CE;--w6:#805AD5;--font-ui:'Inter',sans-serif;--font-mono:'JetBrains Mono',monospace}
html,body{width:100%;min-height:100vh;background:var(--bg);color:var(--ivory);font-family:var(--font-ui);font-size:14px;overflow-x:hidden}
.ops-tracker{display:flex;align-items:center;justify-content:space-between;background:var(--surface);border-bottom:1px solid var(--border);padding:0 16px;height:40px}
.ops-id{display:flex;align-items:center;gap:10px}
.ops-beacon{width:8px;height:8px;border-radius:50%;background:var(--copper);box-shadow:0 0 6px var(--copper);animation:pulse 2s infinite}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.4}}
.ops-title{font-family:var(--font-mono);font-size:11px;color:var(--teal);font-weight:600;letter-spacing:.05em}
.ops-sub{font-size:10px;color:var(--muted);font-family:var(--font-mono)}
.ops-nav{display:flex;gap:4px;align-items:center}
.ops-pill{font-family:var(--font-mono);font-size:9px;font-weight:700;padding:2px 7px;border-radius:3px;cursor:pointer;letter-spacing:.06em;text-decoration:none;border:1px solid transparent;transition:all .15s}
.ops-pill.calc{color:var(--gold);border-color:var(--gold);background:rgba(201,162,74,.08)}.ops-pill.calc:hover{background:rgba(201,162,74,.18)}.ops-pill.calc.active{background:rgba(201,162,74,.22)}
.ops-pill.w1{color:var(--w1);border-color:var(--w1);background:rgba(229,62,62,.06)}.ops-pill.w2{color:var(--w2);border-color:var(--w2);background:rgba(221,107,32,.06)}.ops-pill.w3{color:var(--w3);border-color:var(--w3);background:rgba(214,158,46,.06)}.ops-pill.w4{color:var(--w4);border-color:var(--w4);background:rgba(56,161,105,.06)}.ops-pill.w5{color:var(--w5);border-color:var(--w5);background:rgba(49,130,206,.06)}.ops-pill.w6{color:var(--w6);border-color:var(--w6);background:rgba(128,90,213,.06)}
.ops-pill.util{color:var(--muted);border-color:var(--dim);background:transparent}
.beacon-bar{background:var(--panel);border-bottom:1px solid var(--border);padding:5px 16px;display:flex;align-items:center;gap:10px}
.beacon-dot{width:6px;height:6px;border-radius:50%;background:#22c55e;box-shadow:0 0 5px #22c55e}
.beacon-text{font-family:var(--font-mono);font-size:9px;color:var(--muted)}.beacon-text span{color:var(--teal)}
.calc-header{padding:20px 24px 16px;border-bottom:1px solid var(--border)}
.calc-title{font-size:22px;font-weight:700;color:var(--copper);letter-spacing:-.01em;margin-bottom:4px}
.calc-desc{font-size:11px;color:var(--muted);line-height:1.5}
.calc-badges{display:flex;flex-wrap:wrap;gap:6px;margin-top:10px}
.badge{font-family:var(--font-mono);font-size:9px;font-weight:600;padding:3px 8px;border-radius:3px;letter-spacing:.04em}
.badge-ver{background:rgba(78,197,193,.1);color:var(--teal);border:1px solid rgba(78,197,193,.25)}.badge-tag{background:rgba(184,115,51,.1);color:var(--copper);border:1px solid rgba(184,115,51,.25)}.badge-util{background:rgba(138,155,176,.08);color:var(--muted);border:1px solid var(--dim)}
.calc-body{display:grid;grid-template-columns:280px 1fr;gap:0;min-height:calc(100vh - 120px)}
.config-panel{background:var(--surface);border-right:1px solid var(--border);overflow-y:auto}
.results-panel{background:var(--bg);overflow:hidden;display:flex;flex-direction:column}
.cfg-section{border-bottom:1px solid var(--border);padding:14px 16px}
.cfg-label{font-family:var(--font-mono);font-size:9px;font-weight:700;letter-spacing:.1em;color:var(--copper);text-transform:uppercase;margin-bottom:10px}
.cfg-field{margin-bottom:10px}.cfg-field label{display:block;font-size:10px;color:var(--muted);margin-bottom:4px;font-family:var(--font-mono)}
.cfg-field input,.cfg-field select{width:100%;background:var(--panel);border:1px solid var(--border);color:var(--ivory);font-family:var(--font-mono);font-size:11px;padding:6px 8px;border-radius:4px;outline:none;transition:border-color .2s}
.cfg-field input:focus,.cfg-field select:focus{border-color:var(--copper)}.cfg-field select option{background:var(--panel)}
.cfg-row{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.btn{font-family:var(--font-mono);font-size:10px;font-weight:700;letter-spacing:.06em;padding:8px 14px;border-radius:4px;border:none;cursor:pointer;transition:all .15s;text-transform:uppercase}
.btn-primary{background:linear-gradient(135deg,var(--copper),var(--gold));color:#0B0D10}.btn-primary:hover{opacity:.88}
.btn-secondary{background:transparent;color:var(--teal);border:1px solid var(--teal)}.btn-secondary:hover{background:rgba(78,197,193,.08)}
.btn-sm{padding:5px 10px;font-size:9px}.btn-full{width:100%}.btn-group{display:flex;gap:6px;width:100%}.btn-group .btn{flex:1}
.btn-row{display:flex;flex-wrap:wrap;gap:8px;padding:14px 16px;flex-direction:column}
.tab-bar{display:flex;background:var(--surface);border-bottom:1px solid var(--border);overflow-x:auto}
.tab{font-family:var(--font-mono);font-size:10px;font-weight:600;letter-spacing:.06em;padding:10px 16px;cursor:pointer;border-bottom:2px solid transparent;color:var(--muted);white-space:nowrap;transition:all .15s;text-transform:uppercase}
.tab.active{color:var(--copper);border-bottom-color:var(--copper)}.tab:hover:not(.active){color:var(--ivory)}
.tab-content{flex:1;overflow:hidden;display:none;padding:16px;flex-direction:column;gap:12px}.tab-content.active{display:flex}
.plot-container{background:var(--panel);border:1px solid var(--border);border-radius:6px;padding:12px}
.plot-title{font-family:var(--font-mono);font-size:9px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);margin-bottom:8px}
.stat-row{display:flex;justify-content:space-between;align-items:center;padding:5px 0;border-bottom:1px solid rgba(30,37,48,.5)}.stat-row:last-child{border-bottom:none}
.stat-label{font-size:10px;color:var(--muted);font-family:var(--font-mono)}.stat-val{font-family:var(--font-mono);font-size:11px;font-weight:700;color:var(--ivory)}
.stat-val.good{color:#22c55e}.stat-val.warn{color:var(--gold)}.stat-val.bad{color:#e53e3e}
.info-box{background:var(--panel);border:1px solid var(--border);border-left:3px solid var(--teal);border-radius:4px;padding:10px 14px;font-family:var(--font-mono);font-size:10px;color:var(--teal);line-height:1.6}
.info-box.warn{border-left-color:var(--gold);color:var(--gold)}.info-box.bad{border-left-color:#e53e3e;color:#e53e3e}
.export-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
.export-card{background:var(--panel);border:1px solid var(--border);border-radius:6px;padding:14px;text-align:center;cursor:pointer;transition:all .15s}
.export-card:hover{border-color:var(--copper)}.export-card .ec-icon{font-size:22px;margin-bottom:6px}
.export-card .ec-label{font-family:var(--font-mono);font-size:10px;font-weight:700;color:var(--ivory);margin-bottom:3px}.export-card .ec-desc{font-size:9px;color:var(--muted)}
::-webkit-scrollbar{width:5px;height:5px}::-webkit-scrollbar-track{background:var(--surface)}::-webkit-scrollbar-thumb{background:var(--dim);border-radius:3px}
@media(max-width:900px){.calc-body{grid-template-columns:1fr}}
</style>
</head>
<body>
<div class="ops-tracker">
  <div class="ops-id"><div class="ops-beacon"></div>
    <div><div class="ops-title">FLUID DYNAMICS CALCULATOR</div>
    <div class="ops-sub">Re · Pipe flow · Drag · Bernoulli · Compressible · Mach · Nozzle · Plotly visualisation · Universal tool /calc/fluid</div></div>
  </div>
  <nav class="ops-nav">
    <a class="ops-pill calc" href="/calc/orbital">ORB</a>
    <a class="ops-pill calc" href="/calc/launch">LW</a>
    <a class="ops-pill calc" href="/calc/magnetostatics">MAG</a>
    <a class="ops-pill calc" href="/calc/energy">PWR</a>
    <a class="ops-pill calc active" href="/calc/fluids">FLD</a>
    <a class="ops-pill sim" href="/sims/rfs-extraction">RFS</a>
    <a class="ops-pill sim" href="/sim/node">EMFF</a>
    <a class="ops-pill sim" href="/sim/fields">EMF</a>
    <a class="ops-pill sim" href="/sim/re-entry">ENTRY</a>
    <a class="ops-pill w1" href="/w1/data">W1</a>
    <a class="ops-pill w2" href="/w2/data">W2</a>
    <a class="ops-pill w3" href="/w3/data">W3</a>
    <a class="ops-pill w4" href="/w4/data">W4</a>
    <a class="ops-pill w5" href="/w5/data">W5</a>
    <a class="ops-pill w6" href="/w6/data">W6</a>
    <a class="ops-pill util" href="/data/achilles">ACH</a>
    <a class="ops-pill util" href="/library">LIB</a>
    <a class="ops-pill util" href="/gmat">GMAT</a>
    <a class="ops-pill util" href="/dash">DASH</a>
  </nav>
</div>
<div class="beacon-bar">
  <div class="beacon-dot"></div>
  <span class="beacon-text"><span>LIVE</span> &nbsp;/calc/fluid &nbsp;·&nbsp; Universal – callable by all workspaces &amp; dataspaces &nbsp;·&nbsp; Römer Industries / EMASSC</span>
</div>
<div class="calc-header">
  <div class="calc-title">Fluid Dynamics Calculator</div>
  <div class="calc-desc">Reynolds number · Pipe flow (Darcy-Weisbach) · Drag coefficients · Bernoulli equation · Compressible flow · Mach number · Nozzle design · Parameter sweeps</div>
  <div class="calc-badges">
    <span class="badge badge-ver"></span>
    <span class="badge badge-tag">SI Units</span>
    <span class="badge badge-tag">Universal Tool – W1-W6 callable</span>
    <span class="badge badge-tag">Plotly Visualisation</span>
    <span class="badge badge-util">JetBrains Mono · Inter</span>
  </div>
</div>
<div class="calc-body">
  <div class="config-panel">
    <div class="cfg-section">
      <div class="cfg-label">Analysis Mode</div>
      <div class="cfg-field"><label>Mode</label>
        <select id="fd-mode">
          <option value="pipe">Internal Pipe Flow</option>
          <option value="external">External Flow / Drag</option>
          <option value="bernoulli">Bernoulli / Venturi</option>
          <option value="compressible">Compressible Flow (Mach)</option>
          <option value="nozzle">Convergent-Divergent Nozzle</option>
        </select>
      </div>
    </div>
    <div class="cfg-section">
      <div class="cfg-label">Fluid Properties</div>
      <div class="cfg-field"><label>Fluid Preset</label>
        <select id="fd-fluid">
          <option value="air">Air (STP) — ρ=1.225, μ=1.81e-5</option>
          <option value="water">Water (20°C) — ρ=998, μ=1.0e-3</option>
          <option value="kerosene">RP-1 Kerosene — ρ=820, μ=1.9e-3</option>
          <option value="lox">LOX — ρ=1141, μ=1.9e-4</option>
          <option value="hydrogen">Liquid H₂ — ρ=70, μ=1.2e-5</option>
          <option value="custom">Custom</option>
        </select>
      </div>
      <div class="cfg-row">
        <div class="cfg-field"><label>Density ρ (kg/m³)</label><input type="number" id="fd-rho" value="1.225" step="0.001"></div>
        <div class="cfg-field"><label>Viscosity μ (Pa·s)</label><input type="number" id="fd-mu" value="1.81e-5" step="1e-6"></div>
      </div>
      <div class="cfg-row">
        <div class="cfg-field"><label>γ (ratio of specific heats)</label><input type="number" id="fd-gamma" value="1.4" step="0.01"></div>
        <div class="cfg-field"><label>Speed of Sound a (m/s)</label><input type="number" id="fd-a" value="340.3" step="0.1"></div>
      </div>
    </div>
    <div class="cfg-section" id="fd-params-pipe">
      <div class="cfg-label">Pipe Flow</div>
      <div class="cfg-field"><label>Flow Velocity U (m/s)</label><input type="number" id="fd-pipe-u" value="2.0" step="0.1"></div>
      <div class="cfg-field"><label>Pipe Diameter D (m)</label><input type="number" id="fd-pipe-d" value="0.05" step="0.001"></div>
      <div class="cfg-field"><label>Pipe Length L (m)</label><input type="number" id="fd-pipe-l" value="10" step="0.1"></div>
      <div class="cfg-field"><label>Roughness ε (m)</label><input type="number" id="fd-pipe-eps" value="4.6e-5" step="1e-6"></div>
      <div class="cfg-field"><label>Inlet Pressure P₁ (Pa)</label><input type="number" id="fd-pipe-p1" value="200000" step="1000"></div>
    </div>
    <div class="cfg-section" id="fd-params-external" style="display:none">
      <div class="cfg-label">External Flow</div>
      <div class="cfg-field"><label>Flow Velocity U∞ (m/s)</label><input type="number" id="fd-ext-u" value="50" step="1"></div>
      <div class="cfg-field"><label>Characteristic Length L (m)</label><input type="number" id="fd-ext-l" value="1.0" step="0.01"></div>
      <div class="cfg-field"><label>Reference Area A (m²)</label><input type="number" id="fd-ext-a" value="1.0" step="0.01"></div>
      <div class="cfg-field"><label>Body Shape</label>
        <select id="fd-shape">
          <option value="sphere">Sphere (Cd≈0.47)</option>
          <option value="cylinder">Cylinder (Cd≈1.0)</option>
          <option value="plate">Flat Plate (Cd≈1.28)</option>
          <option value="airfoil">Streamlined Body (Cd≈0.04)</option>
          <option value="reentry">Re-Entry Capsule (Cd≈1.3)</option>
        </select>
      </div>
    </div>
    <div class="cfg-section" id="fd-params-bernoulli" style="display:none">
      <div class="cfg-label">Bernoulli / Venturi</div>
      <div class="cfg-row">
        <div class="cfg-field"><label>U₁ (m/s)</label><input type="number" id="fd-b-u1" value="2" step="0.1"></div>
        <div class="cfg-field"><label>D₁ (m)</label><input type="number" id="fd-b-d1" value="0.1" step="0.001"></div>
      </div>
      <div class="cfg-row">
        <div class="cfg-field"><label>D₂ (m)</label><input type="number" id="fd-b-d2" value="0.05" step="0.001"></div>
        <div class="cfg-field"><label>P₁ (Pa)</label><input type="number" id="fd-b-p1" value="200000" step="1000"></div>
      </div>
      <div class="cfg-field"><label>Height Δz (m) [+upward]</label><input type="number" id="fd-b-dz" value="0" step="0.01"></div>
    </div>
    <div class="cfg-section" id="fd-params-compressible" style="display:none">
      <div class="cfg-label">Compressible Flow</div>
      <div class="cfg-field"><label>Mach Number M</label><input type="number" id="fd-mach" value="0.8" step="0.01" min="0"></div>
      <div class="cfg-field"><label>Stagnation Pressure P₀ (Pa)</label><input type="number" id="fd-comp-p0" value="101325" step="100"></div>
      <div class="cfg-field"><label>Stagnation Temp T₀ (K)</label><input type="number" id="fd-comp-t0" value="288.15" step="0.1"></div>
    </div>
    <div class="cfg-section" id="fd-params-nozzle" style="display:none">
      <div class="cfg-label">Nozzle Design</div>
      <div class="cfg-field"><label>Throat Area A* (m²)</label><input type="number" id="fd-noz-at" value="0.01" step="0.001"></div>
      <div class="cfg-field"><label>Exit Area Ae (m²)</label><input type="number" id="fd-noz-ae" value="0.04" step="0.001"></div>
      <div class="cfg-field"><label>Chamber Pressure P_c (Pa)</label><input type="number" id="fd-noz-pc" value="2000000" step="10000"></div>
      <div class="cfg-field"><label>Chamber Temp T_c (K)</label><input type="number" id="fd-noz-tc" value="3000" step="10"></div>
      <div class="cfg-field"><label>Molecular Weight M_w (g/mol)</label><input type="number" id="fd-noz-mw" value="22" step="0.1"></div>
    </div>
    <div class="cfg-section">
      <div class="cfg-label">Sweep</div>
      <div class="cfg-field"><label>Variable</label>
        <select id="fd-sweep-var">
          <option value="velocity">Flow Velocity (m/s)</option>
          <option value="diameter">Diameter (m)</option>
          <option value="viscosity">Viscosity (Pa·s)</option>
          <option value="mach">Mach Number</option>
          <option value="area_ratio">Nozzle Area Ratio</option>
        </select>
      </div>
      <div class="cfg-row">
        <div class="cfg-field"><label>Min</label><input type="number" id="fd-sweep-min" value="0.1" step="0.1"></div>
        <div class="cfg-field"><label>Max</label><input type="number" id="fd-sweep-max" value="50" step="1"></div>
      </div>
      <div class="cfg-field"><label>Steps</label><input type="number" id="fd-sweep-steps" value="25" step="1" min="5"></div>
    </div>
    <div class="btn-row">
      <button class="btn btn-primary btn-full" onclick="fdCalculate()">CALCULATE</button>
      <div class="btn-group">
        <button class="btn btn-secondary btn-sm" onclick="fdSweep()">RUN SWEEP</button>
        <button class="btn btn-secondary btn-sm" onclick="fdDemo()">DEMO</button>
      </div>
    </div>
  </div>
  <div class="results-panel">
    <div class="tab-bar">
      <div class="tab active" onclick="fdTab('results',this)">RESULTS</div>
      <div class="tab" onclick="fdTab('flow',this)">FLOW VIZ</div>
      <div class="tab" onclick="fdTab('profile',this)">PROFILES</div>
      <div class="tab" onclick="fdTab('sweep',this)">SWEEP</div>
      <div class="tab" onclick="fdTab('export',this)">EXPORT</div>
    </div>
    <div id="tab-results" class="tab-content active">
      <div class="info-box" id="fd-status">Select mode, configure parameters and click CALCULATE.</div>
      <div id="fd-stat-rows"></div>
    </div>
    <div id="tab-flow" class="tab-content">
      <div class="plot-container"><div class="plot-title">Flow Visualisation</div><div id="fd-flow-plot" style="height:380px"></div></div>
    </div>
    <div id="tab-profile" class="tab-content">
      <div class="plot-container"><div class="plot-title">Velocity / Pressure Profile</div><div id="fd-vel-plot" style="height:220px"></div></div>
      <div class="plot-container"><div class="plot-title">Re vs Velocity / Parameter Trend</div><div id="fd-re-plot" style="height:220px"></div></div>
    </div>
    <div id="tab-sweep" class="tab-content">
      <div class="info-box" id="fd-sweep-status">Run sweep to see results.</div>
      <div class="plot-container"><div class="plot-title">Sweep Results</div><div id="fd-sweep-plot" style="height:260px"></div></div>
      <div style="overflow-x:auto;max-height:280px"><table id="fd-sweep-table" style="width:100%;border-collapse:collapse;font-family:var(--font-mono);font-size:10px"></table></div>
    </div>
    <div id="tab-export" class="tab-content">
      <div class="info-box">Export fluid dynamics data to workspace dataspaces or download files.</div>
      <div class="export-grid">
        <div class="export-card" onclick="fdExport('json')"><div class="ec-icon">📦</div><div class="ec-label">JSON</div><div class="ec-desc">Full data object</div></div>
        <div class="export-card" onclick="fdExport('csv')"><div class="ec-icon">📊</div><div class="ec-label">CSV</div><div class="ec-desc">Results table</div></div>
        <div class="export-card" onclick="fdExport('txt')"><div class="ec-icon">📄</div><div class="ec-label">MANIFEST</div><div class="ec-desc">Flow report</div></div>
        <div class="export-card" onclick="fdExport('yaml')"><div class="ec-icon">🗂️</div><div class="ec-label">YAML</div><div class="ec-desc">Config</div></div>
        <div class="export-card" onclick="fdExport('png')"><div class="ec-icon">🖼️</div><div class="ec-label">PNG</div><div class="ec-desc">All charts</div></div>
        <div class="export-card" onclick="fdExport('gmat')"><div class="ec-icon">🛰️</div><div class="ec-label">GMAT</div><div class="ec-desc">Propulsion ref</div></div>
      </div>
      <div style="margin-top:12px">
        <div style="font-family:var(--font-mono);font-size:10px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);margin-bottom:8px">Send to Dataspace</div>
        <div style="display:flex;flex-wrap:wrap;gap:8px">
          <button class="btn btn-secondary btn-sm" onclick="fdRoute('w1')">→ W1</button><button class="btn btn-secondary btn-sm" onclick="fdRoute('w2')">→ W2</button>
          <button class="btn btn-secondary btn-sm" onclick="fdRoute('w3')">→ W3</button><button class="btn btn-secondary btn-sm" onclick="fdRoute('w4')">→ W4</button>
          <button class="btn btn-secondary btn-sm" onclick="fdRoute('w5')">→ W5</button><button class="btn btn-secondary btn-sm" onclick="fdRoute('w6')">→ W6</button>
          <button class="btn btn-primary btn-sm" onclick="fdRouteAll()">→ ALL</button>
        </div>
        <div id="fd-route-status" style="margin-top:10px;display:none"></div>
      </div>
    </div>
  </div>
</div>
<script>
// ═══ FLUID DYNAMICS CALCULATOR  ════════════
const FD_FLUID = {
  air:{rho:1.225,mu:1.81e-5,a:340.3,gamma:1.4},
  water:{rho:998,mu:1e-3,a:1481,gamma:7.0},
  kerosene:{rho:820,mu:1.9e-3,a:1324,gamma:1.13},
  lox:{rho:1141,mu:1.9e-4,a:900,gamma:1.35},
  hydrogen:{rho:70,mu:1.2e-5,a:1270,gamma:1.41},
};
const FD_CD = {sphere:0.47,cylinder:1.0,plate:1.28,airfoil:0.04,reentry:1.3};
let FD_STATE = null;

const FPLT = {
  base:{paper_bgcolor:'#12151A',plot_bgcolor:'#0B0D10',font:{family:"'JetBrains Mono',monospace",color:'#F2F1EC',size:10},margin:{t:30,r:20,b:40,l:50},xaxis:{gridcolor:'#1E2530',zerolinecolor:'#1E2530',tickfont:{size:9}},yaxis:{gridcolor:'#1E2530',zerolinecolor:'#1E2530',tickfont:{size:9}},hoverlabel:{bgcolor:'#161B22',bordercolor:'#B87333',font:{family:"'JetBrains Mono',monospace",size:10,color:'#F2F1EC'}},modebar:{bgcolor:'transparent',color:'#4A5568',activecolor:'#B87333'}},
  cfg:{responsive:true,displayModeBar:true,displaylogo:false,modeBarButtonsToRemove:['select2d','lasso2d'],toImageButtonOptions:{format:'png',filename:'romer-fd',scale:2}}
};

// ── Physics ───────────────────────────────────────
function reynolds(rho, u, L, mu) { return rho*u*L/mu; }
function frictionFactor(Re, D, eps) {
  if (Re < 2300) return 64/Re; // Laminar
  // Colebrook-White (iterative)
  const ed = eps/D;
  let f = 0.02;
  for (let i=0; i<50; i++) f = Math.pow(-2*Math.log10(ed/3.7+2.51/(Re*Math.sqrt(f))), -2);
  return f;
}
function darcyWeisbach(f, L, D, u, rho) { return f*(L/D)*0.5*rho*u*u; }
function bernoulli2(rho, u1, d1, d2, p1, g, dz) {
  const u2 = u1*(d1/d2)*(d1/d2);
  const p2 = p1 + 0.5*rho*(u1*u1-u2*u2) - rho*g*dz;
  return {u2, p2, dP: p1-p2};
}
function dragForce(cd, rho, u, A) { return 0.5*rho*u*u*cd*A; }
function machCompressible(M, gamma, p0, T0) {
  const base = 1 + (gamma-1)/2*M*M;
  const p = p0 * Math.pow(base, -gamma/(gamma-1));
  const T = T0 / base;
  const rho_ratio = Math.pow(base, -1/(gamma-1));
  const a = Math.sqrt(gamma*287*T);
  const v = M * a;
  return {p, T, rho_ratio, a, v, base};
}
function nozzleMach(areaRatio, gamma, supersonic=true) {
  // Solve area-Mach relation iteratively
  let M = supersonic ? 2.0 : 0.5;
  for (let i=0; i<100; i++) {
    const b = 1 + (gamma-1)/2*M*M;
    const A_Astar = (1/M)*Math.pow(2*b/(gamma+1),(gamma+1)/(2*(gamma-1)));
    const dF = (1/M*((1+(gamma-1)/2*M*M)/(1+(gamma-1)/2))-areaRatio)*0.1;
    const err = A_Astar - areaRatio;
    if (Math.abs(err) < 1e-8) break;
    M -= err * 0.1;
    if (M < 0.01) M = 0.01;
  }
  return M;
}

// ── Tab ───────────────────────────────────────────
function fdTab(name, el) {
  document.querySelectorAll('.tab').forEach(t=>t.classList.remove('active'));
  document.querySelectorAll('.tab-content').forEach(c=>c.classList.remove('active'));
  el.classList.add('active');
  document.getElementById('tab-'+name).classList.add('active');
  setTimeout(()=>['fd-flow-plot','fd-vel-plot','fd-re-plot','fd-sweep-plot'].forEach(id=>{try{Plotly.Plots.resize(document.getElementById(id));}catch(e){}}),50);
}

// ── Fluid preset ──────────────────────────────────
function fdFluidPreset() {
  const key = document.getElementById('fd-fluid').value;
  const f = FD_FLUID[key]; if (!f) return;
  document.getElementById('fd-rho').value = f.rho;
  document.getElementById('fd-mu').value = f.mu;
  document.getElementById('fd-gamma').value = f.gamma;
  document.getElementById('fd-a').value = f.a;
}

// ── Mode switcher ─────────────────────────────────
function fdModeSwitch() {
  const mode = document.getElementById('fd-mode').value;
  ['pipe','external','bernoulli','compressible','nozzle'].forEach(m=>{
    const el=document.getElementById('fd-params-'+m);
    if(el) el.style.display=(m===mode)?'':'none';
  });
}

// ── Main calculate ────────────────────────────────
function fdCalculate() {
  const mode = document.getElementById('fd-mode').value;
  const rho = +document.getElementById('fd-rho').value;
  const mu  = +document.getElementById('fd-mu').value;
  const gam = +document.getElementById('fd-gamma').value;
  const a   = +document.getElementById('fd-a').value;
  let results = {mode, rho, mu, timestamp: new Date().toISOString()};

  if (mode === 'pipe') {
    const u = +document.getElementById('fd-pipe-u').value;
    const D = +document.getElementById('fd-pipe-d').value;
    const L = +document.getElementById('fd-pipe-l').value;
    const eps = +document.getElementById('fd-pipe-eps').value;
    const p1 = +document.getElementById('fd-pipe-p1').value;
    const Re = reynolds(rho, u, D, mu);
    const f  = frictionFactor(Re, D, eps);
    const dP = darcyWeisbach(f, L, D, u, rho);
    const regime = Re < 2300 ? 'LAMINAR' : Re < 4000 ? 'TRANSITIONAL' : 'TURBULENT';
    const q = Math.PI*D*D/4*u;
    results = {...results, u, D, L, eps, Re, f, dP, p2:p1-dP, regime, q,
      stats:[['Reynolds Number',Re.toFixed(0)],['Flow Regime',regime],['Friction Factor f',f.toFixed(5)],['Pressure Drop ΔP',dP.toFixed(2)+' Pa'],['Outlet Pressure P₂',(p1-dP).toFixed(2)+' Pa'],['Volumetric Flow Q',(q*1000).toFixed(4)+' L/s'],['Wall Shear τ',(f*0.5*rho*u*u/4).toFixed(4)+' Pa'],['Mass Flow ṁ',(rho*q).toFixed(4)+' kg/s']]};
  } else if (mode === 'external') {
    const u = +document.getElementById('fd-ext-u').value;
    const L = +document.getElementById('fd-ext-l').value;
    const A = +document.getElementById('fd-ext-a').value;
    const shape = document.getElementById('fd-shape').value;
    const Cd = FD_CD[shape] || 0.5;
    const Re = reynolds(rho, u, L, mu);
    const Fd = dragForce(Cd, rho, u, A);
    const M = u/a;
    results = {...results, u, L, A, shape, Re, Cd, Fd, M,
      stats:[['Reynolds Number',Re.toExponential(3)],['Mach Number',M.toFixed(3)],['Drag Coeff Cd',Cd.toString()],['Drag Force Fd',Fd.toFixed(2)+' N'],['Dynamic Pressure q',(0.5*rho*u*u).toFixed(2)+' Pa'],['Flow Regime',Re<5e5?'LAMINAR':'TURBULENT']]};
  } else if (mode === 'bernoulli') {
    const u1=+document.getElementById('fd-b-u1').value, d1=+document.getElementById('fd-b-d1').value, d2=+document.getElementById('fd-b-d2').value, p1=+document.getElementById('fd-b-p1').value, dz=+document.getElementById('fd-b-dz').value;
    const b = bernoulli2(rho, u1, d1, d2, p1, 9.81, dz);
    const q = Math.PI*d1*d1/4*u1;
    results = {...results, u1, d1, d2, p1, dz, ...b, q,
      stats:[['Inlet Velocity U₁',u1.toFixed(3)+' m/s'],['Outlet Velocity U₂',b.u2.toFixed(3)+' m/s'],['Inlet Pressure P₁',p1.toFixed(0)+' Pa'],['Outlet Pressure P₂',b.p2.toFixed(0)+' Pa'],['Pressure Drop ΔP',b.dP.toFixed(0)+' Pa'],['Volumetric Flow Q',(q*1000).toFixed(4)+' L/s'],['Area Ratio A₁/A₂',((d1/d2)**2).toFixed(3)]]};
  } else if (mode === 'compressible') {
    const M=+document.getElementById('fd-mach').value, p0=+document.getElementById('fd-comp-p0').value, T0=+document.getElementById('fd-comp-t0').value;
    const c = machCompressible(M, gam, p0, T0);
    const regime = M<0.3?'INCOMPRESSIBLE':M<0.8?'SUBSONIC':M<1.0?'HIGH SUBSONIC':M===1?'SONIC':M<1.2?'TRANSONIC':M<5?'SUPERSONIC':'HYPERSONIC';
    results = {...results, M, p0, T0, ...c, regime,
      stats:[['Mach Number M',M.toFixed(3)],['Regime',regime],['Static Pressure P',c.p.toFixed(1)+' Pa'],['Static Temp T',c.T.toFixed(2)+' K'],['Flow Velocity v',c.v.toFixed(2)+' m/s'],['Local Speed of Sound a',c.a.toFixed(2)+' m/s'],['P/P₀ ratio',(c.p/p0).toFixed(4)],['T/T₀ ratio',(c.T/T0).toFixed(4)],['Dynamic Pressure q',(0.5*rho*c.v*c.v).toFixed(2)+' Pa']]};
  } else if (mode === 'nozzle') {
    const At=+document.getElementById('fd-noz-at').value, Ae=+document.getElementById('fd-noz-ae').value, Pc=+document.getElementById('fd-noz-pc').value, Tc=+document.getElementById('fd-noz-tc').value, Mw=+document.getElementById('fd-noz-mw').value;
    const R = 8314/Mw;
    const arat = Ae/At;
    const Me = nozzleMach(arat, gam, true);
    const comp = machCompressible(Me, gam, Pc, Tc);
    const ve = Me * comp.a;
    const mdot = Pc*At*Math.sqrt(gam/(R*Tc))*Math.pow(2/(gam+1),(gam+1)/(2*(gam-1)));
    const thrust = mdot*ve + (comp.p - 101325)*Ae;
    const Isp = thrust/(mdot*9.81);
    results = {...results, At, Ae, Pc, Tc, Mw, arat, Me, ve, mdot, thrust, Isp, exitP:comp.p,
      stats:[['Area Ratio Ae/At',arat.toFixed(3)],['Exit Mach Me',Me.toFixed(4)],['Exit Velocity ve',ve.toFixed(2)+' m/s'],['Exit Pressure Pe',comp.p.toFixed(0)+' Pa'],['Exit Temp Te',comp.T.toFixed(1)+' K'],['Mass Flow ṁ',mdot.toFixed(4)+' kg/s'],['Thrust F',thrust.toFixed(2)+' N'],['Specific Impulse Isp',Isp.toFixed(1)+' s']]};
  }

  FD_STATE = results;
  renderStatRows(results.stats || []);
  renderFlowViz(results);
  renderProfiles(results);

  const cls = results.regime === 'TURBULENT' || results.regime === 'HYPERSONIC' ? 'warn' : '';
  const el = document.getElementById('fd-status');
  el.className = 'info-box ' + cls;
  el.textContent = `Mode: ${mode} · ${(results.stats||[]).map(r=>r[0]+': '+r[1]).slice(0,3).join(' · ')}`;

  try {['w1','w2'].forEach(ws=>localStorage.setItem(`achilles_calc_fd_${ws}`,JSON.stringify({calculator:'fluid_dynamics',version:'2.0.0',timestamp:results.timestamp,mode,Re:results.Re,regime:results.regime})));}catch(e){}
}

function renderStatRows(rows) {
  document.getElementById('fd-stat-rows').innerHTML = rows.map(([l,v])=>
    `<div class="stat-row"><span class="stat-label">${l}</span><span class="stat-val">${v}</span></div>`
  ).join('');
}

function renderFlowViz(r) {
  if (r.mode === 'pipe') {
    const N=30, ys=Array.from({length:N},(_,i)=>-1+2*i/(N-1));
    const uProfile = ys.map(y => r.regime==='LAMINAR' ? r.u*(1-(y*r.D/2)*(y*r.D/2)/((r.D/2)*(r.D/2))) : r.u*Math.pow(1-Math.abs(y),1/7));
    const xs=Array.from({length:50},(_,i)=>i*r.L/49);
    Plotly.react('fd-flow-plot',[
      {type:'scatter',mode:'lines',x:xs,y:xs.map(x=>r.p1-(r.dP/r.L)*x),line:{color:'#B87333',width:2},name:'Pressure (Pa)',hovertemplate:'x:%{x:.1f} m<br>P:%{y:.0f} Pa<extra></extra>'},
      {type:'scatter',mode:'lines',x:uProfile,y:ys.map(y=>y*r.D*1000),line:{color:'#4EC5C1',width:2},name:'Velocity Profile',xaxis:'x2',yaxis:'y2'}
    ],{...FPLT.base,height:370,xaxis:{...FPLT.base.xaxis,title:{text:'Pipe Length (m)',font:{size:9}},domain:[0,0.55]},yaxis:{...FPLT.base.yaxis,title:{text:'Pressure (Pa)',font:{size:9}}},xaxis2:{title:{text:'U (m/s)',font:{size:9}},overlaying:'x',side:'top',domain:[0.6,1],gridcolor:'#1E2530',tickfont:{size:9}},yaxis2:{title:{text:'r (mm)',font:{size:9}},overlaying:'y',side:'right',gridcolor:'transparent',tickfont:{size:9}}},FPLT.cfg);
  } else if (r.mode === 'compressible') {
    const Ms=Array.from({length:100},(_,i)=>0.1+4.9*i/99);
    const ps=Ms.map(M=>machCompressible(M,r.gamma||1.4,r.p0,r.T0).p/r.p0);
    const Ts=Ms.map(M=>machCompressible(M,r.gamma||1.4,r.p0,r.T0).T/r.T0);
    Plotly.react('fd-flow-plot',[
      {type:'scatter',mode:'lines',x:Ms,y:ps,line:{color:'#B87333',width:2},name:'P/P₀',hovertemplate:'M:%{x:.3f}<br>P/P₀:%{y:.4f}<extra></extra>'},
      {type:'scatter',mode:'lines',x:Ms,y:Ts,line:{color:'#4EC5C1',width:2,dash:'dot'},name:'T/T₀'},
    ],{...FPLT.base,height:370,xaxis:{...FPLT.base.xaxis,title:{text:'Mach Number M',font:{size:9}}},yaxis:{...FPLT.base.yaxis,title:{text:'P/P₀, T/T₀',font:{size:9}}},shapes:[{type:'line',x0:r.M,x1:r.M,y0:0,y1:1,line:{color:'#C9A24A',width:1.5,dash:'dash'}}],annotations:[{x:r.M+0.05,y:0.9,text:'M='+r.M.toFixed(2),showarrow:false,font:{size:9,color:'#C9A24A'}}]},FPLT.cfg);
  } else if (r.mode === 'nozzle') {
    const xs=Array.from({length:100},(_,i)=>-1+2*i/99);
    const areas=xs.map(x=>1+3*(x*x)); // Parabolic nozzle shape
    const Mline=xs.map(x=>{const ar=areas[x<0?xs.indexOf(x):xs.indexOf(x)];try{return x<0?nozzleMach(Math.max(1.001,ar),r.gamma||1.4,false):nozzleMach(Math.max(1.001,ar),r.gamma||1.4,true);}catch(e){return x<0?0.5:1.5;}});
    Plotly.react('fd-flow-plot',[
      {type:'scatter',mode:'lines',x:xs,y:areas,line:{color:'#4EC5C1',width:2},name:'Area A/A*',fill:'tozeroy',fillcolor:'rgba(78,197,193,0.06)'},
      {type:'scatter',mode:'lines',x:xs,y:Mline,line:{color:'#B87333',width:2},name:'Mach M',yaxis:'y2'},
    ],{...FPLT.base,height:370,xaxis:{...FPLT.base.xaxis,title:{text:'Nozzle Position (normalised)',font:{size:9}}},yaxis:{...FPLT.base.yaxis,title:{text:'A/A*',font:{size:9}}},yaxis2:{title:{text:'Mach M',font:{size:9},color:'#B87333'},overlaying:'y',side:'right',gridcolor:'transparent',tickfont:{size:9,color:'#B87333'}}},FPLT.cfg);
  } else {
    Plotly.react('fd-flow-plot',[{type:'scatter',mode:'lines',x:[0],y:[0],name:'No viz for this mode'}],FPLT.base,FPLT.cfg);
  }
}

function renderProfiles(r) {
  if (r.mode === 'pipe') {
    const N=60,ys=Array.from({length:N},(_,i)=>-1+2*i/(N-1));
    const uP=ys.map(y=>r.regime==='LAMINAR'?r.u*(1-y*y):r.u*Math.pow(1-Math.abs(y),1/7));
    Plotly.react('fd-vel-plot',[{type:'scatter',mode:'lines',x:uP,y:ys.map(y=>y*r.D*500),line:{color:'#B87333',width:2},fill:'tozerox',fillcolor:'rgba(184,115,51,0.08)',hovertemplate:'U:%{x:.3f} m/s<br>r:%{y:.1f} mm<extra></extra>',name:'Velocity'}],{...FPLT.base,height:200,xaxis:{...FPLT.base.xaxis,title:{text:'U (m/s)',font:{size:9}}},yaxis:{...FPLT.base.yaxis,title:{text:'r (mm)',font:{size:9}}}},FPLT.cfg);
  } else {
    Plotly.react('fd-vel-plot',[{type:'scatter',mode:'lines',x:[0],y:[0],name:''}],FPLT.base,FPLT.cfg);
  }
  // Re vs velocity
  const us=Array.from({length:50},(_,i)=>0.1+i*2);
  const Re_base = +document.getElementById('fd-rho').value * (+document.getElementById('fd-pipe-d').value||+document.getElementById('fd-ext-l').value||0.05) / +document.getElementById('fd-mu').value;
  const Res=us.map(u=>Re_base*u);
  Plotly.react('fd-re-plot',[{type:'scatter',mode:'lines',x:us,y:Res,line:{color:'#4EC5C1',width:2},hovertemplate:'U:%{x:.1f} m/s<br>Re:%{y:.0f}<extra></extra>',name:'Reynolds Number'}],{...FPLT.base,height:200,xaxis:{...FPLT.base.xaxis,title:{text:'Velocity (m/s)',font:{size:9}}},yaxis:{...FPLT.base.yaxis,title:{text:'Reynolds Number',font:{size:9}}},shapes:[{type:'line',x0:0,x1:50,y0:2300,y1:2300,line:{color:'#22c55e',width:1,dash:'dash'}},{type:'line',x0:0,x1:50,y0:4000,y1:4000,line:{color:'#e53e3e',width:1,dash:'dash'}}],annotations:[{x:2,y:2500,text:'Lam→Trans',showarrow:false,font:{size:8,color:'#22c55e'}},{x:2,y:4300,text:'Trans→Turb',showarrow:false,font:{size:8,color:'#e53e3e'}}]},FPLT.cfg);
}

function fdSweep() {
  const varName=document.getElementById('fd-sweep-var').value;
  const min=+document.getElementById('fd-sweep-min').value;
  const max=+document.getElementById('fd-sweep-max').value;
  const steps=+document.getElementById('fd-sweep-steps').value;
  const rho=+document.getElementById('fd-rho').value, mu=+document.getElementById('fd-mu').value;
  const results=[];
  for(let i=0;i<steps;i++){
    const val=min+(max-min)*i/(steps-1);
    if(varName==='velocity'||varName==='diameter'){
      const u=varName==='velocity'?val:2, D=varName==='diameter'?val:0.05;
      const Re=reynolds(rho,u,D,mu);
      const f=frictionFactor(Re,D,4.6e-5);
      const dP=darcyWeisbach(f,10,D,u,rho);
      results.push({var:val,Re:Re.toFixed(0),regime:Re<2300?'LAM':Re<4000?'TRANS':'TURB',f:f.toFixed(5),dP:dP.toFixed(2)});
    } else if(varName==='mach'){
      const c=machCompressible(val,+document.getElementById('fd-gamma').value,101325,288.15);
      results.push({var:val,Re:'—',regime:val<0.3?'INCOMP':val<1?'SUBSONIC':val<5?'SUPERSONIC':'HYPERSONIC',f:(c.p/101325).toFixed(4),dP:c.T.toFixed(2)});
    } else {
      results.push({var:val,Re:'—',regime:'—',f:'—',dP:'—'});
    }
  }
  const xLabel={velocity:'U (m/s)',diameter:'D (m)',viscosity:'μ (Pa·s)',mach:'Mach M',area_ratio:'Ae/At'}[varName];
  const isRe=varName!=='mach';
  Plotly.react('fd-sweep-plot',[{type:'scatter',mode:'lines+markers',x:results.map(r=>+r.var),y:results.map(r=>isRe?+r.Re:+r.f),line:{color:'#B87333',width:2},marker:{size:4},name:isRe?'Reynolds Number':'P/P₀',hovertemplate:'%{x:.2f}<br>%{y:.2f}<extra></extra>'}],{...FPLT.base,height:250,xaxis:{...FPLT.base.xaxis,title:{text:xLabel,font:{size:9}}},yaxis:{...FPLT.base.yaxis,title:{text:isRe?'Re':'Value',font:{size:9}}}},FPLT.cfg);
  document.getElementById('fd-sweep-table').innerHTML=`<thead><tr>${['#',xLabel,'Re','Regime','f / P/P₀','ΔP / T'].map(h=>`<th style="background:#12151A;color:#8A9BB0;padding:5px 8px;border-bottom:1px solid #1E2530;font-size:9px">${h}</th>`).join('')}</tr></thead><tbody>${results.map((r,i)=>`<tr><td style="padding:4px 8px;font-size:10px">${i+1}</td><td style="padding:4px 8px;font-family:var(--font-mono);font-size:10px">${typeof r.var==='number'?r.var.toFixed(2):r.var}</td><td style="padding:4px 8px;font-family:var(--font-mono);font-size:10px">${r.Re}</td><td style="padding:4px 8px;font-family:var(--font-mono);font-size:10px;color:${r.regime==='LAM'?'#22c55e':r.regime==='TURB'?'#e53e3e':'#C9A24A'}">${r.regime}</td><td style="padding:4px 8px;font-family:var(--font-mono);font-size:10px">${r.f}</td><td style="padding:4px 8px;font-family:var(--font-mono);font-size:10px">${r.dP}</td></tr>`).join('')}</tbody>`;
  document.getElementById('fd-sweep-status').textContent=`Sweep: ${steps} points · ${varName}`;
  fdTab('sweep',document.querySelector('.tab:nth-child(4)'));
}

function fdDemo(){document.getElementById('fd-mode').value='nozzle';fdModeSwitch();document.getElementById('fd-fluid').value='air';fdFluidPreset();document.getElementById('fd-noz-at').value=0.05;document.getElementById('fd-noz-ae').value=0.3;document.getElementById('fd-noz-pc').value=3000000;document.getElementById('fd-noz-tc').value=3500;document.getElementById('fd-noz-mw').value=20;fdCalculate();}

function fdExport(type){
  if(!FD_STATE&&type!=='png'){alert('Run calculation first.');return;}
  if(type==='png'){['fd-flow-plot','fd-vel-plot','fd-re-plot','fd-sweep-plot'].forEach((id,i)=>{const el=document.getElementById(id);if(el&&el.data)setTimeout(()=>Plotly.downloadImage(id,{format:'png',filename:`romer-fd-${id}`,width:800,height:500,scale:2}),i*500);});return;}
  const s=FD_STATE;let content='',filename='',mime='';
  if(type==='json'){content=JSON.stringify(s,null,2);filename='romer-fd.json';mime='application/json';}
  else if(type==='csv'){content='parameter,value\n'+(s.stats||[]).map(r=>r.join(',')).join('\n');filename='romer-fd.csv';mime='text/csv';}
  else if(type==='txt'){content=`RÖMER FLUID DYNAMICS REPORT \nMode: ${s.mode}\nTimestamp: ${s.timestamp}\n\n${(s.stats||[]).map(r=>r[0]+': '+r[1]).join('\n')}\n`;filename='romer-fd.txt';mime='text/plain';}
  else if(type==='yaml'){content=`romer_fluid_dynamics:\n  version: 2.0.0\n  mode: ${s.mode}\n  timestamp: ${s.timestamp}\n${(s.stats||[]).map(r=>'  '+r[0].replace(/[^a-zA-Z0-9]/g,'_').toLowerCase()+': '+r[1]).join('\n')}\n`;filename='romer-fd.yaml';mime='text/yaml';}
  else if(type==='gmat'){content=`% GMAT Propulsion Reference\n% Römer Fluid Dynamics \n% Mode: ${s.mode}\n${s.mode==='nozzle'?`% Exit Mach: ${s.Me?.toFixed(3)}\n% Ve: ${s.ve?.toFixed(2)} m/s\n% Isp: ${s.Isp?.toFixed(1)} s\n% Thrust: ${s.thrust?.toFixed(2)} N\n`:''}\nCreate Spacecraft SC;\n`;filename='romer-fd.script';mime='text/plain';}
  const blob=new Blob([content],{type:mime});const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=filename;a.click();
}
