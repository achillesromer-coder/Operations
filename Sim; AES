// Vehicle preset
document.getElementById('cVehicle').addEventListener('change', function() {
  applyVehiclePreset(this.value);
});

// Compute
document.getElementById('btnCompute').addEventListener('click', doCompute);

// Run sim = compute then play
document.getElementById('btnRun').addEventListener('click', function() {
  doCompute();
  setTimeout(function() {
    if(simData) {
      isPlaying = true;
      document.getElementById('pbStatus').textContent = 'PLAYING...';
      animStep();
    }
  }, 300);
});

// Reset
document.getElementById('btnReset').addEventListener('click', doReset);

// Playback controls
document.getElementById('pbPlay').addEventListener('click', function() {
  if(!simData) { alert('Run COMPUTE first'); return; }
  if(animIdx >= simData.traj.length-1) animIdx = 0;
  isPlaying = true;
  document.getElementById('pbStatus').textContent = 'PLAYING...';
  animStep();
});

document.getElementById('pbPause').addEventListener('click', function() {
  isPlaying = false;
  if(animFrame) { cancelAnimationFrame(animFrame); animFrame = null; }
  document.getElementById('pbStatus').textContent = 'PAUSED at T+' + (simData && simData.traj[animIdx] ? simData.traj[animIdx].t.toFixed(1) : '0') + 's';
});

document.getElementById('pbStep').addEventListener('click', function() {
  if(!simData) return;
  isPlaying = false;
  if(animFrame) { cancelAnimationFrame(animFrame); animFrame = null; }
  animIdx = Math.min(animIdx + 1, simData.traj.length - 1);
  const pt = simData.traj[animIdx];
  updateTelemUI(pt);
  const pct = animIdx / (simData.traj.length-1) * 100;
  document.getElementById('pbProg').style.width = pct + '%';
  document.getElementById('pbTime').textContent = 'T+' + pt.t.toFixed(1) + 's';
});

document.getElementById('pbRewind').addEventListener('click', doReset);

