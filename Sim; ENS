        <div style="display:flex;flex-direction:column">
          <div id="plot-sweep" style="flex:1;min-height:300px"></div>
          <div class="table-wrap"><table class="data-table"><thead><tr><th>INPUT</th><th>OUTPUT</th></tr></thead><tbody id="sweep-tbody"></tbody></table></div>
