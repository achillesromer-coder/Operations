<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0"><title>EMFF Node — Electromagnetic Formation Flight | Römer Industries</title>
<script src="https://cdn.plot.ly/plotly-2.27.0.min.js"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#0B0D10;--surface:#12151A;--surface2:#1A1E25;--surface3:#222831;
  --copper:#B87333;--gold:#C9A24A;--teal:#4EC5C1;--cyan:#00E5FF;
  --ivory:#F2F1EC;--muted:#8A8F9A;--border:#2A2F3A;
  --font-ui:'Inter',system-ui,sans-serif;--font-data:'JetBrains Mono',monospace;
}
html,body{background:var(--bg);color:var(--ivory);font-family:var(--font-ui);font-size:13px;height:100%;overflow-x:hidden}
.ops-tracker{display:flex;align-items:center;justify-content:space-between;padding:7px 14px;background:#0A0C0F;border-bottom:1px solid var(--border);flex-wrap:wrap;gap:6px;position:sticky;top:0;z-index:100}
.ops-beacon{display:flex;align-items:center;gap:8px}
.beacon-dot{width:8px;height:8px;border-radius:50%;background:var(--teal);box-shadow:0 0 6px var(--teal);animation:pulse 2s infinite}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:0.4}}
.ops-title{font-family:var(--font-data);font-size:11px;font-weight:700;color:var(--copper);letter-spacing:1.5px;text-transform:uppercase}
.ops-desc{font-family:var(--font-data);font-size:9px;color:var(--muted);letter-spacing:0.5px}
.ops-nav{display:flex;gap:4px;flex-wrap:wrap;align-items:center}
.nav-pill{font-family:var(--font-data);font-size:9px;font-weight:700;padding:3px 7px;border-radius:3px;border:1px solid var(--border);color:var(--muted);cursor:pointer;text-decoration:none;letter-spacing:0.8px;transition:all 0.2s;background:transparent}
.nav-pill:hover{border-color:var(--copper);color:var(--copper)}
.nav-pill.active{background:var(--copper);color:#0B0D10;border-color:var(--copper)}
.nav-pill.w-pill{border-color:#2A3040;color:#4A5060}
.nav-pill.w-pill:hover{border-color:var(--teal);color:var(--teal)}
.beacon-bar{background:#090B0E;border-bottom:1px solid var(--border);padding:4px 14px;display:flex;align-items:center;gap:10px}
.beacon-live{font-family:var(--font-data);font-size:9px;color:var(--teal);font-weight:700;letter-spacing:1px}
.beacon-path{font-family:var(--font-data);font-size:9px;color:var(--muted)}
.beacon-sep{color:var(--border)}
.beacon-brand{font-family:var(--font-data);font-size:9px;color:var(--copper)}
.sim-header{padding:14px 18px 10px;border-bottom:1px solid var(--border);background:var(--surface)}
.sim-title{font-family:var(--font-ui);font-size:20px;font-weight:700;color:var(--copper);letter-spacing:0.5px;margin-bottom:3px}
.sim-desc{font-size:11px;color:var(--muted);margin-bottom:8px}
.sim-badges{display:flex;gap:6px;flex-wrap:wrap}
.badge{font-family:var(--font-data);font-size:9px;padding:2px 8px;border-radius:2px;border:1px solid var(--border);color:var(--muted)}
.badge.teal{border-color:var(--teal);color:var(--teal)}
.badge.copper{border-color:var(--copper);color:var(--copper)}
.badge.gold{border-color:var(--gold);color:var(--gold)}
.telem-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--border);border-bottom:1px solid var(--border)}
.telem-cell{background:var(--surface2);padding:8px 10px}
.telem-label{font-family:var(--font-data);font-size:8px;color:var(--muted);letter-spacing:0.8px;text-transform:uppercase;margin-bottom:2px}
.telem-val{font-family:var(--font-data);font-size:18px;font-weight:700;color:var(--teal);line-height:1}
.telem-unit{font-family:var(--font-data);font-size:9px;color:var(--muted)}
.telem-cell.warning .telem-val{color:var(--gold)}
.sim-body{display:grid;grid-template-columns:260px 1fr;height:calc(100vh - 115px);min-height:580px}
.sim-controls{background:var(--surface);border-right:1px solid var(--border);overflow-y:auto}
.sim-main{display:flex;flex-direction:column;overflow:hidden;background:var(--bg)}
.ctrl-section{border-bottom:1px solid var(--border);padding:12px 14px}
.ctrl-label{font-family:var(--font-data);font-size:9px;font-weight:700;color:var(--copper);letter-spacing:1.2px;text-transform:uppercase;margin-bottom:8px}
.ctrl-row{margin-bottom:8px}
.ctrl-row label{display:block;font-size:10px;color:var(--muted);margin-bottom:3px;font-family:var(--font-data)}
.ctrl-row input[type=number],.ctrl-row select{width:100%;background:var(--surface2);border:1px solid var(--border);color:var(--ivory);padding:5px 8px;border-radius:3px;font-family:var(--font-data);font-size:11px}
.ctrl-row input[type=number]:focus,.ctrl-row select:focus{outline:none;border-color:var(--copper)}
.ctrl-row select option{background:var(--surface2)}
.range-wrap{display:flex;align-items:center;gap:8px}
.ctrl-row input[type=range]{flex:1;accent-color:var(--copper);height:3px}
.range-val{font-family:var(--font-data);font-size:10px;color:var(--gold);min-width:50px;text-align:right}
.tab-bar{display:flex;background:var(--surface);border-bottom:1px solid var(--border);padding:0 14px}
.tab-btn{font-family:var(--font-data);font-size:10px;font-weight:600;padding:9px 14px;cursor:pointer;border:none;background:transparent;color:var(--muted);letter-spacing:0.8px;border-bottom:2px solid transparent;transition:all 0.2s}
.tab-btn:hover{color:var(--ivory)}
.tab-btn.active{color:var(--copper);border-bottom-color:var(--copper)}
.tab-content{flex:1;overflow:hidden}
.tab-pane{display:none;height:100%;overflow:auto}
.tab-pane.active{display:flex;flex-direction:column}
.plot-container{flex:1;min-height:350px}
.btn{font-family:var(--font-data);font-size:10px;font-weight:700;padding:6px 14px;border-radius:3px;border:none;cursor:pointer;letter-spacing:0.8px;transition:all 0.2s}
.btn-primary{background:var(--copper);color:#0B0D10}
.btn-primary:hover{background:var(--gold)}
.btn-secondary{background:transparent;border:1px solid var(--border);color:var(--muted)}
.btn-secondary:hover{border-color:var(--teal);color:var(--teal)}
.btn-teal{background:var(--teal);color:#0B0D10}
.btn-sm{padding:4px 10px;font-size:9px}
.btn-row{display:flex;gap:6px;flex-wrap:wrap;padding:8px 14px}
.playback-bar{display:flex;align-items:center;gap:10px;padding:8px 12px;background:var(--surface2);border-bottom:1px solid var(--border)}
.time-display{font-family:var(--font-data);font-size:12px;color:var(--teal);min-width:80px}
.progress-track{flex:1;height:4px;background:var(--border);border-radius:2px;cursor:pointer}
.progress-fill{height:100%;background:var(--copper);border-radius:2px;transition:width 0.1s}
.sweep-grid{display:grid;grid-template-columns:250px 1fr;gap:0;height:100%}
.sweep-config{padding:14px;border-right:1px solid var(--border);overflow-y:auto}
.export-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;padding:14px}
.export-card{background:var(--surface2);border:1px solid var(--border);border-radius:4px;padding:12px}
.export-card h4{font-family:var(--font-data);font-size:10px;color:var(--copper);letter-spacing:1px;margin-bottom:6px}
.export-card p{font-size:10px;color:var(--muted);margin-bottom:10px;line-height:1.5}
.ds-panel{padding:12px 14px;border-top:1px solid var(--border);background:var(--surface)}
.ds-title{font-family:var(--font-data);font-size:9px;color:var(--teal);letter-spacing:1px;margin-bottom:8px;font-weight:700}
.ds-btns{display:flex;gap:4px;flex-wrap:wrap}
.ds-btn{font-family:var(--font-data);font-size:9px;font-weight:700;padding:4px 10px;border-radius:3px;background:var(--surface3);border:1px solid var(--border);color:var(--muted);cursor:pointer;transition:all 0.2s}
.ds-btn:hover{border-color:var(--teal);color:var(--teal)}
.ds-btn.all{border-color:var(--copper);color:var(--copper)}
.ds-btn.all:hover{background:var(--copper);color:#0B0D10}
.ds-status{font-family:var(--font-data);font-size:9px;color:var(--gold);margin-top:6px;min-height:14px}
.data-table{width:100%;border-collapse:collapse;font-family:var(--font-data);font-size:10px}
.data-table th{background:var(--surface3);color:var(--copper);padding:6px 10px;text-align:left;font-size:9px;letter-spacing:0.8px;border-bottom:1px solid var(--border)}
.data-table td{padding:5px 10px;border-bottom:1px solid var(--border);color:var(--ivory)}
.data-table tr:hover td{background:var(--surface2)}
.table-wrap{overflow-x:auto;max-height:250px;overflow-y:auto}
.msg-box{margin:10px 14px;padding:8px 12px;border-radius:3px;font-family:var(--font-data);font-size:10px;border-left:3px solid var(--teal);background:rgba(78,197,193,0.07);color:var(--teal)}
.results-summary{padding:8px 14px;background:var(--surface2);border-bottom:1px solid var(--border);display:flex;gap:14px;flex-wrap:wrap}
.rs-item{display:flex;flex-direction:column;gap:2px}
.rs-label{font-family:var(--font-data);font-size:8px;color:var(--muted);letter-spacing:0.8px}
.rs-val{font-family:var(--font-data);font-size:13px;color:var(--teal);font-weight:700}
.node-grid{display:grid;grid-template-columns:1fr 1fr;gap:6px;padding:8px 0}
</style></head><body>
<div class="ops-tracker">
  <div class="ops-beacon">
    <div class="beacon-dot"></div>
    <div>
      <div class="ops-title">EMFF NODE — ELECTROMAGNETIC FORMATION FLIGHT</div>
      <div class="ops-desc">3D EM formation · Biot-Savart dipole forces · Formation control · Plotly 3D · /sim/node</div>
    </div>
  </div>
  <div class="ops-nav">
    <a class="nav-pill calc" href="/calc/orbital">ORB</a>
    <a class="nav-pill calc" href="/calc/launch">LW</a>
    <a class="nav-pill calc" href="/calc/magnetostatics">MAG</a>
    <a class="nav-pill calc" href="/calc/energy">PWR</a>
    <a class="nav-pill calc" href="/calc/fluids">FLD</a>
    <a class="nav-pill sim" href="/sims/rfs-extraction">RFS</a>
    <a class="nav-pill sim active" href="/sim/node">EMFF</a>
    <a class="nav-pill sim" href="/sim/fields">EMF</a>
    <a class="nav-pill sim" href="/sim/re-entry">ENTRY</a>
    <a class="nav-pill w1" href="/w1/data">W1</a>
    <a class="nav-pill w2" href="/w2/data">W2</a>
    <a class="nav-pill w3" href="/w3/data">W3</a>
    <a class="nav-pill w4" href="/w4/data">W4</a>
    <a class="nav-pill w5" href="/w5/data">W5</a>
    <a class="nav-pill w6" href="/w6/data">W6</a>
    <a class="nav-pill util" href="/data/achilles">ACH</a>
    <a class="nav-pill util" href="/library">LIB</a>
    <a class="nav-pill util" href="/gmat">GMAT</a>
    <a class="nav-pill util" href="/dash">DASH</a>
  </div>
</div>
<div class="beacon-bar">
  <span class="beacon-live">● LIVE</span>
  <span class="beacon-path">/sim/node</span>
  <span class="beacon-sep">·</span>
  <span class="beacon-path">Universal — callable by all workspaces &amp; dataspaces</span>
  <span class="beacon-sep">·</span>
  <span class="beacon-brand">Römer Industries / EMASSC</span>
  <span class="beacon-sep">·</span>
  <span class="beacon-path" id="emff-beacon-ts"></span>
</div>
<div class="sim-header">
  <div class="sim-title">EMFF Node — Electromagnetic Formation Flight</div>
  <div class="sim-desc">3D multi-satellite EM formation · Biot-Savart dipole-dipole forces · Formation stability analysis · PD control law · Power budget per node</div>
  <div class="sim-badges">
    <span class="badge teal"></span>
    <span class="badge">SI Units</span>
    <span class="badge copper">Universal Tool — W1–W6 Callable</span>
    <span class="badge teal">Plotly 3D Formation</span>
    <span class="badge gold">Animated Playback</span>
    <span class="badge">JetBrains Mono · Inter</span>
  </div>
</div>
<div class="telem-grid">
  <div class="telem-cell"><div class="telem-label">NODE COUNT</div><div class="telem-val" id="tv-nodes">3</div><div class="telem-unit">nodes</div></div>
  <div class="telem-cell"><div class="telem-label">SEPARATION</div><div class="telem-val" id="tv-sep">50</div><div class="telem-unit">m</div></div>
  <div class="telem-cell warning"><div class="telem-label">EM FORCE (MAX)</div><div class="telem-val" id="tv-force">—</div><div class="telem-unit">mN</div></div>
  <div class="telem-cell"><div class="telem-label">TOTAL CURRENT</div><div class="telem-val" id="tv-current">1000</div><div class="telem-unit">A</div></div>
  <div class="telem-cell"><div class="telem-label">FIELD STRENGTH</div><div class="telem-val" id="tv-field">1.0</div><div class="telem-unit">T</div></div>
  <div class="telem-cell"><div class="telem-label">POWER / NODE</div><div class="telem-val" id="tv-power">—</div><div class="telem-unit">W</div></div>
  <div class="telem-cell"><div class="telem-label">FORMATION ERR</div><div class="telem-val" id="tv-err">0.0</div><div class="telem-unit">m</div></div>
  <div class="telem-cell"><div class="telem-label">SIM TIME</div><div class="telem-val" id="tv-time">T+00:00</div><div class="telem-unit">hh:mm</div></div>
</div>
<div class="sim-body">
  <div class="sim-controls">
    <div class="ctrl-section">
      <div class="ctrl-label">⚡ FORMATION CONFIG</div>
      <div class="ctrl-row">
        <label>Node Count</label>
        <select id="p-nodes" onchange="window.emff.updateNodeCount()">
          <option value="2">2 Nodes</option>
          <option value="3" selected>3 Nodes</option>
          <option value="4">4 Nodes</option>
          <option value="5">5 Nodes</option>
        </select>
      </div>
      <div class="ctrl-row">
        <label>Formation Type</label>
        <select id="p-formation">
          <option value="triangle" selected>Triangle</option>
          <option value="line">Line</option>
          <option value="square">Square</option>
          <option value="diamond">Diamond</option>
          <option value="pentagon">Pentagon</option>
        </select>
      </div>
      <div class="ctrl-row">
        <label>Separation (m)</label>
        <div class="range-wrap">
          <input type="range" id="p-sep" min="5" max="500" value="50" step="5" oninput="document.getElementById('v-sep').textContent=this.value+'m';document.getElementById('tv-sep').textContent=this.value">
          <span class="range-val" id="v-sep">50m</span>
        </div>
      </div>
      <div class="ctrl-row">
        <label>Orbital Altitude (km)</label>
        <input type="number" id="p-alt" value="400" min="200" max="2000" step="10">
      </div>
    </div>
    <div class="ctrl-section">
      <div class="ctrl-label">🔋 EM PARAMETERS</div>
      <div class="ctrl-row">
        <label>Field Strength (T)</label>
        <div class="range-wrap">
          <input type="range" id="p-field" min="0.1" max="20" value="1" step="0.1" oninput="document.getElementById('v-field').textContent=parseFloat(this.value).toFixed(1)+'T';document.getElementById('tv-field').textContent=parseFloat(this.value).toFixed(1)">
          <span class="range-val" id="v-field">1.0T</span>
        </div>
      </div>
      <div class="ctrl-row">
        <label>Coil Current (A)</label>
        <input type="number" id="p-current" value="1000" min="10" max="50000" step="100" oninput="document.getElementById('tv-current').textContent=this.value">
      </div>
      <div class="ctrl-row">
        <label>Coil Turns</label>
        <input type="number" id="p-turns" value="100" min="1" max="10000" step="10">
      </div>
      <div class="ctrl-row">
        <label>Coil Radius (m)</label>
        <input type="number" id="p-radius" value="0.5" min="0.01" max="5" step="0.1">
      </div>
      <div class="ctrl-row">
        <label>Dipole Alignment</label>
        <select id="p-align">
          <option value="aligned" selected>Aligned</option>
          <option value="anti">Anti-aligned</option>
          <option value="perp">Perpendicular</option>
          <option value="custom">Custom</option>
        </select>
      </div>
    </div>
    <div class="ctrl-section">
      <div class="ctrl-label">🎮 CONTROL LAW</div>
      <div class="ctrl-row">
        <label>Control Mode</label>
        <select id="p-control">
          <option value="hold" selected>Formation Hold (PD)</option>
          <option value="reconfig">Reconfiguration (LQR)</option>
          <option value="keepout">Station Keeping</option>
          <option value="open">Open Loop</option>
        </select>
      </div>
      <div class="ctrl-row">
        <label>Node Mass (kg each)</label>
        <input type="number" id="p-mass" value="50" min="1" max="5000" step="1">
      </div>
      <div class="ctrl-row">
        <label>PD Gain Kp</label>
        <input type="number" id="p-kp" value="0.1" min="0.001" max="10" step="0.01">
      </div>
      <div class="ctrl-row">
        <label>PD Gain Kd</label>
        <input type="number" id="p-kd" value="0.05" min="0.001" max="5" step="0.005">
      </div>
    </div>
    <div class="ctrl-section">
      <div class="ctrl-label">▶ PLAYBACK</div>
      <div class="ctrl-row">
        <label>Duration (orbits)</label>
        <input type="number" id="p-orbits" value="2" min="0.5" max="10" step="0.5">
      </div>
      <div class="ctrl-row">
        <label>Sim Speed</label>
        <select id="p-speed">
          <option value="10">10×</option>
          <option value="100" selected>100×</option>
          <option value="500">500×</option>
          <option value="1000">1000×</option>
        </select>
      </div>
    </div>
    <div class="btn-row">
      <button class="btn btn-primary" onclick="window.emff.compute()">COMPUTE</button>
      <button class="btn btn-teal" onclick="window.emff.run()" id="btn-run">▶ RUN SIM</button>
      <button class="btn btn-secondary btn-sm" onclick="window.emff.reset()">RESET</button>
    </div>
    <div class="ds-panel">
      <div class="ds-title">⬡ ROUTE TO DATASPACE</div>
      <div class="ds-btns">
        <button class="ds-btn" onclick="window.emff.sendDS('w1')">W1</button>
        <button class="ds-btn" onclick="window.emff.sendDS('w2')">W2</button>
        <button class="ds-btn" onclick="window.emff.sendDS('w3')">W3</button>
        <button class="ds-btn" onclick="window.emff.sendDS('w4')">W4</button>
        <button class="ds-btn" onclick="window.emff.sendDS('w5')">W5</button>
        <button class="ds-btn" onclick="window.emff.sendDS('w6')">W6</button>
        <button class="ds-btn all" onclick="window.emff.sendDS('all')">ALL</button>
      </div>
      <div class="ds-status" id="ds-status"></div>
    </div>
  </div>
  <div class="sim-main">
    <div class="tab-bar">
      <button class="tab-btn active" onclick="window.emff.tab('3d')">3D FORMATION</button>
      <button class="tab-btn" onclick="window.emff.tab('field')">FIELD MAP</button>
      <button class="tab-btn" onclick="window.emff.tab('dynamics')">DYNAMICS</button>
      <button class="tab-btn" onclick="window.emff.tab('telem')">TELEMETRY</button>
      <button class="tab-btn" onclick="window.emff.tab('sweep')">SWEEP</button>
      <button class="tab-btn" onclick="window.emff.tab('export')">EXPORT</button>
    </div>
    <div class="tab-pane active" id="tab-3d">
      <div class="playback-bar">
        <button class="btn btn-primary btn-sm" id="pb-play" onclick="window.emff.playPause()">▶ PLAY</button>
        <button class="btn btn-secondary btn-sm" onclick="window.emff.stepForward()">⏭ STEP</button>
        <button class="btn btn-secondary btn-sm" onclick="window.emff.resetAnim()">⏮ RESET</button>
        <div class="progress-track" onclick="window.emff.seekAnim(event)" id="prog-track"><div class="progress-fill" id="prog-fill" style="width:0%"></div></div>
        <span class="time-display" id="anim-time">T+00:00:00</span>
        <select id="anim-speed" style="background:var(--surface2);border:1px solid var(--border);color:var(--ivory);padding:2px 6px;font-family:var(--font-data);font-size:9px;border-radius:2px">
          <option value="10">10×</option><option value="100" selected>100×</option><option value="500">500×</option>
        </select>
      </div>
      <div class="plot-container" id="plot-3d"></div>
    </div>
    <div class="tab-pane" id="tab-field">
      <div class="results-summary" id="field-summary">
        <div class="rs-item"><span class="rs-label">PEAK B-FIELD</span><span class="rs-val" id="rs-bmax">—</span></div>
        <div class="rs-item"><span class="rs-label">MIN B-FIELD</span><span class="rs-val" id="rs-bmin">—</span></div>
        <div class="rs-item"><span class="rs-label">FIELD UNIFORMITY</span><span class="rs-val" id="rs-bunif">—</span></div>
        <div class="rs-item"><span class="rs-label">TOTAL MOMENT</span><span class="rs-val" id="rs-moment">—</span></div>
      </div>
      <div id="plot-field" style="flex:1;min-height:350px"></div>
    </div>
    <div class="tab-pane" id="tab-dynamics">
      <div style="display:grid;grid-template-columns:1fr 1fr;flex:1;gap:1px;background:var(--border)">
        <div id="plot-force" style="background:var(--bg)"></div>
        <div id="plot-power" style="background:var(--bg)"></div>
      </div>
    </div>
    <div class="tab-pane" id="tab-telem">
      <div class="results-summary" id="node-summary"></div>
      <div id="plot-telem" style="flex:1;min-height:300px"></div>
      <div class="table-wrap">
