<!-- FLOW MAP (AI position + pipeline) -->
<div id="flowmap" style="width:100%;max-width:1100px;margin:10px auto"></div>
<script>
(function(){
  const el = document.getElementById("flowmap");
  const nodes = [
    {id:"/w1", label:"W1"}, {id:"/data/w1", label:"/data/w1"},
    {id:"/w2", label:"W2"}, {id:"/data/w2", label:"/data/w2"},
    {id:"/w3", label:"W3"}, {id:"/data/w3", label:"/data/w3"},
    {id:"/w4", label:"W4"}, {id:"/data/w4", label:"/data/w4"},
    {id:"/w5", label:"W5"}, {id:"/data/w5", label:"/data/w5"},
    {id:"/data/w6", label:"/data/w6"}
  ];
  const edges = [
    ["/w1","/data/w1"],["/w2","/data/w2"],["/w3","/data/w3"],["/w4","/data/w4"],["/w5","/data/w5"],
    ["/data/w1","/data/w6"],["/data/w2","/data/w6"],["/data/w3","/data/w6"],["/data/w4","/data/w6"],["/data/w5","/data/w6"]
  ];
  function render(){
    const s = Linker.get();
    const where = s.achilles?.current || "/dash";
    const svg = [`<svg viewBox="0 0 1100 280" style="width:100%">`];
    const xy = {}; // layout grid
    const cols = [["/w1","/w2","/w3","/w4","/w5"], ["/data/w1","/data/w2","/data/w3","/data/w4","/data/w5"], ["/data/w6"]];
    const xcol = [150, 450, 850], ystep = 45, y0 = 40;
    cols.forEach((col,ci)=>col.forEach((id,ri)=>{ xy[id] = {x:xcol[ci], y:y0+ri*ystep}; }));
    // nodes
    nodes.forEach(n=>{
      if(!xy[n.id]) return;
      const {x,y} = xy[n.id];
      const active = (n.id===where);
      svg.push(`<rect x="${x-50}" y="${y-18}" rx="10" ry="10" width="100" height="36" 
        fill="${active?'#00e5ff':'#1f2733'}" stroke="#3a4557" />
        <text x="${x}" y="${y+5}" fill="#fff" font-family="Inter" font-size="12" text-anchor="middle">${n.label}</text>`);
      if(active){
        svg.push(`<circle cx="${x+60}" cy="${y}" r="6" fill="#00e5ff"><title>Achilles here</title></circle>`);
      }
    });
    // edges
    edges.forEach(([a,b])=>{
      if(!xy[a]||!xy[b]) return;
      const A=xy[a],B=xy[b];
      svg.push(`<line x1="${A.x+50}" y1="${A.y}" x2="${B.x-50}" y2="${B.y}" stroke="#5c6b80" stroke-width="2" marker-end="url(#arrow)"/>`);
    });
    svg.splice(1,0,`<defs><marker id="arrow" markerWidth="10" markerHeight="7" refX="10" refY="3.5" orient="auto">
      <polygon points="0 0, 10 3.5, 0 7" fill="#5c6b80"/></marker></defs>`);
    svg.push(`</svg>`);
    el.innerHTML = svg.join("");
  }
  window.addEventListener("message", (e)=> (e.data?.source==="linker" && e.data.type==="sync") && render());
  if(window.Linker) render();
})();
</script>
