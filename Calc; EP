  try{localStorage.setItem('achilles_beacon_ep',JSON.stringify({calculator:'energy_power',version:'2.0.0',status:'live',timestamp:new Date().toISOString()}));}catch(e){}
  console.log('%cEnergy & Power Calculator ','color:#B87333;font-weight:bold;font-size:14px');
  console.log('%cRömer Industries / EMASSC','color:#4EC5C1;font-size:12px');
});
